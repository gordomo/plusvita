                {% endif %}
                {% if isEnfermero %}
                    <div class="col-md-4 mb-4">
                        <a href="{{ path('prescripcion_index', {'id': app.user.id}) }}" class="text-decoration-none">
                            <div class="dashboard-card">
                                <div class="dashboard-card-header bg-primary text-white">
                                    <i class="fas fa-user-nurse mr-2"></i> Prescripciones
                                </div>
                                <div class="dashboard-card-body">
                                    <p class="card-text text-muted">Administre prescripciones médicas por paciente</p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/chartist.min.js')}}"></script>
    <script>
        $(document).ready(function() {
            // Activar tooltips
            $('[data-toggle="tooltip"]').tooltip();
            
            // Gráfico de camas
            var data = {
                series: [
                    {{ infoHabitacionesTotalyPorPiso['total'].total_camas_disponibles }}, 
                    {{ infoHabitacionesTotalyPorPiso['total'].total_camas_ocupadas }}
                ]
            };

            // Opciones para personalizar el gráfico de torta
            var options = {
                labelInterpolationFnc: function(value) {
                    return Math.round(value / data.series.reduce((a, b) => a + b) * 100) + '%';
                }
            };

            // Renderiza el gráfico de torta
            new Chartist.Pie('.ct-chart', data, options);
        });
    </script>
{% endblock %}