                                <i class="fas fa-undo-alt"></i> Reingresos Mes
                            </div>
                            <div class="dashboard-card-body">
                                <div class="dashboard-value">
                                    <a href="{{ path('cliente_index', {'filtroFecha': 'derivados'}) }}" class="text-success">
                                        {{ reingresoDerivadosEsteMes }}
                                    </a>
                                </div>
                                <div class="dashboard-label">PACIENTES REINGRESADOS</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Derivados hoy -->
                    <div class="col-md-3 mb-3">
                        <div class="dashboard-card">
                            <div class="dashboard-card-header bg-info text-white">
                                <i class="fas fa-share"></i> Derivados Hoy
                            </div>
                            <div class="dashboard-card-body">
                                <div class="dashboard-value text-info">{{ derivadosHoy }}</div>
                                <div class="dashboard-label">NUEVAS DERIVACIONES</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Reingresados de derivaciones hoy -->
                    <div class="col-md-3 mb-3">
                        <div class="dashboard-card">
                            <div class="dashboard-card-header bg-warning text-white">
                                <i class="fas fa-reply"></i> Reingresos Hoy
                            </div>
                            <div class="dashboard-card-body">
                                <div class="dashboard-value text-warning">{{ ReingresadosDerivadosHoy }}</div>
