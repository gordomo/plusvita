{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('assets/chartist/dist/chartist.min.css') }}">
<style>
    /* Estilos generales del dashboard */
    .dashboard-container {
        padding: 1rem 0;
    }
    
    .dashboard-section {
        margin-bottom: 2rem;
    }
    
    .dashboard-card {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        overflow: hidden;
    }
    
    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }
    
    .dashboard-card-header {
        padding: 1rem;
        font-weight: 600;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        display: flex;
        align-items: center;
    }
    
    .dashboard-card-header i {
        margin-right: 0.5rem;
        font-size: 1.25rem;
    }
    
    .dashboard-card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .dashboard-value {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
    
    .dashboard-label {
        font-size: 0.9rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .section-title {
        position: relative;
        padding-left: 1rem;
        margin-bottom: 1.5rem;
        font-weight: 600;
        color: #495057;
        border-left: 4px solid;
    }
    
    .section-camas .section-title {
        border-color: #60b9b9;
    }
    
    .section-ambulatorios .section-title {
        border-color: #b088be;
    }
    
    .section-ingresos .section-title {
        border-color: #889cbe;
    }
    
    .section-derivaciones .section-title {
        border-color: #be8888;
    }
    
    .section-permisos .section-title {
        border-color: #88be8e;
    }
    
    /* Estilos para el gráfico circular */
    .ct-series-a .ct-slice-pie {
        fill: #3498db; /* Azul para camas disponibles */
    }

    .ct-series-b .ct-slice-pie {
        fill: #dc3545; /* Rojo para camas ocupadas */
    }
    
    .ct-label {
        fill: white;
        font-size: 1rem;
        font-weight: bold;
    }
    
    .chart-container {
        position: relative;
        height: 200px;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .ct-chart {
        height: 100%;
        width: 100%;
    }
    
    .chart-legend {
        display: flex;
        flex-direction: column;
        margin-top: 1rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .legend-color {
        width: 15px;
        height: 15px;
        display: inline-block;
        margin-right: 0.5rem;
        border-radius: 3px;
    }

    .legend-color.available {
        background-color: #3498db; /* Azul para disponibles */
    }

    .legend-color.occupied {
        background-color: #dc3545; /* Rojo para ocupadas */
    }
    
    /* Estilos responsivos */
    @media (max-width: 768px) {
        .dashboard-value {
            font-size: 2rem;
        }
    }
</style>
{% endblock %}

{% block title %}Panel de Control{% endblock %}
{% block panelTitle %}Panel de Control{% endblock %}

{% block body %}
    {% if not app.user %}
        <div class="alert alert-info">
            Por favor, ingrese con su usuario y contraseña
            <a href="{{ path('app_login') }}" class="btn btn-primary ml-3">Ingresar</a>
        </div>
    {% elseif is_granted('ROLE_ADMIN') %}
        <div class="dashboard-container">
            <!-- Sección de Camas -->
            <div class="dashboard-section section-camas">
                <h3 class="section-title">Ocupación de Camas</h3>
                
                {% for piso, infoHabitaciones in infoHabitacionesTotalyPorPiso %}
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5 class="text-muted mb-3">{{ piso == 'total' ? 'Resumen General' : 'Piso ' ~ piso }}</h5>
                        </div>
                        
                        <!-- Camas totales -->
                        <div class="col-md-3 mb-3">
                            <div class="dashboard-card">
                                <div class="dashboard-card-header bg-primary text-white">
                                    <i class="fas fa-bed"></i> Total Camas
                                </div>
                                <div class="dashboard-card-body">
                                    <div class="dashboard-value">
                                        <a href="{{ path('habitacion_index') }}" class="text-primary">    
                                            {{ infoHabitaciones.total_camas }}
                                        </a>
                                    </div>
                                    <div class="dashboard-label">CAPACIDAD TOTAL</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Camas ocupadas -->
                        <div class="col-md-3 mb-3">
                            <div class="dashboard-card">
                                <div class="dashboard-card-header bg-danger text-white">
                                    <i class="fas fa-procedures"></i> Ocupadas
                                </div>
                                <div class="dashboard-card-body">
                                    <div class="dashboard-value">
                                        <a href="{{ path('habitacion_index', {'pestana': 'completas'}) }}" class="text-danger">
                                            {{ infoHabitaciones.total_camas_ocupadas }}
                                        </a>
                                    </div>
                                    <div class="dashboard-label">{{ (infoHabitaciones.total_camas_ocupadas / infoHabitaciones.total_camas * 100)|round }}% DE OCUPACIÓN</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Camas disponibles -->
                        <div class="col-md-3 mb-3">
                            <div class="dashboard-card">
                                <div class="dashboard-card-header bg-success text-white">
                                    <i class="fas fa-bed"></i> Disponibles
                                </div>
                                <div class="dashboard-card-body">
                                    <div class="dashboard-value">
                                        <a href="{{ path('habitacion_index', {'pestana': 'camas-vacias'}) }}" class="text-success">
                                            {{ infoHabitaciones.total_camas_disponibles }}
                                        </a>
                                    </div>
                                    <div class="dashboard-label">{{ (infoHabitaciones.total_camas_disponibles / infoHabitaciones.total_camas * 100)|round }}% DISPONIBLE</div>
                                </div>
                            </div>
                        </div>
                        
                        {% if piso == 'total' %}
                            <!-- Gráfico para resumen total -->
                            <div class="col-md-3 mb-3">
                                <div class="dashboard-card">
                                    <div class="dashboard-card-header bg-info text-white">
                                        <i class="fas fa-chart-pie"></i> Distribución
                                    </div>
                                    <div class="dashboard-card-body">
                                        <div class="chart-container">
                                            <div class="ct-chart"></div>
                                        </div>
                                        <div class="chart-legend">
                                            <span class="legend-item">
                                                <span class="legend-color available"></span> Disponibles ({{ infoHabitaciones.total_camas_disponibles }})
                                            </span>
                                            <span class="legend-item">
                                                <span class="legend-color occupied"></span> Ocupadas ({{ infoHabitaciones.total_camas_ocupadas }})
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
                
                <!-- Indicadores Hospitalarios -->
                <div class="row mt-4">
                    <div class="col-12 mb-3">
                        <h5 class="text-muted">
                            <i class="fas fa-chart-bar"></i> Indicadores Hospitalarios
                        </h5>
                    </div>
                    
                               <!-- Estada Media -->
           <div class="col-md-6 mb-3">
               <div class="dashboard-card">
                   <div class="dashboard-card-header bg-info text-white">
                       <i class="fas fa-calendar-check"></i> Estada Media
                   </div>
                   <div class="dashboard-card-body">
                       <div class="dashboard-value text-info">{{ estadaMedia|number_format(1) }}</div>
