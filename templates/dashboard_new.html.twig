                </div>
            </div>
            
            <!-- Sección de Permisos -->
            <div class="dashboard-section section-permisos">
                <h3 class="section-title">Permisos</h3>
                
                <div class="row">
                    <!-- De permiso este mes -->
                    <div class="col-md-3 mb-3">
                        <div class="dashboard-card">
                            <div class="dashboard-card-header bg-primary text-white">
                                <i class="fas fa-calendar-check"></i> Permisos Mes
                            </div>
                            <div class="dashboard-card-body">
                                <div class="dashboard-value">
                                    <a href="{{ path('cliente_index', {'filtroFecha': 'permisos'}) }}" class="text-primary">
                                        {{ permisosEsteMes }}
                                    </a>
                                </div>
                                <div class="dashboard-label">PACIENTES</div>
                            </div>
