{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .dashboard-container {
        padding: 1rem 0;
    }
    
    .dashboard-card {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        overflow: hidden;
    }
    
    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }
    
    .dashboard-card-header {
        padding: 1rem;
        font-weight: 600;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        display: flex;
        align-items: center;
    }
    
    .dashboard-card-header i {
        margin-right: 0.5rem;
        font-size: 1.25rem;
    }
    
    .dashboard-card-body {
        padding: 1.5rem;
    }
    
    .welcome-section {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 2rem;
    }
    
    .patient-header-row {
        border-top: 2px solid #dee2e6;
    }
    
    .patient-header-row:first-child {
        border-top: none;
    }
    
    .patient-cell {
        background-color: #f8f9fa;
        font-weight: 600;
    }
    
    .table tbody tr.patient-header-row td {
        border-top: 2px solid #dee2e6;
    }
    
    .table tbody tr:not(.patient-header-row) td {
        border-top: 1px solid #dee2e6;
    }
</style>
{% endblock %}

{% block title %}Dashboard - Enfermería{% endblock %}
{% block panelTitle %}Panel de Enfermería{% endblock %}

{% block body %}
    <div class="dashboard-container">
        <!-- Sección de Bienvenida -->
        <div class="welcome-section">
            <h2><i class="fas fa-user-nurse"></i> Bienvenido/a, {{ app.user.nombre }} {{ app.user.apellido }}</h2>
            <p class="mb-0">Acceso rápido a sus funciones principales</p>
        </div>

        <!-- Accesos Rápidos -->
        <div class="row">
            <!-- Kardex General -->
            <div class="col-md-6 mb-4">
                <a href="{{ path('medicacion_enfermeria_index') }}" class="text-decoration-none">
                    <div class="dashboard-card">
                        <div class="dashboard-card-header bg-primary text-white">
                            <i class="fas fa-syringe"></i> Kardex
                        </div>
                        <div class="dashboard-card-body">
                            <p class="card-text text-muted">
                                <i class="fas fa-clipboard-list mr-2"></i> Acceda al kardex de medicación de todos los pacientes
                            </p>
                            <small class="text-primary">
                                <i class="fas fa-arrow-right"></i> Ver Kardex General
                            </small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Pacientes -->
            <div class="col-md-6 mb-4">
                <a href="{{ path('cliente_index') }}" class="text-decoration-none">
                    <div class="dashboard-card">
                        <div class="dashboard-card-header bg-success text-white">
                            <i class="fas fa-user-injured"></i> Pacientes
                        </div>
                        <div class="dashboard-card-body">
                            <p class="card-text text-muted">
                                <i class="fas fa-hospital-user mr-2"></i> Acceda al listado completo de pacientes
                            </p>
                            <small class="text-success">
                                <i class="fas fa-arrow-right"></i> Ver pacientes
                            </small>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Indicaciones Próximas -->
        <div class="row mt-4">
            <div class="col-12">
                <h5 class="text-muted mb-3">
                    <i class="fas fa-clock"></i> Indicaciones Próximas
                </h5>
            </div>
            
            {% if indicacionesPorPaciente is defined and indicacionesPorPaciente|length > 0 %}
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 25%;">Paciente</th>
                                    <th style="width: 40%;">Resumen</th>
                                    <th style="width: 20%;">Fecha/Hora</th>
                                    <th style="width: 10%;">Estado</th>
                                    <th style="width: 5%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for pacienteId, pacienteData in indicacionesPorPaciente %}
                                    {% set cliente = pacienteData.cliente %}
                                    {% set totalIndicaciones = pacienteData.totalIndicaciones %}
                                    {% set tieneSignosVitales = pacienteData.tieneSignosVitales %}
                                    {% set signosVitalesBloqueados = pacienteData.signosVitalesBloqueados %}
                                    {% set indicacionesEnVentana = pacienteData.indicacionesEnVentana %}
                                    {% set indicacionesVencidas = pacienteData.indicacionesVencidas %}
                                    {% set estadoGeneral = pacienteData.estadoGeneral %}
                                    
                                    <tr class="{% if tieneSignosVitales and not signosVitalesBloqueados %}table-info{% elseif estadoGeneral == 'en_ventana' %}table-warning{% elseif estadoGeneral == 'vencido' %}table-danger{% elseif estadoGeneral == 'bloqueado' %}table-secondary{% endif %}">
                                        <td>
                                            <strong>{{ cliente.nombre }} {{ cliente.apellido }}</strong><br>
                                            <small class="text-muted">H.C.: {{ cliente.hClinica }}</small>
                                        </td>
                                        
                                        <td>
                                            {% if totalIndicaciones == 1 %}
                                                {% set item = pacienteData.indicaciones[0] %}
                                                {% if item.tipo == 'signos_vitales' %}
                                                    <i class="fas fa-heartbeat text-danger mr-2"></i>
                                                    <strong>Medir Signos Vitales</strong>
                                                    {% if item.turno %}
                                                        <br><small class="text-muted">Turno: {{ item.turno|capitalize }}</small>
                                                    {% endif %}
                                                {% else %}
                                                    {{ item.nombreMedicamento }}
                                                    {% if item.indicacion and item.indicacion.frecuencia %}
                                                        <br><small class="text-muted">Frecuencia: {{ item.indicacion.frecuencia }}</small>
                                                    {% endif %}
                                                {% endif %}
                                            {% else %}
                                                <i class="fas fa-list text-primary mr-2"></i>
                                                <strong>{{ totalIndicaciones }} indicación(es) pendiente(s)</strong>
                                                {% if tieneSignosVitales %}
                                                    <br><small class="text-muted">
                                                        <i class="fas fa-heartbeat text-danger"></i> 
                                                        Incluye signos vitales
                                                        {% if signosVitalesBloqueados %}
                                                            <span class="">(bloqueado)</span>
                                                        {% endif %}
                                                    </small>
                                                {% endif %}
                                                {% if indicacionesVencidas > 0 %}
                                                    <br><small class="text-danger">
                                                        <i class="fas fa-exclamation-triangle"></i> 
                                                        {{ indicacionesVencidas }} vencida(s)
                                                    </small>
                                                {% endif %}
                                                {% if indicacionesEnVentana > 0 %}
                                                    <br><small class="text-warning">
                                                        <i class="fas fa-clock"></i> 
                                                        {{ indicacionesEnVentana }} en ventana
                                                    </small>
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                        
                                        <td>
                                            {% if totalIndicaciones == 1 %}
                                                {% set item = pacienteData.indicaciones[0] %}
                                                {% if item.tipo == 'signos_vitales' %}
                                                    {{ item.fechaHora|date('d/m/Y') }}
                                                    <br><small class="text-info">
                                                        <i class="fas fa-info-circle"></i> 
                                                        {% if item.bloqueado %}
                                                            Pendiente de indicaciones
                                                        {% else %}
                                                            Disponible ahora
                                                        {% endif %}
                                                    </small>
                                                {% else %}
                                                    {{ item.fechaHora|date('d/m/Y H:i') }}
                                                    {% if item.enVentana %}
                                                        <br><small class="text-warning"><i class="fas fa-exclamation-circle"></i> En ventana</small>
                                                    {% elseif item.estado == 'vencido' %}
                                                        <br><small class="text-danger">
                                                            {% set horasVencidas = (item.minutosDiferencia / 60)|round %}
                                                            Vencida hace {{ horasVencidas|abs }}h
                                                        </small>
                                                    {% else %}
                                                        <br><small class="text-info">
                                                            {% set horasRestantes = (item.minutosDiferencia / 60)|round %}
                                                            En {{ horasRestantes }}h
                                                        </small>
                                                    {% endif %}
                                                {% endif %}
                                            {% else %}
                                                {{ pacienteData.fechaHoraMinima|date('d/m/Y') }}
                                                <br><small class="text-muted">
                                                    <i class="fas fa-info-circle"></i> 
                                                    Ver detalle en Kardex
                                                </small>
                                            {% endif %}
                                        </td>
                                        
                                        <td>
                                            {% if tieneSignosVitales and not signosVitalesBloqueados %}
                                                <span class="badge badge-info">
                                                    <i class="fas fa-heartbeat"></i> Disponible
                                                </span>
                                            {% elseif estadoGeneral == 'en_ventana' %}
                                                <span class="badge badge-warning">
                                                    <i class="fas fa-clock"></i> En Ventana
                                                </span>
                                            {% elseif estadoGeneral == 'vencido' %}
                                                <span class="badge badge-danger">
                                                    <i class="fas fa-exclamation-triangle"></i> Pendiente
                                                </span>
                                            {% elseif estadoGeneral == 'bloqueado' %}
                                                <span class="badge badge-secondary">
                                                    <i class="fas fa-lock"></i> Bloqueado
                                                </span>
                                            {% else %}
                                                <span class="badge badge-info">
                                                    <i class="fas fa-hourglass-half"></i> Próxima
                                                </span>
                                            {% endif %}
                                        </td>
                                        
                                        <td>
                                            <a href="{{ path('medicacion_enfermeria', {'id': cliente.id}) }}" 
                                               class="btn btn-sm btn-primary" 
                                               title="Ir al Kardex del paciente">
                                                <i class="fas fa-syringe"></i> Kardex
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% else %}
                <div class="col-md-12">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle mr-2"></i>
                        <strong>¡Excelente!</strong> No hay indicaciones pendientes en este momento.
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Inicializar tooltips si los necesitas
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
{% endblock %}
