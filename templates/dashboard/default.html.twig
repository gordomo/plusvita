{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .dashboard-container {
        padding: 2rem 0;
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .welcome-card {
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
    }
    
    .welcome-icon {
        font-size: 4rem;
        color: #6c757d;
        margin-bottom: 1.5rem;
    }
</style>
{% endblock %}

{% block title %}Panel de Control{% endblock %}
{% block panelTitle %}Panel de Control{% endblock %}

{% block body %}
    <div class="dashboard-container">
        <div class="welcome-card">
            <div class="welcome-icon">
                <i class="fas fa-user-circle"></i>
            </div>
            <h2>Bienvenido/a, {{ app.user.nombre }} {{ app.user.apellido }}</h2>
            <p class="text-muted mt-3">
                Su cuenta está activa pero no tiene asignado un dashboard específico.
            </p>
            <p class="text-muted">
                Por favor, contacte al administrador para configurar sus permisos de acceso.
            </p>
            
            <div class="mt-4">
                <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-sign-out-alt mr-2"></i> Cerrar Sesión
                </a>
            </div>
        </div>
    </div>
{% endblock %}
