{% extends 'base.html.twig' %}

{% block title %}Estadísticas - Plus Vita{% endblock %}
{% block panelTitle %}Estadísticas del sistema{% if periodLabel is defined %} - {{ periodLabel }}{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-card {
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
            transition: transform 0.2s ease;
        }
        
        .stats-card:hover {
            transform: translateY(-3px);
        }
        
        .stats-card-header {
            padding: 1rem;
            font-weight: bold;
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        }
        
        .stats-card-body {
            padding: 1.5rem;
        }
        
        .stats-info {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }
        
        .stats-value {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        
        .stats-trend {
            color: #6c757d;
            font-size: 0.9rem;
        }
        
        .trend-up {
            color: #28a745;
        }
        
        .trend-down {
            color: #dc3545;
        }
        
        .chart-container {
            height: 300px;
            margin-bottom: 2rem;
        }
        
        .stats-icon {
            font-size: 3rem;
            margin-right: 1rem;
            color: #60b9b9;
        }
        
        .stats-section {
            margin-top: 2rem;
            margin-bottom: 3rem;
        }
        
        .section-title {
            border-left: 4px solid #b088be;
            padding-left: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .btn-stats {
            background-color: #889cbe;
            color: white;
            margin-right: 0.5rem;
        }
        
        .btn-stats:hover {
            background-color: #60b9b9;
            color: white;
        }
        
        /* Estilos para la tabla de patologías */
        .table-patologias .subcategoria-row {
            background-color: #f8f9fa;
        }
        
        .subcategoria-container td {
            padding: 0 !important;
        }
        
        .subcategoria-container table {
            margin: 0;
        }
        
        .subcategoria-container tr:last-child td {
            border-bottom: none;
        }
        
        .toggle-subcategoria {
            transition: all 0.2s ease;
        }
        
        .toggle-subcategoria:hover {
            transform: translateY(-2px);
        }
        
        .table-primary td {
            vertical-align: middle;
        }
    </style>
    <!-- Chart.js para visualizaciones -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div class="btn-group" role="group">
                <a href="{{ path('app_stats_index') }}" class="btn {{ app.request.get('_route') == 'app_stats_index' ? 'btn-primary' : 'btn-stats' }}">
                    <i class="fas fa-chart-line"></i> Panel General
                </a>
                <a href="{{ path('app_stats_ocupacion') }}" class="btn {{ app.request.get('_route') == 'app_stats_ocupacion' ? 'btn-primary' : 'btn-stats' }}">
                    <i class="fas fa-bed"></i> Ocupación de Camas
                </a>
                <a href="{{ path('app_stats_altas') }}" class="btn {{ app.request.get('_route') == 'app_stats_altas' ? 'btn-primary' : 'btn-stats' }}">
                    <i class="fas fa-procedures"></i> Altas Médicas
                </a>
                <a href="{{ path('app_stats_inventario') }}" class="btn {{ app.request.get('_route') == 'app_stats_inventario' ? 'btn-primary' : 'btn-stats' }}">
                    <i class="fas fa-boxes"></i> Inventario
                </a>
                <a href="{{ path('app_stats_comparacion', {'fecha_desde': fechaDesde, 'fecha_hasta': fechaHasta}) }}" class="btn {{ app.request.get('_route') == 'app_stats_comparacion' ? 'btn-primary' : 'btn-stats' }}">
                    <i class="fas fa-balance-scale"></i> Comparación de Períodos
                </a>
            </div>
            
            <!-- Filtro de período -->
            <div class="card shadow-sm">
                <div class="card-body p-2">
                    <form id="period-filter" class="form-inline" method="get">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-light"><i class="fas fa-calendar-alt"></i></span>
                            </div>
                            <input type="date" name="fecha_desde" class="form-control form-control-sm" 
                                   value="{{ fechaDesde }}" title="Fecha desde">
                            <div class="input-group-append input-group-prepend">
                                <span class="input-group-text bg-light">hasta</span>
                            </div>
                            <input type="date" name="fecha_hasta" class="form-control form-control-sm" 
                                   value="{{ fechaHasta }}" title="Fecha hasta">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
                            </div>
                            <div class="input-group-append">
                                <a href="{{ path('app_stats_index') }}" class="btn btn-sm btn-outline-secondary">Reiniciar</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen general -->
    <div class="row justify-content-center">
        <!-- Tarjeta de ocupación general -->
        <div class="col-md-4">
            <div class="card stats-card bg-light h-100">
                <div class="stats-card-header bg-primary text-white">
                    <i class="fas fa-bed"></i> Ocupación Promedio
                </div>
                <div class="stats-card-body text-center d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-center align-items-center mb-2">
                        <div class="stats-value" id="porcentaje-ocupacion">
                            <span class="{% if ocupacionActual > 80 %}text-danger{% elseif ocupacionActual > 60 %}text-warning{% else %}text-success{% endif %}">
                                {{ ocupacionActual }}%
                            </span>
                        </div>
                    </div>
                    <div class="stats-info">
                        <span class="text-muted">Habitaciones:</span>
                        <span class="font-weight-bold">{{ totalHabitaciones }}</span>
                    </div>
                    <div class="stats-info">
                        <span class="text-muted">Camas totales:</span>
                        <span class="font-weight-bold">{{ totalCamas }}</span>
                    </div>
                    <div class="stats-trend mt-2">
                        <i class="fas fa-calculator"></i> Promedio de {{ periodLabel }}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tarjeta de ingresos del mes -->
        <div class="col-md-4">
            <div class="card stats-card bg-light h-100">
                <div class="stats-card-header bg-success text-white">
                    <i class="fas fa-sign-in-alt"></i> Ingresos
                </div>
                <div class="stats-card-body text-center d-flex flex-column justify-content-center">
                    <div class="stats-value mb-2">{{ ingresosDelMes }}</div>
                    <div class="stats-info">pacientes ingresados</div>
                    <div class="stats-trend mt-2">
                        <i class="fas fa-calendar-day"></i> {{ periodLabel }}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tarjeta de egresos del mes -->
        <div class="col-md-4">
            <div class="card stats-card bg-light h-100">
                <div class="stats-card-header bg-info text-white">
                    <i class="fas fa-sign-out-alt"></i> Egresos
                </div>
                <div class="stats-card-body text-center d-flex flex-column justify-content-center">
                    <div class="stats-value mb-2">{{ egresosDelMes }}</div>
                    <div class="stats-info">pacientes con alta</div>
                    <div class="stats-trend mt-2">
                        <i class="fas fa-calendar-day"></i> {{ periodLabel }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Gráfico de ocupación por día (para el período seleccionado) -->
    <div class="stats-section">
        <h3 class="section-title">Tendencia en {{ periodLabel }}</h3>
        <div class="card stats-card">
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="tendencia-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Accesos rápidos a reportes detallados -->
    <div class="stats-section">
        <h3 class="section-title">Reportes detallados</h3>
        
        <div class="row">
            <div class="col-md-4">
                <div class="card stats-card bg-light">
                    <div class="stats-card-header">
                        <i class="fas fa-bed"></i> Ocupación de Camas
                    </div>
                    <div class="stats-card-body">
                        <p>Análisis detallado de ocupación de camas por período, habitación y tendencias.</p>
                        <a href="{{ path('app_stats_ocupacion') }}" class="btn btn-outline-primary">Ver detalles</a>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card stats-card bg-light">
                    <div class="stats-card-header">
                        <i class="fas fa-procedures"></i> Altas Médicas
                    </div>
                    <div class="stats-card-body">
                        <p>Estadísticas de altas médicas, categorizadas por tipo y distribuidas por período.</p>
                        <a href="{{ path('app_stats_altas') }}" class="btn btn-outline-primary">Ver detalles</a>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card stats-card bg-light">
                    <div class="stats-card-header">
                        <i class="fas fa-boxes"></i> Inventario
                    </div>
                    <div class="stats-card-body">
                        <p>Análisis del inventario por tipo, ubicación y movimientos recientes.</p>
                        <a href="{{ path('app_stats_inventario') }}" class="btn btn-outline-primary">Ver detalles</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Métrica: Días de internación por patología -->
    <div class="stats-section">
        <h3 class="section-title">Días de internación por patología</h3>
        <div class="row">
            <div class="col-md-7">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Patología</th>
                                        <th>Promedio</th>
                                        <th>Mínimo</th>
                                        <th>Máximo</th>
                                        <th>Total días</th>
                                        <th>Cantidad de casos</th>
                                        <th>Detalles</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for patologia, datos in statsInternacion %}
                                        <tr class="table-primary">
                                            <td><strong>{{ patologia }}</strong></td>
                                            <td><strong>{{ datos.promedio }}</strong></td>
                                            <td><strong>{{ datos.min }}</strong></td>
                                            <td><strong>{{ datos.max }}</strong></td>
                                            <td><strong>{{ datos.total }}</strong></td>
                                            <td><strong>{{ datos.casos }}</strong></td>
                                            <td class="text-center">
                                                {% if datos.subcategorias|length > 0 %}
                                                    <button type="button" class="btn btn-sm btn-info toggle-subcategoria" 
                                                            data-id="{{ datos.id }}">
                                                        <i class="fas fa-plus-circle"></i> Ver subcategorías
                                                    </button>
                                                {% else %}
                                                    <span class="badge badge-secondary">Sin subcategorías</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% if datos.subcategorias|length > 0 %}
                                            <tr class="subcategoria-container" id="subcategoria-{{ datos.id }}" style="display:none">
                                                <td colspan="7" class="p-0">
                                                    <table class="table table-sm mb-0 table-striped">
                                                        <tbody>
                                                            {% for subcategoria, subDatos in datos.subcategorias %}
                                                                <tr class="table-light">
                                                                    <td class="pl-4" style="width:22%">{{ subcategoria }}</td>
                                                                    <td style="width:13%">{{ subDatos.promedio }}</td>
                                                                    <td style="width:13%">{{ subDatos.min }}</td>
                                                                    <td style="width:13%">{{ subDatos.max }}</td>
                                                                    <td style="width:13%">{{ subDatos.total }}</td>
                                                                    <td style="width:13%">{{ subDatos.casos }}</td>
                                                                    <td style="width:13%"></td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% else %}
                                        <tr><td colspan="7" class="text-center">No hay datos de internación registrados.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="chart-container" style="height: 320px;">
                            <canvas id="internacionPatologiaChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Datos para los gráficos
            const ocupacionData = {{ ocupacionPorDia|raw }};
            
            // El porcentaje de ocupación ya se establece en el HTML directamente
            // desde el backend con {{ ocupacionActual }}%, así que no necesitamos actualizarlo aquí
            
            // Solo para debugging
            const ultimoDia = ocupacionData[ocupacionData.length - 1];
            if (ultimoDia) {
                console.log('Datos de ocupación disponibles: ' + Math.round(ultimoDia.porcentaje) + '%');
            } else {
                console.log('No se encontraron datos históricos de ocupación para el período seleccionado');
            }
            
            // Gráfico de línea para tendencia de ocupación
            const tendenciaChartEl = document.getElementById('tendencia-chart');
            if (tendenciaChartEl) {
                const fechas = ocupacionData.map(item => item.fecha);
                const porcentajes = ocupacionData.map(item => item.porcentaje);
                
                new Chart(tendenciaChartEl, {
                    type: 'line',
                    data: {
                        labels: fechas,
                        datasets: [{
                            label: 'Porcentaje de ocupación',
                            data: porcentajes,
                            borderColor: '#60b9b9',
                            backgroundColor: 'rgba(96, 185, 185, 0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                ticks: {
                                    callback: function(value) {
                                        return value + '%';
                                    }
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const dataPoint = ocupacionData[context.dataIndex];
                                        return [
                                            `Ocupación: ${dataPoint.porcentaje}%`,
                                            `Camas ocupadas: ${dataPoint.ocupadas}/${dataPoint.total}`
                                        ];
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Gráfico de barras: promedio de días de internación por patología
            var ctx = document.getElementById('internacionPatologiaChart');
            if (ctx) {
                var labels = [];
                var promedios = [];
                var minimos = [];
                var maximos = [];
                var casos = [];
                {% for patologia, datos in statsInternacion %}
                    labels.push(`{{ patologia|e('js') }}`);
                    promedios.push({{ datos.promedio }});
                    minimos.push({{ datos.min }});
                    maximos.push({{ datos.max }});
                    casos.push({{ datos.casos }});
                {% endfor %}
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Promedio de días',
                                data: promedios,
                                backgroundColor: '#60b9b9',
                            },
                            {
                                label: 'Mínimo',
                                data: minimos,
                                backgroundColor: '#b088be',
                            },
                            {
                                label: 'Máximo',
                                data: maximos,
                                backgroundColor: '#ffc107',
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: { enabled: true }
                        },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-submit del formulario cuando cambia algún select
            const monthSelect = document.querySelector('select[name="month"]');
            const yearSelect = document.querySelector('select[name="year"]');
            
            if (monthSelect && yearSelect) {
                monthSelect.addEventListener('change', function() {
                    document.getElementById('period-filter').submit();
                });
                
                yearSelect.addEventListener('change', function() {
                    document.getElementById('period-filter').submit();
                });
            }
            
            // Funcionalidad para mostrar/ocultar subcategorías
            document.querySelectorAll('.toggle-subcategoria').forEach(function(button) {
                button.addEventListener('click', function() {
                    const patologiaId = this.getAttribute('data-id');
                    const subcategoriaRow = document.getElementById('subcategoria-' + patologiaId);
                    
                    if (subcategoriaRow.style.display === 'none') {
                        subcategoriaRow.style.display = 'table-row';
                        this.innerHTML = '<i class="fas fa-minus-circle"></i> Ocultar subcategorías';
                        this.classList.remove('btn-info');
                        this.classList.add('btn-secondary');
                    } else {
                        subcategoriaRow.style.display = 'none';
                        this.innerHTML = '<i class="fas fa-plus-circle"></i> Ver subcategorías';
                        this.classList.remove('btn-secondary');
                        this.classList.add('btn-info');
                    }
                });
            });
        });
    </script>
{% endblock %}