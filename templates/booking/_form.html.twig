{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'booking-form'}}) }}

{% if isDoctorEdit is defined and isDoctorEdit %}
    {# Vista simplificada para doctores: solo fecha/hora #}
    <div class="container-fluid pb-4">
        <div class="alert alert-info">
            <i class="fas fa-info-circle mr-2"></i> Estás editando tu turno. Solo puedes modificar la fecha y hora.
        </div>
        
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-clock mr-2"></i>Horario del Turno</h5>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.beginAt, 'Fecha y Hora de Inicio') }}
                            {{ form_widget(form.beginAt, {'attr': {'min': 'now'|date('Y-m-d\\TH:i'), 'class': 'form-control', 'id': 'booking-begin-at'}}) }}
                            {{ form_errors(form.beginAt) }}
                            <small id="begin-at-validation" class="text-danger" style="display: none;"></small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.endAt, 'Fecha y Hora de Fin') }}
                            {{ form_widget(form.endAt, {'attr': {'min': 'now'|date('Y-m-d\\TH:i'), 'class': 'form-control', 'id': 'booking-end-at'}}) }}
                            {{ form_errors(form.endAt) }}
                            <small id="end-at-validation" class="text-danger" style="display: none;"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="form-group">
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary btn-lg mr-2'}}) }}
            <a class="btn btn-secondary btn-lg" href="{{ path('doctor_agenda', {'periodo': 'mes'}) }}">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </a>
        </div>
    </div>
{% else %}
    {# Vista completa para administradores #}
    <div class="container-fluid pb-4">
        
        {# Sección 1: Información del Paciente #}
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-user-injured mr-2"></i>Información del Paciente</h5>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {% if form.modalidadFilter is defined %}
                                {{ form_label(form.modalidadFilter, 'Filtrar por Modalidad') }}
                                {{ form_widget(form.modalidadFilter, {'attr': {'id': 'modalidad-filter-select', 'class': 'form-control'}}) }}
                                <small class="form-text text-muted">Filtre los pacientes por tipo de internación</small>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.cliente, 'Paciente') }}
                            {{ form_widget(form.cliente, {'attr': {'id': 'booking-cliente-select', 'class': 'predictivo form-control'}}) }}
                            {{ form_errors(form.cliente) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Sección 2: Información del Profesional #}
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-user-md mr-2"></i>Información del Profesional</h5>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {% if form.roleFilter is defined %}
                                {{ form_label(form.roleFilter, 'Filtrar por Rol') }}
                                {{ form_widget(form.roleFilter, {'attr': {'id': 'role-filter-select', 'class': 'form-control'}}) }}
                                <small class="form-text text-muted">Filtre los profesionales por su rol</small>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.doctor, 'Profesional') }}
                            {{ form_widget(form.doctor, {'attr': {'id': 'booking-doctor-select', 'class': 'predictivo form-control'}}) }}
                            {{ form_errors(form.doctor) }}
                        </div>
                    </div>
                </div>
                
                {# Sección de Horarios Disponibles del Doctor #}
                <div id="doctor-business-hours-section" class="mt-3" style="display: none;">
                    <div class="alert alert-info mb-0">
                        <h6 class="mb-2"><i class="fas fa-clock mr-2"></i>Horarios Disponibles del Profesional</h6>
                        <p class="text-muted small mb-2">Los turnos solo pueden agendarse dentro de estos horarios:</p>
                        <div id="business-hours-display" class="row">
                            {# Se llenará dinámicamente con JavaScript #}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Sección 3: Información del Turno #}
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-calendar-alt mr-2"></i>Información del Turno</h5>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-12">
                        <div class="form-group">
                            {{ form_label(form.title, 'Título') }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ingrese un título para el turno (opcional)'}}) }}
                            {{ form_errors(form.title) }}
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.beginAt, 'Fecha y Hora de Inicio') }}
                            {{ form_widget(form.beginAt, {'attr': {'min': 'now'|date('Y-m-d\\TH:i'), 'class': 'form-control', 'id': 'booking-begin-at'}}) }}
                            {{ form_errors(form.beginAt) }}
                            <small id="begin-at-validation" class="text-danger" style="display: none;"></small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.endAt, 'Fecha y Hora de Fin') }}
                            {{ form_widget(form.endAt, {'attr': {'min': 'now'|date('Y-m-d\\TH:i'), 'class': 'form-control', 'id': 'booking-end-at'}}) }}
                            {{ form_errors(form.endAt) }}
                            <small id="end-at-validation" class="text-danger" style="display: none;"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Sección 4: Repetición (si aplica) #}
        {% if form.dias is defined %}
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-redo mr-2"></i>Repetición del Turno</h5>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.dias, 'Días de la Semana') }}
                            <div class="columnas-de-dos">
                                {{ form_widget(form.dias) }}
                            </div>
                            <small class="form-text text-muted">Seleccione los días en que se repetirá el turno</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.desde, 'Fecha Desde') }}
                            {{ form_widget(form.desde, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.desde) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.hasta, 'Fecha Hasta') }}
                            {{ form_widget(form.hasta, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.hasta) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# Botones de acción #}
        <div class="form-group mt-4">
            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary btn-lg mr-2'}}) }}
            <a class="btn btn-secondary btn-lg" href="{{ path('booking_calendar') }}">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </a>
        </div>
    </div>
{% endif %}
{{ form_end(form) }}
