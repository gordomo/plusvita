{% extends 'base.html.twig' %}

{% block title %}Pacientes index{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/cliente.css') }}">
    <style>
        /* Estilos adicionales para mejorar la interfaz */
        .nav-tabs .nav-link {
            font-weight: 500;
            padding: 0.75rem 1.25rem;
            border-radius: 0.25rem 0.25rem 0 0;
            position: relative;
        }
        
        .nav-tabs .nav-link.active {
            background-color: #f8f9fa;
            border-bottom-color: #f8f9fa;
            font-weight: bold;
        }
        
        .nav-tabs .nav-link .badge {
            position: absolute;
            top: 3px;
            right: 3px;
            font-size: 0.7rem;
        }
        
        .filter-panel {
            background-color: #f8f9fa;
            border-radius: 0.25rem;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        
        .table th {
            position: sticky;
            top: 0;
            background-color: #fff;
            z-index: 10;
        }
        
        tr.editarPaciente {
            cursor: pointer;
        }
        
        /* Colores de fondo para estados de pacientes */
        .ambulatorio-presente {
            background-color: rgba(40, 167, 69, 0.15) !important;
        }
        
        .ambulatorio-ausente {
            background-color: rgba(255, 193, 7, 0.15) !important;
        }
        
        .noDisp {
            background-color: rgba(255, 192, 203, 0.3) !important;
        }
        
        /* Estilos para elementos de la leyenda de colores */
        .color-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
            padding: 0.5rem;
            border-radius: 0.25rem;
            background-color: #fff;
            border: 1px solid #e9ecef;
        }
        
        .color-legend-item {
            display: flex;
            align-items: center;
            font-size: 0.875rem;
        }
        
        .color-legend-box {
            width: 1.25rem;
            height: 1.25rem;
            margin-right: 0.5rem;
            border-radius: 0.25rem;
            border: 1px solid rgba(0,0,0,0.1);
        }
        
        .dropdown-item i {
            width: 1.25rem;
            text-align: center;
            margin-right: 0.5rem;
        }
        
        .btn-action {
            white-space: nowrap;
        }
        
        .bell {
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
    </style>
{% endblock %}

{% block panelTitle %}
    <div class="d-flex justify-content-between align-items-center">
        <span>Pacientes</span>
        <a href="{{ path('cliente_new') }}" class="btn btn-success btn-sm">
            <i class="fas fa-plus-circle"></i> Nuevo Paciente
        </a>
    </div>
{% endblock %}

{% block body %}
    <!-- Pestañas de navegación mejoradas -->
    <div class="card mb-4">
        <div class="card-header p-0 border-bottom-0">
            <ul class="nav nav-tabs justify-content-center">
                <li class="nav-item">
                    <a class="nav-link {{  pestana == 'activos' ? 'active' : ''  }}" href="{{ path('cliente_index') }}">
                        <i class="fas fa-user-check mr-1"></i> Activos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{  pestana == 'inactivos' ? 'active' : ''  }}" href="{{ path('cliente_index') }}?pestana=inactivos">
                        <i class="fas fa-user-times mr-1"></i> Inactivos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{  pestana == 'derivados' ? 'active' : ''  }}"  href="{{ path('cliente_index') }}?pestana=derivados">
                        <i class="fas fa-hospital mr-1"></i> Derivados
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{  pestana == 'permiso' ? 'active' : ''  }}"  href="{{ path('cliente_index') }}?pestana=permiso">
                        <i class="fas fa-home mr-1"></i> De Permiso
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{  pestana == 'ambulatorios' ? 'active' : ''  }}"  href="{{ path('cliente_index') }}?pestana=ambulatorios">
                        <i class="fas fa-walking mr-1"></i> Ambulatorios
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Panel de filtros mejorado -->
        <div class="card-body filter-panel">
            <div class="row">
                <div class="col-md-3">
                    <div class="input-group mb-md-0 mb-3">
                        <input id='nombreInput' type="text" value="{{ nombreInput }}" class="form-control" placeholder="Buscar por Nombre" aria-label="Buscar por Nombre">
                        <div class="input-group-append">
                            <a class="btn btn-primary"
                               data-inactivo="{{ pestana != 'activos' }}"
                               data-url="{{ path('cliente_index') }}{{  pestana != 'activos' ? '?pestana=' ~ pestana : ''  }}"
                               type="button" id="buscarPorNombre">
                                <i class="fas fa-search"></i>
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <div class="dropdown mb-md-0 mb-3">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100" type="button" id="dropdownObrasButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ idObraSelected is not null ? oSociales[idObraSelected] : 'Obra Social' }}
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownObrasButton">
                            <a class="dropdown-item" href="{{ path('cliente_index') }}{{  pestana != 'activos' ? '?pestana=' ~ pestana : '' }}">Todas</a>
                            <div class="dropdown-divider"></div>
                            {% for idObra, obra in oSociales %}
                                <a class="dropdown-item" href="{{ path('cliente_index') }}{{  pestana != 'activos' ? '?pestana=' ~ pestana ~ '&idObra=' ~ idObra : '?idObra=' ~ idObra }}">{{ obra }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                
                {% if (pestana == 'activos') %}
                <div class="col-md-3">
                    <div class="dropdown mb-md-0 mb-3">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100" type="button" id="dropdownHabitacionButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ hab is not null ? habitacionesArray[hab] : 'Habitación' }}
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownHabitacionButton">
                            <a class="dropdown-item" href="{{ path('cliente_index') }}{{  pestana != 'activos' ? '?pestana=' ~ pestana : '' }}">Todas</a>
                            <div class="dropdown-divider"></div>
                            {% for idHab, habNombre in habitacionesArray %}
                                <a class="dropdown-item" href="{{ path('cliente_index') }}{{  pestana != 'activos' ? '?pestana=' ~ pestana ~ '&hab=' ~ idHab : '?hab=' ~ idHab }}">{{ habNombre }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                
                <div class="col-md-3">
                    <div class="d-flex">
                        <button class="btn btn-outline-secondary flex-grow-1 mr-2" data-toggle="modal" data-target="#camposExtras">
                            <i class="fas fa-columns"></i> Columnas
                        </button>
                        <button class="btn btn-outline-secondary" id="printButton">
                            <i class="fas fa-print"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Leyenda de colores para clarificar el significado -->
            <div class="color-legend mt-3">
                <div class="color-legend-item">
                    <div class="color-legend-box" style="background-color: rgba(40, 167, 69, 0.15);"></div>
                    <span>Ambulatorio Presente</span>
                </div>
                <div class="color-legend-item">
                    <div class="color-legend-box" style="background-color: rgba(255, 193, 7, 0.15);"></div>
                    <span>Ambulatorio Ausente</span>
                </div>
                <div class="color-legend-item">
                    <div class="color-legend-box" style="background-color: rgba(220, 53, 69, 0.15);"></div>
                    <span>No Disponible para Terapia</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de pacientes con diseño mejorado -->
    <div class="card" style="height: 100%">
        <div class="card-body p-0">
            <div class="table-responsive printiable" style="height: 100%">
                <table class="table table-hover table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th class="hClinica">
                                <a href="{{ path('cliente_index', {
                                    pestana: pestana,
                                    nombreInput: nombreInput,
                                    hab: hab,
                                    idObra: idObra,
                                    sort: 'hClinica',
                                    direction: sortField == 'hClinica' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                                    currentPage: currentPage,
                                    limit: limit
                                }) }}" class="text-dark">
                                    H. Clínica
                                    {% if sortField == 'hClinica' %}
                                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort text-muted"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="nombre">
                                <a href="{{ path('cliente_index', {
                                    pestana: pestana,
                                    nombreInput: nombreInput,
                                    hab: hab,
                                    idObra: idObra,
                                    sort: 'nombre',
                                    direction: sortField == 'nombre' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                                    currentPage: currentPage,
                                    limit: limit
                                }) }}" class="text-dark">
                                    Nombre
                                    {% if sortField == 'nombre' %}
                                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort text-muted"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="apellido">
                                <a href="{{ path('cliente_index', {
                                    pestana: pestana,
                                    nombreInput: nombreInput,
                                    hab: hab,
                                    idObra: idObra,
                                    sort: 'apellido',
                                    direction: sortField == 'apellido' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                                    currentPage: currentPage,
                                    limit: limit
                                }) }}" class="text-dark">
                                    Apellido
                                    {% if sortField == 'apellido' %}
                                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                                    {% else %}
                                        <i class="fas fa-sort text-muted"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="fNacimiento">F. Nac</th>
                            <th class="edad">Edad</th>
                            <th class="dni">Dni</th>
                            <th class="ultimaEvolucion">Última Evolución</th>
                            <th class="Email">Email</th>
                            <th class="telefono">Teléfono</th>
                            <th class="fIngreso">Fecha Ingreso</th>
                            <th class="motivoIng">Motivo Ing</th>
                            <th class="motivoIngEspecifico">Motivo Ing Especifico</th>
                            <th class="modalidad">Modalidad</th>
                            <th class="fEgreso">Fecha Egreso</th>
                            <th class="motivoEgr">Motivo Egreso</th>
                            <th class="obraSocial">O. Social</th>
                            <th class="obraSocialAfiliado">N Afiliado OS</th>
                            <th class="tipoDePago">Tipo de Pago</th>
                            <th class="vieneDe">Viene de</th>
                            <th class="posicionEnArchivo">Posicion en Archivo</th>
                            <th class="docDerivante">Doc derivante</th>
                            <th class="habitacion">Habitación</th>
                            <th class="nCama">Cama</th>
                            <th class="docReferente">Doc Referente</th>
                            <th class="familiarResponsableNombre">Familiar Responsable</th>
                            <th class="familiarResponsableTel">Teléfono Familiar</th>
                            <th class="familiarResponsableMail">Email Familiar</th>
                            <th class="familiarResponsableAcompanante">Es Acompañante</th>
                            <th class="vinculoResponsable">Vínculo</th>
                            <th class="sistemaDeEmergenciaNombre">Sistema Emergencia</th>
                            <th class="sistemaDeEmergenciaTel">Tel. Emergencia</th>
                            <th class="sistemaDeEmergenciaAfiliado">Afiliado Emergencia</th>
                            <th class="disponibleParaTerapia">Disponible Terapia</th>
                            <th class="derivado">Derivado</th>
                            <th class="dePermiso">De Permiso</th>
                            <th class="derivadoEn">Derivado En</th>
                            <th class="fechaDerivacion">Fecha Derivación</th>
                            <th class="motivoDerivacion">Motivo Derivación</th>
                            <th class="empTrasladoDerivacion">Emp. Traslado</th>
                            <th class="fechaReingresoDerivacion">Fecha Reingreso</th>
                            <th class="motivoReingresoDerivacion">Motivo Reingreso</th>
                            <th class="fechaBajaPorPermiso">Fecha Baja Permiso</th>
                            <th class="fechaAltaPorPermiso">Fecha Alta Permiso</th>
                            <th class="terapiasHabilitadas">Terapias Habilitadas</th>
                            <th class="terapiasNoHabilitadas">Terapias No Habilitadas</th>
                            <th class="sesionesDisp">Sesiones Disp</th>
                            <th class="formNum">N° Formulario</th>
                            <th class="vtoSesiones">Vto Sesiones</th>
                            <th class="mediaSesionView">Media Sesión</th>
                            <th class="dieta">Dieta</th>
                            <th class="acciones text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% set pestanasPresente = ['ambulatorios','activos','todos']%}
                    {% for cliente in clientes %}
                        <tr class="editarPaciente {{ pestana == 'ambulatorios' ? cliente.modalidad == 1 or cliente.modalidad == 4 ? 'ambulatorio' : 'no-ambulatorio' : '' }} {{ pestana in pestanasPresente ? ( cliente.ambulatorioPresente  ? 'ambulatorio-presente' :  'ambulatorio-ausente' ) : '' }} {{ cliente.disponibleParaTerapia ? '' : 'noDisp' }}" data-toggle="tooltip" data-placement="top"
                                              {{ (cliente.modalidad != 1 and cliente.modalidad != 4) and pestana == 'ambulatorios' ? ' title="No está informado como ambulatorio"' : ''}}>
                            <td class="hClinica">{{ cliente.hClinica }}</td>
                            <td class="nombre">{{ cliente.nombre }}</td>
                            <td class="apellido">{{ cliente.apellido }}</td>
                            <td class="fNacimiento">{{ cliente.fNacimiento ? cliente.fNacimiento|date('d/m/Y') : '' }}</td>
                            <td class="edad">{{ cliente.edad }}</td>
                            <td class="dni">{{ cliente.dni }}</td>
                            <td class="ultimaEvolucion text-center">
                                {% if (pestana == 'activos') %}
                                    {% set nombres = '' %}
                                    {% set mostrarCampana = false %}
                                    {% for tipo, fecha in cliente.lastEvolution %}
                                        {% if fecha | date("Y-m-d") < "now"|date("Y-m-d") %}
                                            {% set mostrarCampana = true %}
                                            {% set nombres = nombres ~ tipo ~ ': ' ~ fecha ~ '<br>' %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if mostrarCampana %}
                                        <i class="bell far fa-bell" style="color: red" data-html="true" data-toggle="tooltip" data-bs-placement="right" title="{{ nombres | raw }}"></i>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="lowercase email">{{ cliente.email }}</td>
                            <td class="telefono">{{ cliente.telefono }}</td>
                            <td class="fIngreso">{{ cliente.fIngreso ? cliente.fIngreso|date('d/m/Y') : '' }}</td>
                            <td class="motivoIng">
                                {% if(cliente.motivoIng == 1) %}
                                    Neurologicas
                                {% elseif(cliente.motivoIng == 2) %}
                                    Traumatológicas
                                {% elseif(cliente.motivoIng == 3) %}
                                    Respiratorias
                                {% elseif(cliente.motivoIng == 4) %}
                                    Paliativos
                                {% elseif(cliente.motivoIng == 5) %}
                                    Patologías laborales
                                {% endif %}
                            </td>
                            <td class="motivoIngEspecifico">{{ cliente.motivoIngEspecifico }}</td>
                            <td class="modalidad">
                                {% if(cliente.modalidad == 1) %}
                                    <span class="badge badge-info">Ambulatorio</span>
                                {% elseif(cliente.modalidad == 2) %}
                                    <span class="badge badge-primary">Internación</span>
                                {% elseif(cliente.modalidad == 3) %}
                                    <span class="badge badge-success">Hospital de día</span>
                                {% elseif(cliente.modalidad == 4) %}
                                    <span class="badge badge-warning">ART</span>
                                {% endif %}
                            </td>
                            <td class="fEgreso">{{ cliente.fEgreso ? cliente.fEgreso|date('d/m/Y') : '' }}</td>
                            <td class="motivoEgr">{{ cliente.motivoEgr }}</td>
                            <td class="obraSocial">
                                {% set obraSocialNombre = cliente.obraSocial.nombre ?? 'no tiene' %}
                                <span data-toggle="tooltip" data-placement="top" title="{{ obraSocialNombre }}" style="cursor: help;">
                                    {{ obraSocialNombre|length > 15 ? obraSocialNombre|slice(0, 15) ~ '...' : obraSocialNombre }}
                                </span>
                            </td>
                            <td class="obraSocialAfiliado">{{ cliente.obraSocialAfiliado }}</td>
                            <td class="tipoDePago">
                                {% if(cliente.tipoDePago == 1) %}
                                    Particular
                                {% elseif(cliente.tipoDePago == 2) %}
                                    Reintegro
                                {% elseif(cliente.tipoDePago == 3) %}
                                    Discapacidad
                                {% elseif(cliente.tipoDePago == 4) %}
                                    ART
                                {% elseif(cliente.tipoDePago == 5) %}
                                    Convenio
                                {% elseif(cliente.tipoDePago == 6) %}
                                    Amparo
                                {% elseif(cliente.tipoDePago == 7) %}
                                    Presupuesto
                                {% endif %}
                            </td>
                            <td class="vieneDe">{{ cliente.vieneDe }}</td>
                            <td class="posicionEnArchivo">{{ cliente.posicionEnArchivo }}</td>
                            <td class="docDerivante">{{ cliente.docDerivante }}</td>
                            <td class="habitacion">
                                {% if habitacionesArray[cliente.habitacion] is defined %}
                                    {{ habitacionesArray[cliente.habitacion] }}
                                {% endif %}
                            </td>
                            <td class="nCama">
                                {% if cliente.habPrivada %}
                                    <span class="badge badge-info">Privada</span>
                                {% else %}
                                    {{ cliente.nCama }}
                                {% endif %}
                            </td>
                            <td class="docReferente">
                                {% for responsable in cliente.docReferente %}
                                    {{ responsable.nombre | lower | capitalize }} {{ responsable.apellido | lower | capitalize }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </td>
                            <td class="familiarResponsableNombre">{{ cliente.familiarResponsableNombre }}</td>
                            <td class="familiarResponsableTel">{{ cliente.familiarResponsableTel }}</td>
                            <td class="familiarResponsableMail">{{ cliente.familiarResponsableMail }}</td>
                            <td class="familiarResponsableAcompanante">{{ cliente.familiarResponsableAcompanante ? 'Sí' : 'No' }}</td>
                            <td class="vinculoResponsable">{{ cliente.vinculoResponsable }}</td>
                            <td class="sistemaDeEmergenciaNombre">{{ cliente.sistemaDeEmergenciaNombre }}</td>
                            <td class="sistemaDeEmergenciaTel">{{ cliente.sistemaDeEmergenciaTel }}</td>
                            <td class="sistemaDeEmergenciaAfiliado">{{ cliente.sistemaDeEmergenciaAfiliado }}</td>
                            <td class="disponibleParaTerapia">{{ cliente.disponibleParaTerapia ? 'Sí' : 'No' }}</td>
                            <td class="derivado">{{ cliente.derivado ? 'Sí' : 'No' }}</td>
                            <td class="dePermiso">{{ cliente.dePermiso ? 'Sí' : 'No' }}</td>
                            <td class="derivadoEn">{{ cliente.derivadoEn }}</td>
                            <td class="fechaDerivacion">{{ cliente.fechaDerivacion ? cliente.fechaDerivacion|date('d/m/Y') : '' }}</td>
                            <td class="motivoDerivacion">{{ cliente.motivoDerivacion }}</td>
                            <td class="empTrasladoDerivacion">{{ cliente.empTrasladoDerivacion }}</td>
                            <td class="fechaReingresoDerivacion">{{ cliente.fechaReingresoDerivacion ? cliente.fechaReingresoDerivacion|date('d/m/Y') : '' }}</td>
                            <td class="motivoReingresoDerivacion">{{ cliente.motivoReingresoDerivacion }}</td>
                            <td class="fechaBajaPorPermiso">{{ cliente.fechaBajaPorPermiso ? cliente.fechaBajaPorPermiso|date('d/m/Y') : '' }}</td>
                            <td class="fechaAltaPorPermiso">{{ cliente.fechaAltaPorPermiso ? cliente.fechaAltaPorPermiso|date('d/m/Y') : '' }}</td>
                            <td class="terapiasHabilitadas">{{ cliente.terapiasHabilitadas ? cliente.terapiasHabilitadas|json_encode : '' }}</td>
                            <td class="terapiasNoHabilitadas">{{ cliente.terapiasNoHabilitadas ? cliente.terapiasNoHabilitadas|json_encode : '' }}</td>
                            <td class="sesionesDisp">{{ cliente.sesionesDisp }}</td>
                            <td class="formNum">{{ cliente.formNum }}</td>
                            <td class="vtoSesiones">{{ cliente.vtoSesiones ? cliente.vtoSesiones|date('d/m/Y') : '' }}</td>
                            <td class="mediaSesionView">{{ cliente.mediaSesion ? 'Sí' : 'No' }}</td>
                            <td class="dieta">{{ cliente.dieta }}</td>
                            <td class="acciones text-right">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-primary dropdown-toggle btn-action" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Acciones
                                    </button>
                                    <div class="dropdown-menu" style="margin-left: -150px;">
                                        <h6 class="dropdown-header">Información</h6>
                                        {% if is_granted('patient.view') %}
                                        <a class="dropdown-item" href="{{ path('cliente_show', {'id': cliente.id}) }}">
                                            <i class="fas fa-eye"></i> Ver datos
                                        </a>
                                        {% endif %}
                                        {% if is_granted('patient.edit') %}
                                        <a class="dropdown-item" href="{{ path('cliente_edit', {'id': cliente.id}) }}">
                                            <i class="fas fa-pencil-alt"></i> Editar
                                        </a>
                                        {% endif %}
                                        {% if is_granted('patient.edit') %}
                                        <a class="dropdown-item" href="{{ path('adjuntos_pacientes_new', {'id': cliente.id}) }}">
                                            <i class="fas fa-paperclip"></i> Adjuntar
                                        </a>
                                        {% endif %}
                                        {% if is_granted('patient.history') %}
                                        <a class="dropdown-item" href="{{ path('cliente_historial', {'id': cliente.id}) }}">
                                            <i class="far fa-calendar-alt"></i> Historia clínica
                                        </a>
                                        {% endif %}
                                        {% if is_granted('qr.generate') %}
                                        <a class="dropdown-item" href="{{ path('make_qr_historia', {'id': cliente.id}) }}">
                                            <i class="fa fa-qrcode"></i> Códigos QR
                                        </a>
                                        {% endif %}
                                        
                                        <div class="dropdown-divider"></div>
                                        <h6 class="dropdown-header">Seguimiento</h6>
                                        
                                        {% if is_granted('patient.evolve') %} 
                                        <a class="dropdown-item" href="{{ path('evolucion_index', {'cliente': cliente.id}) }}">
                                            <i class="fa fa-info-circle"></i> Evoluciones
                                        </a>
                                        <a class="dropdown-item" href="{{ path('historia_ingreso_new', {'cliente': cliente.id}) }}">
                                            <i class="far fa-calendar-alt"></i> Historia de Ingreso
                                        </a>
                                        {% endif %}
                                        {% if is_granted('patient.indication') %}
                                        <a class="dropdown-item" href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}">
                                            <i class="fas fa-pills"></i> Indicaciones
                                        </a>
                                        {% endif %}
                                        {% if is_granted('patient.kardex') %}
                                        <a class="dropdown-item" href="{{ path('medicacion_enfermeria', {'id': cliente.id}) }}">
                                            <i class="fas fa-syringe"></i> Kardex
                                        </a>
                                        {% endif %}
                                        
                                        <div class="dropdown-divider"></div>
                                        <h6 class="dropdown-header">Informes</h6>
                                        
                                        {% if is_granted('informe_mensual.view') %}
                                        <a class="dropdown-item" href="{{ path('informe_mensual_new', {'cliente': cliente.id}) }}">
                                            <i class="fas fa-file-medical-alt"></i> Generar Informe Mensual
                                        </a>
                                        {% endif %}
                                        {% if is_granted('informe_mensual.view') %}
                                        <a class="dropdown-item" href="{{ path('informe_mensual_index') }}?paciente={{ cliente.id }}">
                                            <i class="fas fa-history"></i> Ver Informes Mensuales
                                        </a>
                                        {% endif %}
                                        
                                        <div class="dropdown-divider"></div>
                                        <h6 class="dropdown-header">Cambios de estado</h6>
                                        
                                        {% if pestana == 'inactivos' %}
                                            {% if is_granted('patient.edit') %}
                                            <a class="dropdown-item" href="{{ path('cliente_reingresar', {'id': cliente.id, 'tipo': pestana}) }}">
                                                <i class="fas fa-sign-in-alt"></i> Reingresar
                                            </a>
                                            {% endif %}
                                        {% elseif pestana == 'activos' %}
                                            {% if is_granted('patient.discharge') %}
                                            <a class="dropdown-item" href="{{ path('cliente_egreso', {'id': cliente.id}) }}">
                                                <i class="fas fa-sign-out-alt"></i> Egresar
                                            </a>
                                            {% endif %}
                                            {% if is_granted('patient.refer') %}
                                            <a class="dropdown-item" href="{{ path('cliente_derivar', {'id': cliente.id}) }}">
                                                <i class="fas fa-exchange-alt"></i> Derivar
                                            </a>
                                            {% endif %}
                                            {% if is_granted('patient.permission') %}
                                            <a class="dropdown-item" href="{{ path('cliente_permiso', {'id': cliente.id}) }}">
                                                <i class="fas fa-home"></i> Dar permiso
                                            </a>
                                            {% endif %}
                                            {% if is_granted('patient.outpatient') %}
                                            <a class="dropdown-item" href="{{ path('cliente_ambulatorio', {'id': cliente.id}) }}">
                                                <i class="fas fa-walking"></i> Ambulatorio
                                            </a>
                                            {% endif %}
                                            {# <a class="dropdown-item" href="{{ path('prescripcion_new', {'id': cliente.id}) }}">
                                                <i class="fas fa-prescription"></i> Prescripciones
                                            </a> #}
                                        {% else %}
                                            <a class="dropdown-item" href="{{ path('cliente_reingresar', {'id': cliente.id, 'tipo': pestana}) }}">
                                                <i class="fas fa-sign-in-alt"></i> Reingresar
                                            </a>
                                            <a class="dropdown-item" href="{{ path('cliente_egreso', {'id': cliente.id}) }}">
                                                <i class="fas fa-sign-out-alt"></i> Egresar
                                            </a>
                                        {% endif %}
                                        
                                        {% if pestana == 'ambulatorios' or pestana == 'activos' %}
                                            {% if is_granted('patient.attendance') %}
                                            <div class="dropdown-divider"></div>
                                            <h6 class="dropdown-header">Asistencia</h6>
                                            
                                            {% if not cliente.ambulatorioPresente %}
                                                <a class="dropdown-item" href="{{ path('dar_presente', {'id': cliente.id, 'pestana': pestana, 'currentPage': currentPage, 'sortField': sortField, 'sortDirection': sortDirection, 'limit': limit}) }}">
                                                    <i class="fas fa-check-circle"></i> Dar presente
                                                </a>
                                            {% endif %}
                                            {% if cliente.ambulatorioPresente %}
                                                <a class="dropdown-item" href="{{ path('dar_ausente', {'id': cliente.id, 'pestana': pestana, 'currentPage': currentPage, 'sortField': sortField, 'sortDirection': sortDirection, 'limit': limit}) }}">
                                                    <i class="fas fa-times-circle"></i> Dar ausente
                                                </a>
                                            {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="15" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                    <p class="lead">No se encontraron pacientes que coincidan con los criterios de búsqueda</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="50">
                                {% if maxPages > 1 %}
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <div class="d-flex align-items-center mb-2">
                                            <label for="limit-selector" class="mr-2 mb-0">Mostrar:</label>
                                            <select id="limit-selector" class="form-control form-control-sm" style="width: auto;">
                                                <option value="10" {% if limit == 10 %}selected{% endif %}>10</option>
                                                <option value="25" {% if limit == 25 %}selected{% endif %}>25</option>
                                                <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
                                                <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
                                            </select>
                                            <span class="ml-2">pacientes por página</span>
                                        </div>
                                        
                                        <nav aria-label="Paginación">
                                            <ul class="pagination justify-content-center mb-0">
                                                {% if currentPage > 1 %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('cliente_index', {
                                                            currentPage: (currentPage-1 < 1 ? 1 : currentPage-1),
                                                            pestana: ((pestana) ? pestana : null), 
                                                            nombreInput: ((nombreInput) ? nombreInput : null),
                                                            limit: ((limit) ? limit : null), 
                                                            hab: ((hab) ? hab : null), 
                                                            idObra: ((idObra) ? idObra : null), 
                                                        }) }}">«</a>
                                                    </li>
                                                {% endif %}

                                                {# Definir el rango de páginas a mostrar #}
                                                {% set startPage = max(1, currentPage - 2) %}
                                                {% set endPage = min(maxPages, currentPage + 2) %}

                                                {# Mostrar la primera página si no está en el rango #}
                                                {% if startPage > 1 %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('cliente_index', {
                                                            currentPage: 1,
                                                            pestana: ((pestana) ? pestana : null), 
                                                            nombreInput: ((nombreInput) ? nombreInput : null),
                                                            limit: ((limit) ? limit : null), 
                                                            hab: ((hab) ? hab : null), 
                                                            idObra: ((idObra) ? idObra : null), 
                                                        }) }}">1</a>
                                                    </li>
                                                    {% if startPage > 2 %}
                                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    {% endif %}
                                                {% endif %}

                                                {# Mostrar las páginas en el rango definido #}
                                                {% for i in startPage..endPage %}
                                                    <li class="page-item {% if currentPage == i %}active{% endif %}">
                                                        <a class="page-link" href="{{ path('cliente_index', {
                                                            currentPage: i,
                                                            pestana: ((pestana) ? pestana : null), 
                                                            nombreInput: ((nombreInput) ? nombreInput : null),
                                                            limit: ((limit) ? limit : null), 
                                                            hab: ((hab) ? hab : null), 
                                                            idObra: ((idObra) ? idObra : null), 
                                                        }) }}">{{ i }}</a>
                                                    </li>
                                                {% endfor %}

                                                {# Mostrar la última página si no está en el rango #}
                                                {% if endPage < maxPages %}
                                                    {% if endPage < maxPages - 1 %}
                                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    {% endif %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('cliente_index', {
                                                            currentPage: maxPages,
                                                            pestana: ((pestana) ? pestana : null), 
                                                            nombreInput: ((nombreInput) ? nombreInput : null),
                                                            limit: ((limit) ? limit : null), 
                                                            hab: ((hab) ? hab : null), 
                                                            idObra: ((idObra) ? idObra : null), 
                                                        }) }}">{{ maxPages }}</a>
                                                    </li>
                                                {% endif %}

                                                {% if currentPage < maxPages %}
                                                    <li class="page-item">
                                                        <a class="page-link" href="{{ path('cliente_index', {
                                                            currentPage: (currentPage+1 <= maxPages ? currentPage+1 : currentPage),
                                                            pestana: ((pestana) ? pestana : null), 
                                                            nombreInput: ((nombreInput) ? nombreInput : null),
                                                            limit: ((limit) ? limit : null), 
                                                            hab: ((hab) ? hab : null), 
                                                            idObra: ((idObra) ? idObra : null), 
                                                        }) }}">»</a>
                                                    </li>
                                                {% endif %}
                                            </ul>
                                        </nav>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal de columnas (mantenido como estaba) -->
    <div class="modal fade bd-example-modal-lg camposExtras" id="camposExtras" tabindex="-1" role="dialog" aria-labelledby="camposExtras" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Seleccione los campos a mostrar</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group columnas-de-dos" id="checkboxesForView">
                        {% for fiel in [
                            'hClinica', 'nombre', 'apellido','dni', 'fNacimiento', 'edad', 'telefono', 'legajo','fIngreso',
                            'obraSocial', 'obraSocialAfiliado', 'tipoDePago',
                            'fEgreso','motivoIng', 'motivoEgr',
                            'docReferente', 'Email',
                            'vieneDe', 'posicionEnArchivo',
                            'docDerivante',
                            'modalidad', 'motivoIngEspecifico',
                            'habitacion', 'nCama', 'habPrivada', 'familiarResponsableNombre','familiarResponsableTel',
                            'familiarResponsableMail','familiarResponsableAcompanante',
                            'vinculoResponsable', 'sistemaDeEmergenciaNombre',
                            'sistemaDeEmergenciaTel', 'sistemaDeEmergenciaAfiliado','fIngreso',
                            'disponibleParaTerapia', 'derivado', 'dePermiso', 'derivadoEn', 'fechaDerivacion',
                            'motivoDerivacion', 'empTrasladoDerivacion', 'fechaReingresoDerivacion', 'motivoReingresoDerivacion', 'fechaBajaPorPermiso',
                            'fechaAltaPorPermiso', 'terapiasHabilitadas', 'terapiasNoHabilitadas', 'sesionesDisp',
                            'formNum', 'vtoSesiones', 'mediaSesionView', 'dieta', 'acciones'
                            ] %}

                            <div class="form-check">
                                <input class="form-check-input checkForView"
                                        {% if fiel == 'hClinica' %} checked {% endif %}
                                        {% if fiel == 'nombre' %} checked {% endif %}
                                        {% if fiel == 'apellido' %} checked {% endif %}
                                        {% if fiel == 'dni' %} checked {% endif %}
                                        {% if fiel == 'habitacion' %} checked {% endif %}
                                        {% if fiel == 'nCama' %} checked {% endif %}
                                        {% if fiel == 'fIngreso' %} checked {% endif %}
                                        {% if fiel == 'obraSocial' %} checked {% endif %}
                                        {% if fiel == 'tipoDePago' %} checked {% endif %}
                                        {% if fiel == 'motivoIng' %} checked {% endif %}
                                        {% if fiel == 'docReferente' %} checked {% endif %}
                                        {% if fiel == 'acciones' %} checked {% endif %}
                                       type="checkbox" value="{{ fiel }}" id="{{ fiel }}"
                                >
                                <label class="form-check-label" for="{{ fiel }}" style="text-transform: capitalize">
                                    {{ fiel }}
                                </label>
                            </div>
                        {% endfor %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="todos" id="todosForView">
                            <label class="form-check-label" for="todosForView">
                                Todos
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-primary" id="updateCamposForView">Aplicar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block modalImprimir %}
    {% for fiel in [
        'hClinica', 'nombre', 'apellido','dni', 'fNacimiento', 'edad', 'telefono', 'legajo','fIngreso',
        'obraSocial', 'obraSocialAfiliado', 'tipoDePago',
        'fEgreso','motivoIng', 'motivoEgr',
        'docReferente', 'Email',
        'vieneDe', 'posicionEnArchivo',
        'docDerivante',
        'modalidad', 'motivoIngEspecifico',
        'habitacion', 'nCama', 'habPrivada', 'familiarResponsableNombre','familiarResponsableTel',
        'familiarResponsableMail','familiarResponsableAcompanante',
        'vinculoResponsable', 'sistemaDeEmergenciaNombre',
        'sistemaDeEmergenciaTel', 'sistemaDeEmergenciaAfiliado','fIngreso',
        'disponibleParaTerapia', 'derivado', 'dePermiso', 'derivadoEn', 'fechaDerivacion',
        'motivoDerivacion', 'empTrasladoDerivacion', 'fechaReingresoDerivacion', 'motivoReingresoDerivacion', 'fechaBajaPorPermiso',
        'fechaAltaPorPermiso', 'terapiasHabilitadas', 'terapiasNoHabilitadas', 'sesionesDisp',
        'formNum', 'vtoSesiones', 'mediaSesionView', 'dieta'
        ] %}
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="{{ fiel }}" id="{{ fiel }}"
                    {% if fiel == 'hClinica' %} checked {% endif %}
                    {% if fiel == 'nombre' %} checked {% endif %}
                    {% if fiel == 'apellido' %} checked {% endif %}
                    {% if fiel == 'fIngreso' %} checked {% endif %}
                    {% if fiel == 'tipoDePago' %} checked {% endif %}
                    {% if fiel == 'motivoIng' %} checked {% endif %}
                    {% if fiel == 'docReferente' %} checked {% endif %}
            >
            <label class="form-check-label" for="{{ fiel }}" style="text-transform: capitalize">
                {{ fiel }}
            </label>
        </div>
    {% endfor %}
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="todos" id="todos">
        <label class="form-check-label" for="todos">
            Todos
        </label>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Función para buscar por nombre
            document.getElementById('buscarPorNombre').addEventListener('click', function() {
                let inactivo = this.getAttribute('data-inactivo') === 'true';
                let url = this.getAttribute('data-url');
                let search = document.getElementById('nombreInput').value;
                
                if (search.length > 0) {
                    window.location.href = url + (url.includes('?') ? '&' : '?') + 'nombreInput=' + encodeURIComponent(search);
                } else {
                    window.location.href = url;
                }
            });
            
            // Permitir búsqueda por Enter
            document.getElementById('nombreInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    document.getElementById('buscarPorNombre').click();
                }
            });
            
            // Selector de límite
            document.getElementById('limit-selector').addEventListener('change', function() {
                let limit = this.value;
                let currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('limit', limit);
                window.location.href = currentUrl.toString();
            });
            
            // Gestión de campos visibles
            const updateCamposBtn = document.getElementById('updateCamposForView');
            updateCamposBtn.addEventListener('click', function() {
                const checkboxes = document.querySelectorAll('.checkForView:checked');
                const camposAMostrar = Array.from(checkboxes).map(cb => cb.value);
                
                // Ocultar todas las columnas
                document.querySelectorAll('th, td').forEach(cell => {
                    if (!cell.classList.contains('acciones')) {
                        cell.style.display = 'none';
                    }
                });
                
                // Mostrar columnas seleccionadas
                camposAMostrar.forEach(campo => {
                    document.querySelectorAll('.' + campo).forEach(cell => {
                        cell.style.display = '';
                    });
                });
                
                // Cerrar modal
                $('#camposExtras').modal('hide');
            });
            
            // Selector "Todos"
            document.getElementById('todosForView').addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.checkForView');
                checkboxes.forEach(cb => {
                    cb.checked = this.checked;
                });
            });
            
            // Botón de impresión
            document.getElementById('printButton').addEventListener('click', function() {
                window.print();
            });
            
            // Inicializar tooltips de Bootstrap
            $(function () {
                $('[data-toggle="tooltip"]').tooltip();
            });
            
            // Inicializar dropdowns de Bootstrap (configuración estándar)
            $('.dropdown-toggle').dropdown();
        });
    </script>
{% endblock %}
