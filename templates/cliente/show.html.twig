{% extends 'base.html.twig' %}

{% block title %}Ver Paciente - {{ cliente.nombre }} {{ cliente.apellido }}{% endblock %}
{% block panelTitle %}Datos del Paciente{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Información Personal -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user"></i> Información Personal
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Nombre:</label>
                                <p class="form-control-plaintext">{{ cliente.nombre }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Apellido:</label>
                                <p class="form-control-plaintext">{{ cliente.apellido }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">DNI:</label>
                                <p class="form-control-plaintext">{{ cliente.dni }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Fecha de Nacimiento:</label>
                                <p class="form-control-plaintext">{{ cliente.fNacimiento ? cliente.fNacimiento|date('d/m/Y') : 'No especificada' }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Teléfono:</label>
                                <p class="form-control-plaintext">{{ cliente.telefono ?: 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Email:</label>
                                <p class="form-control-plaintext">{{ cliente.email ?: 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Dirección:</label>
                                <p class="form-control-plaintext">No especificada</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Médica -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-stethoscope"></i> Información Médica
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Historia Clínica:</label>
                                <p class="form-control-plaintext">{{ cliente.hClinica }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Modalidad:</label>
                                <p class="form-control-plaintext">
                                    {% if cliente.modalidad == 1 %}
                                        <span class="badge badge-success">Ambulatorio</span>
                                    {% elseif cliente.modalidad == 2 %}
                                        <span class="badge badge-primary">Internado</span>
                                    {% elseif cliente.modalidad == 3 %}
                                        <span class="badge badge-info">Kinesiología</span>
                                    {% else %}
                                        <span class="badge badge-secondary">No especificada</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Disponible para Terapia:</label>
                                <p class="form-control-plaintext">
                                    {% if cliente.disponibleParaTerapia %}
                                        <span class="badge badge-success">Sí</span>
                                    {% else %}
                                        <span class="badge badge-secondary">No</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Dieta:</label>
                                <p class="form-control-plaintext">{{ cliente.dieta ?: 'No especificada' }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Patología de Ingreso:</label>
                                <p class="form-control-plaintext">
                                    <span class="badge badge-warning" style="font-size: 1rem;">{{ motivoIngresoTexto }}</span>
                                </p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Patología Específica de Ingreso:</label>
                                <p class="form-control-plaintext">
                                    {% if cliente.motivoIngEspecifico %}
                                        <span class="badge badge-info" style="font-size: 1rem;">{{ cliente.motivoIngEspecifico }}</span>
                                    {% else %}
                                        <span class="text-muted">No especificado</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Doctores Referentes:</label>
                                <p class="form-control-plaintext">
                                    {% if doctoresReferentes is not empty %}
                                        {% for doctor in doctoresReferentes %}
                                            <span class="badge badge-secondary">{{ doctor.nombre }} {{ doctor.apellido }}</span>{% if not loop.last %} {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        <span class="text-muted">No asignados</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de Habitación -->
            {% if habitacion %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-bed"></i> Información de Habitación
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Habitación:</label>
                                <p class="form-control-plaintext">{{ habitacion.nombre }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Cama:</label>
                                <p class="form-control-plaintext">{{ cliente.nCama }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Habitación Privada:</label>
                                <p class="form-control-plaintext">
                                    {% if cliente.habPrivada %}
                                        <span class="badge badge-success">Sí</span>
                                    {% else %}
                                        <span class="badge badge-secondary">No</span>
                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                    {% endif %}

            <!-- Información de Obra Social -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-hospital"></i> Información de Obra Social
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Obra Social:</label>
                                <p class="form-control-plaintext">{{ cliente.obraSocial ? cliente.obraSocial.nombre : 'No especificada' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Número de Afiliado:</label>
                                <p class="form-control-plaintext">{{ cliente.obraSocialAfiliado ?: 'No especificado' }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Sistema de Emergencia:</label>
                                <p class="form-control-plaintext">{{ cliente.sistemaDeEmergenciaNombre ?: 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Número de Afiliado Emergencia:</label>
                                <p class="form-control-plaintext">{{ cliente.sistemaDeEmergenciaAfiliado ?: 'No especificado' }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Adicional -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Información Adicional
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Viene de:</label>
                                <p class="form-control-plaintext">{{ cliente.vieneDe ?: 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Profesional Derivante:</label>
                                <p class="form-control-plaintext">{{ cliente.docDerivante ?: 'No especificado' }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Posición en Archivo:</label>
                                <p class="form-control-plaintext">{{ cliente.posicionEnArchivo ?: 'No especificada' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Edad:</label>
                                <p class="form-control-plaintext">{{ cliente.edad ?: 'No especificada' }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fechas Importantes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar"></i> Fechas Importantes
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Fecha de Ingreso:</label>
                                <p class="form-control-plaintext">{{ cliente.fIngreso ? cliente.fIngreso|date('d/m/Y') : 'No especificada' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Fecha de Egreso:</label>
                                <p class="form-control-plaintext">{{ cliente.fEgreso ? cliente.fEgreso|date('d/m/Y') : 'No especificada' }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Vencimiento de Sesiones:</label>
                                <p class="form-control-plaintext">{{ cliente.vtoSesiones ? cliente.vtoSesiones|date('d/m/Y') : 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Sesiones Disponibles:</label>
                                <p class="form-control-plaintext">{{ cliente.sesionesDisp ?: 'No especificado' }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Familiares Responsables -->
            {% if familiarExtraActuales is not empty %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i> Familiares Responsables
                    </h5>
                </div>
                <div class="card-body">
                    {% for familiar in familiarExtraActuales %}
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Nombre:</label>
                                <p class="form-control-plaintext">{{ familiar.nombre }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Teléfono:</label>
                                <p class="form-control-plaintext">{{ familiar.telefono }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Email:</label>
                                <p class="form-control-plaintext">{{ familiar.email ?: 'No especificado' }}</p>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Vínculo:</label>
                                <p class="form-control-plaintext">{{ familiar.vinculo ?: 'No especificado' }}</p>
                            </div>
                        </div>
                    </div>
                    {% if not loop.last %}<hr>{% endif %}
                    {% endfor %}
                </div>
            </div>
                    {% endif %}

            <!-- Botones de Acción -->
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <a href="{{ path('cliente_edit', {'id': cliente.id}) }}" class="btn btn-primary">
                                <i class="fas fa-edit"></i> Editar Paciente
                            </a>
                            <a href="{{ path('cliente_historial', {'id': cliente.id}) }}" class="btn btn-info">
                                <i class="far fa-calendar-alt"></i> Historia Clínica
                            </a>
                            <a href="{{ path('cliente_index') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver a la Lista
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}