{% block titleButtons %}
    <div class="col-sm" style="align-items: center; justify-content: flex-end; display: flex;">
        <button class="btn btn-primary imprimirLocal" style="font-size: 14px; padding: 5px 10px; margin-left: 5px;" data-toggle="modal" data-target=".filtrosPlanillaLocal">
            <i class="fa fa-print"></i> Imprimir Resumen
        </button>
    </div>
    
    <!-- Modal local de impresión para histórico -->
    <div class="modal fade bd-example-modal-lg filtrosPlanillaLocal" tabindex="-1" role="dialog" aria-labelledby="filtros" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Resumen para imprimir</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>                <div class="modal-body">
                    <p>Seleccione los campos que desea incluir en el resumen:</p>
                    <div id="checkboxes">
                        <div class="form-check">
                            <input class="form-check-input check" type="checkbox" value="datos" id="datos" checked>
                            <label class="form-check-label" for="datos">
                                Datos del paciente
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input check" type="checkbox" value="estados" id="estados" checked>
                            <label class="form-check-label" for="estados">
                                Estados
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="todos" id="todos" checked>
                            <label class="form-check-label" for="todos">
                                <strong>Seleccionar todos</strong>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="updateLocal">Imprimir</button>
                    <button type="button" class="btn btn-success" id="descargarExcelLocal">Descargar Excel</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}