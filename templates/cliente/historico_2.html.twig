            placeholder_text_multiple: "Seleccione obras sociales..."
        });
        
        // Script para manejar el acordeón sin recargar la página
        $(document).ready(function() {
            // Prevenir que los botones del acordeón envíen el formulario
            $('#accordion .btn-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        });
        // Función para inicializar tooltips con configuración optimizada
        function initTooltips() {
            $('[data-toggle="tooltip"]').tooltip('dispose').tooltip({
                trigger: 'hover focus',
                placement: 'auto',
                html: true,
                container: 'body',
                boundary: 'window',
                delay: {show: 50, hide: 100},
                animation: true,
                sanitize: false
            });
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar tooltips
            initTooltips();
            
            // Botones de cambio de vista
            const tableViewBtn = document.getElementById('tableView');
            const calendarViewBtn = document.getElementById('calendarView');
            const summaryViewBtn = document.getElementById('summaryView');
            
            const tableViewContent = document.getElementById('tableViewContent');
            const calendarViewContent = document.getElementById('calendarViewContent');
            const summaryViewContent = document.getElementById('summaryViewContent');
              tableViewBtn.addEventListener('click', function() {
                tableViewContent.style.display = 'block';
                calendarViewContent.style.display = 'none';
                summaryViewContent.style.display = 'none';
                  tableViewBtn.classList.add('active');
                calendarViewBtn.classList.remove('active');
                summaryViewBtn.classList.remove('active');
                
                // Reinicializar tooltips con opciones mejoradas
                $('[data-toggle="tooltip"]').tooltip('dispose').tooltip({
                    trigger: 'hover',
                    placement: 'auto',
                    html: true,
                    container: 'body',
                    boundary: 'window',
                    delay: {show: 50, hide: 50}
                });
            });                calendarViewBtn.addEventListener('click', function() {
                tableViewContent.style.display = 'none';
                calendarViewContent.style.display = 'block';
                summaryViewContent.style.display = 'none';
                
                tableViewBtn.classList.remove('active');
                calendarViewBtn.classList.add('active');
                summaryViewBtn.classList.remove('active');
                
                // Reinicializar tooltips con opciones mejoradas
                $('[data-toggle="tooltip"]').tooltip('dispose').tooltip({
                    trigger: 'hover',
                    placement: 'auto',
                    html: true,
                    container: 'body',
                    boundary: 'window',
                    delay: {show: 50, hide: 50}
                });
            });
              summaryViewBtn.addEventListener('click', function() {
                tableViewContent.style.display = 'none';
                calendarViewContent.style.display = 'none';
                summaryViewContent.style.display = 'block';
                
                tableViewBtn.classList.remove('active');
                calendarViewBtn.classList.remove('active');
                summaryViewBtn.classList.add('active');
                
                // Reinicializar tooltips con opciones mejoradas
                $('[data-toggle="tooltip"]').tooltip('dispose').tooltip({
                    trigger: 'hover',
                    placement: 'auto',
                    html: true,
                    container: 'body',
                    boundary: 'window',
                    delay: {show: 50, hide: 50}
                });
                
                // Cargar gráficos solo cuando se muestra esta vista
                loadCharts();
            });
            
            // Toggle de filtros
            const filtersToggle = document.querySelector('.filters-toggle');
            const toggleIcon = filtersToggle.querySelector('.fa-chevron-up');
            
            filtersToggle.addEventListener('click', function() {
                if (toggleIcon.classList.contains('fa-chevron-up')) {
                    toggleIcon.classList.remove('fa-chevron-up');
                    toggleIcon.classList.add('fa-chevron-down');
                } else {
                    toggleIcon.classList.remove('fa-chevron-down');
                    toggleIcon.classList.add('fa-chevron-up');
                }
            });
            
            // Función para cargar los gráficos
            function loadCharts() {
                // Estado
                const estadoCtx = document.getElementById('estadoChart').getContext('2d');
                new Chart(estadoCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Internados', 'Ambulatorios', 'Derivados', 'Egresos', 'Sin Modalidad'],
                        datasets: [{
                            data: [
                                {{ internadosCount }},
                                {{ ambulatoriosCount }},
                                {{ derivadosCount }},
                                {{ egresosCount }},
                                {{ sinModalidadCount }}
                            ],
                            backgroundColor: [
                                'rgba(0, 123, 255, 0.7)',
                                'rgba(40, 167, 69, 0.7)',
                                'rgba(255, 193, 7, 0.7)',
                                'rgba(220, 53, 69, 0.7)',
                                'rgba(108, 117, 125, 0.7)'
                            ],
                            borderColor: [
                                'rgba(0, 123, 255, 1)',
                                'rgba(40, 167, 69, 1)',
                                'rgba(255, 193, 7, 1)',
                                'rgba(220, 53, 69, 1)',
                                'rgba(108, 117, 125, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        legend: { position: 'right' }
                    }
                });
                // Obra social
                const osLabels = [];
                const osData = [];
                {% for nombre, cantidad in osTotal %}
                    osLabels.push('{{ nombre }}');
                    osData.push({{ cantidad }});
                {% endfor %}
                const obraSocialCtx = document.getElementById('obraSocialChart').getContext('2d');
                new Chart(obraSocialCtx, {
                    type: 'doughnut',
                    data: {
                        labels: osLabels,
                        datasets: [{
                            data: osData,
                            backgroundColor: generateColors(osLabels.length, 0.7),
                            borderColor: generateColors(osLabels.length, 1),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        legend: { display: false }
                    }
                });
                // Referentes
                // Preparar datos de referentes ordenados por cantidad
                const refLabels = [];
                const refData = [];
                const refColors = [];
                
                // Crear una array temporal para ordenar
                let tempReferentes = [];
                {% for nombre, cantidad in totalReferentes %}
                    tempReferentes.push({ nombre: '{{ nombre }}', cantidad: {{ cantidad }} });
                {% endfor %}
                
                // Ordenar por cantidad descendente
                tempReferentes.sort((a, b) => b.cantidad - a.cantidad);
                
                // Generar colores para todos los fisiatras
                tempReferentes.forEach((ref, index) => {
                    refLabels.push(ref.nombre);
                    refData.push(ref.cantidad);
                    
                    // Generar colores variados para todos los fisiatras
                    refColors.push(generateColors(1, 0.7)[0]);
                });
                
                const referenteCtx = document.getElementById('referenteChart').getContext('2d');
                new Chart(referenteCtx, {
                    type: 'bar',
                    data: {
                        labels: refLabels,
                        datasets: [{
                            label: 'Pacientes',
                            data: refData,
                            backgroundColor: refColors,
                            borderColor: refColors.map(color => color.replace('0.5', '1').replace('0.8', '1')),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        scales: { yAxes: [{ ticks: { beginAtZero: true } }] },
                        legend: { display: false }
                    }
                });
                // Patologías
                var patLabels = [];
                var patData = [];
                {% for nombre, cantidad in patologiasCount %}
                    patLabels.push('{{ nombre }}');
                    patData.push({{ cantidad }});
                {% endfor %}
                const patCtx = document.getElementById('patologiaChart').getContext('2d');
                new Chart(patCtx, {
                    type: 'pie',
                    data: {
                        labels: patLabels,
                        datasets: [{
                            data: patData,
                            backgroundColor: ['#60b9b9', '#b088be', '#ffc107', '#dc3545', '#6c757d']
                        }]
                    },
                    options: { responsive: true, legend: { position: 'right' } }
                });
                // Edades
                var edadLabels = [];
                var edadData = [];
                {% for rango, cantidad in edadesRangos %}
                    edadLabels.push('{{ rango }}');
                    edadData.push({{ cantidad }});
                {% endfor %}
                const edadCtx = document.getElementById('edadChart').getContext('2d');
                new Chart(edadCtx, {
                    type: 'bar',
                    data: {
                        labels: edadLabels,
                        datasets: [{
                            label: 'Pacientes',
                            data: edadData,
                            backgroundColor: '#60b9b9'
                        }]
                    },
                    options: { responsive: true, legend: { display: false }, scales: { yAxes: [{ ticks: { beginAtZero: true } }] } }
                });
            }
            
            // Función para generar colores aleatorios
            function generateColors(count, alpha) {
                const colors = [];
                for (let i = 0; i < count; i++) {
                    const hue = i * (360 / count);
                    colors.push(`hsla(${hue}, 70%, 60%, ${alpha})`);
                }
                return colors;
            }
        }); // <-- Cierre correcto de document.addEventListener('DOMContentLoaded', ...)
    </script>
    <script>
// Función para imprimir el resumen desde el modal
$(document).ready(function() {
    // Configurar el evento del botón Imprimir
    $(document).on('click', '#updateLocal', function() {
        // Obtener checkboxes seleccionados
        let checkboxes = [];
        $('#checkboxes input:checked').each(function() {
            checkboxes.push($(this).val());
        });
        if (checkboxes.length < 1) {
            alert('Seleccione al menos un campo');
            return;
        }
        // Deshabilitar el botón y mostrar animación
        $('#updateLocal').prop('disabled', true);
        $('.modal-footer').html('<img src="/assets/images/loading.gif" style="max-height: 80px;">');
        // Crear HTML para imprimir
        let compactHtml = (typeof createCompactTableForPrint === 'function') ? createCompactTableForPrint(checkboxes) : '<div>Error: función de impresión no encontrada.</div>';
        let printWindow = window.open('', '_blank');
        if (!printWindow) {
            alert("Por favor, permita las ventanas emergentes para imprimir.");
            location.reload();
            return;
        }
        printWindow.document.write(compactHtml);
        printWindow.document.close();
        setTimeout(function() {
            try {
                printWindow.focus();
                printWindow.print();
                $('.filtrosPlanillaLocal').modal('hide');
                location.reload();
            } catch (e) {
                alert("Hubo un error al imprimir. Por favor, inténtelo de nuevo.");
                location.reload();
            }
        }, 1000);
    });
});
</script>
<script>
// Exportar los datos de pacientes con periodos (estructura para impresión)
window.pacientesPeriodosData = {% if pacientesPeriodos is defined %}{{ pacientesPeriodos|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}{% else %}[] // <-- ATENCIÓN: Debes pasar la variable pacientesPeriodos desde el controlador Symfony a Twig para que esto funcione correctamente. {% endif %};

// Exportar los valores calculados en el backend para que estén disponibles para otras funciones
window.sinFisiatraCount = {{ sinFisiatraCount is defined ? sinFisiatraCount : 'null' }};
window.totalDiasCama = {{ totalDiasCama is defined ? totalDiasCama : 'null' }};
window.totalPacientesUnicos = {{ totalPacientesUnicos is defined ? totalPacientesUnicos : 'null' }};
window.totalDiasAmbulatorio = {{ totalDiasAmbulatorio is defined ? totalDiasAmbulatorio : 'null' }};
window.sinFisiatraCountAmbulatorio = {{ sinFisiatraCountAmbulatorio is defined ? sinFisiatraCountAmbulatorio : 'null' }};
window.totalPacientesAmbulatorios = {{ totalPacientesAmbulatorios is defined ? totalPacientesAmbulatorios : 'null' }};

// Función para generar la tabla compacta para imprimir
function createCompactTableForPrint(checkboxes) {
    // Usar la estructura correcta
    const pacientes = window.pacientesPeriodosData;
    
    // Calcular el total de días cama
    let totalDiasCama = 0;
    if (pacientes && pacientes.length > 0) {
        pacientes.forEach(function(paciente) {
            if (paciente.periodos && paciente.periodos.length > 0) {
                paciente.periodos.forEach(function(periodo) {
                    totalDiasCama += periodo.dias ? parseInt(periodo.dias) : 0;
                });
            }
        });
    }
    
    let html = '';
    html += '<h2 style="text-align:center;">Histórico de Pacientes</h2>';
    html += '<p><strong>Informe resumido - Agrupado por períodos</strong></p>';
    html += '<p>Fecha de generación: {{ "now"|date("d/m/Y") }}</p>';
    html += '<p><strong>Total de Pacientes:</strong> ' + (pacientes ? pacientes.length : 0) + ' | <strong>Total de Días Cama:</strong> ' + totalDiasCama + '</p>';
    html += '<table border="1" cellpadding="6" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:1em;" class="compact-table">';
    html += '<thead><tr>';
    html += '<th>Paciente</th><th>HC</th><th>Estado</th><th>Periodo</th>';
    html += '</tr></thead><tbody>';
    if (pacientes && pacientes.length > 0) {
        pacientes.forEach(function(paciente) {
            if (!paciente.periodos || paciente.periodos.length === 0) return;
            paciente.periodos.forEach(function(periodo, idx) {
                html += '<tr>';
                if (idx === 0) {
                    html += '<td rowspan="' + paciente.periodos.length + '">' + (paciente.nombre || '') + '</td>';
                    html += '<td rowspan="' + paciente.periodos.length + '">' + (paciente.hc || '') + '</td>';
                }
                // Estado y detalles
                let estado = periodo.estado || '';
                if (periodo.habitacion) {
                    estado += '<br>H:' + periodo.habitacion;
                    if (periodo.cama) estado += ' C:' + periodo.cama;
                }
                if (periodo.profesional) {
                    estado += '<br>' + periodo.profesional;
                }
                if (periodo.obra_social) {
                    estado += '<br>' + periodo.obra_social;
                }
                html += '<td>' + estado + '</td>';
                // Periodo
                let desde = periodo.desde ? periodo.desde : '';
                let hasta = periodo.hasta ? periodo.hasta : '';
                let dias = periodo.dias ? periodo.dias : '';
                html += '<td>' + desde + ' al ' + hasta + (dias ? ' (' + dias + ' días)' : '') + '</td>';
                html += '</tr>';
            });
        });
    } else {
        html += '<tr><td colspan="4">No hay datos para mostrar.</td></tr>';
    }
    html += '</tbody></table>';
    return html;
}
</script>
<script>
$(document).ready(function () {
    // Ahora los cálculos vienen del backend, por lo que no necesitamos recalcular
    // Los valores ya están disponibles en las variables:
    // totalDiasCama, sinFisiatraCount, totalPacientesUnicos, totalReferentes
    
    // Actualizar los valores del dashboard
    if (window.totalPacientesUnicos !== null) {
        $('#totalPacientesDisplay').text(window.totalPacientesUnicos);
    }
    
    if (window.totalDiasCama !== null) {
        $('#totalDiasCamaDisplay').text(window.totalDiasCama);
        
        // Calcular y mostrar la ocupación promedio (días/paciente) - calculado con total de pacientes (internados y ambulatorios)
        const totalPacientes = (window.totalPacientesUnicos || 0) + (window.totalPacientesAmbulatorios || 0);
        if (totalPacientes > 0) {
            const totalDias = (window.totalDiasCama || 0) + (window.totalDiasAmbulatorio || 0);
            const ocupacionPromedio = (totalDias / totalPacientes).toFixed(2);
            $('#ocupacionPromedioDisplay').text(ocupacionPromedio);
        } else {
            $('#ocupacionPromedioDisplay').text('0');
        }
    }
    
    // Actualizar estadísticas de ambulatorios
    if (window.totalPacientesAmbulatorios !== null) {
        $('#totalPacientesAmbulatoriosDisplay').text(window.totalPacientesAmbulatorios);
    }
    
    // Mejorar la experiencia del selector múltiple de obra social
    $('#obraSocial').on('click', function(e) {
        e.stopPropagation();
    });
    
    // Agregar un botón para limpiar selección de obras sociales
    /*if ($('#obraSocial').next('.clear-selection-btn').length === 0) {
        $('<button type="button" class="btn btn-sm btn-outline-secondary clear-selection-btn mt-1 mb-2">Limpiar selección</button>')
            .insertAfter('#obraSocial')
            .on('click', function() {
                $('#obraSocial option:selected').prop('selected', false);
                actualizarFiltrosActivos();
            });
    }*/
    
    // Función para mostrar los filtros activos como badges
    function actualizarFiltrosActivos() {
        const $filtrosActivos = $('#filtros-activos');
        $filtrosActivos.empty();
        
        // Mostrar obras sociales seleccionadas
        const $obrasSociales = $('#obraSocial option:selected');
        if ($obrasSociales.length > 0) {
            const $obrasSocialesContainer = $('<div class="mb-2"><strong>Obras Sociales:</strong> </div>');
            
            $obrasSociales.each(function() {
                const $badge = $('<span class="badge badge-info mr-1 p-2"></span>').text($(this).text());
                $obrasSocialesContainer.append($badge);
            });
            
            $filtrosActivos.append($obrasSocialesContainer);
        }
        
        // Mostrar otros filtros activos (puedes expandir según sea necesario)
        const nombre = $('#nombre').val();
        if (nombre) {
            const $nombreContainer = $('<div class="mb-2"><strong>Nombre/Apellido:</strong> </div>');
            const $badge = $('<span class="badge badge-secondary mr-1 p-2"></span>').text(nombre);
            $nombreContainer.append($badge);
            $filtrosActivos.append($nombreContainer);
        }
        
        // Para profesionales
        const $profesional = $('#prof option:selected');
        if ($profesional.length > 0 && $profesional.val()) {
            const $profesionalContainer = $('<div class="mb-2"><strong>Profesional:</strong> </div>');
            const $badge = $('<span class="badge badge-primary mr-1 p-2"></span>').text($profesional.text());
            $profesionalContainer.append($badge);
            $filtrosActivos.append($profesionalContainer);
        }
    }
    
    // Actualizar filtros cuando cambien los selects
    $('#obraSocial, #prof').on('change', actualizarFiltrosActivos);
    $('#nombre').on('input', actualizarFiltrosActivos);
    
    // Inicializar filtros activos al cargar la página
    actualizarFiltrosActivos();

    // Inicializar el cálculo cuando la página se carga
    setTimeout(function() {
        calcularTotalDiasCama();
    }, 500);
});
</script>
