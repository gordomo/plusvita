        $('.abrir').click(function (e) {
            e.preventDefault();
            let seccion = $(this).data('seccion');
            if($(this).data('toogle') === 'cerrado') {
                $('#'+seccion).collapse('show');
                $(this).data('toogle', 'abierto');
                $(this).html('<i class="fas fa-chevron-up"></i>');
            } else {
                $('#'+seccion).collapse('hide');
                $(this).data('toogle', 'cerrado');
                $(this).html('<i class="fas fa-chevron-down"></i>');
            }
        });

        $("#imprimirLocal").on('click', function () {
            $('.filtrosPlanillaLocal').modal('show');
        });

        $("#updateLocal").on('click', function (e) {
            e.preventDefault(); // Prevenir comportamiento por defecto
            $("#updateLocal").prop('disabled', true);
            $(".modal-footer").html('<img src="{{ asset('assets/images/loading.gif') }}" style="max-height: 80px;">');
            let checkboxes = GetSelected('checkboxes');
            if (checkboxes.length < 1) {
                alert('seleccione al menos un campo');
                $("#updateLocal").prop('disabled', false);
                $(".modal-footer").html('<button type="button" class="btn btn-primary" id="updateLocal">Imprimir</button>');
            } else {
                console.log('Imprimiendo secciones:', checkboxes); // Agregar log para debug
                let secciones = ['historia-al-ingreso', 'notas', 'notas-en-turnos', 'evoluciones-imprimir', 'novedades-imprimir', 'indicaciones-imprimir', 'epicrisis-al-alta'];

                secciones.forEach((seccion) => {
                    if (!checkboxes.includes(seccion)) {
                        $('.'+seccion).remove();
                    } else {
                        $('.'+seccion).find('.btn.btn-link.abrir .fas.fa-chevron-down').click();
                    }
                });

                $('body').find('.container-fluid').find('a').remove();
                $('body').find('.container-fluid').find('button').remove();
                $('body').find('.remover').remove();
                $('.modal').remove();
                setTimeout(() => {
                    let tables = $('body').find('.container-fluid').find('.table-wrapper-scroll-y');
                    tables.removeClass('table-wrapper-scroll-y');
                    let headers = $('#head').parent().parent();
                    headers.addClass('repetedHeader');
                    let newHeader = '<header><div class="row"><div class="col-sm-8"><img style="max-width:200px; float:right;" src="{{ absolute_url(asset('assets/images/plusVitaLogo.png')) }}"><div style="font-size:12px">' + $('#head').html() + '</div></div>';

                    newHeader += '<div class="row" style="font-size:10px">' + $('.tituloHistoria').html() + '</div></header>';
                    headers.remove();
                    $('#logos').remove();
                    $('.tituloHistoria').remove();

                    setTimeout(() => {
                        let html = "<head><title>Historia</title><style>@media print {@page {margin-top: 10px;}@media print {-webkit-print-color-adjust: exact;}.table.table-responsive.table-striped th{text-align: left;}.table.table-responsive.table-striped td{text-align: left;padding-bottom: 15px;}.h4, h4 {font-size: 1.5rem;border-top: 1px solid;padding-top: 10px;}body {font-family: '-apple-system','BlinkMacSystemFont','Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans',sans-serif,'Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol','Noto Color Emoji'};table.report-container {page-break-after:always;text-align: left}thead.report-header {display:table-header-group;text-align: left;}tfoot.report-footer {display:table-footer-group;table.report-container div.article {page-break-inside: avoid;}} </style></head>";
                        $('body').find('.container-fluid').find('.buttons').remove();
                        html += '<table class="report-container">';
                        html += '<thead class="report-header">' +
                                    '<tr>' +
                                        '<th class="report-header-cell">' +
                                            '<div class="header-info">' +
                                                newHeader +
                            '               </div>' +
                                        '</th>' +
                                    '</tr>' +
                                '</thead>';
                        html += '<tfoot class="report-footer">' +
                                    '<tr>' +
                                        '<td class="report-footer-cell">' +
                                            '<div class="footer-info" id="pageFooter"></div>' +
                                        '</td>' +
                                    '</tr>' +
                                '</tfoot>';
                        html += '<tbody class="report-content">' +
                                    '<tr>' +
                                        '<td class="report-content-cell">' +
                                            '<div class="main">' +
                                                $('body').find('.container-fluid').html() +
                                            '</div>' +
                                        '</td>' +
                                    '</tr>' +
                                '</tbody></table>';
                        
                        try {
                            imprimirElemento(html);
                        } catch (error) {
                            console.error('Error al imprimir:', error);
                            alert('Ha ocurrido un error al intentar imprimir');
                        }
                        
                        location.reload();
                    }, 2000);
                }, 1000);
            }
        });

        $('#filtrarPorTipo').chosen();

        $( document ).ready(function () {
            var editor = CKEDITOR.instances['epicrisisAlAlta'];

            editor.on( 'required', function( evt ) {
                editor.showNotification( 'La epicrisis no puede estar vacía.', 'warning' );
                evt.cancel();
            } );
        });


