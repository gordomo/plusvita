                                                {% if historia.cama != historiaPaciente[key - 1].cama %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">cama:</b>
                                                    de
                                                    <b class="text-capitalize">{{ (historiaPaciente[key - 1].cama) ? historiaPaciente[key - 1].cama : 'ninguna' }}</b>
                                                    a
