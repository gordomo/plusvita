                                                    a
                                                    <b class="text-capitalize">{{ historia.fechaReingresoDerivacion is not empty ? historia.fechaReingresoDerivacion | date('d/m/Y') : 'Vacio' }}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.motivoDerivacion != historiaPaciente[key - 1].motivoDerivacion %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Motivo de Derivacion:</b>
                                                    <b class="text-capitalize">{{ historia.motivoDerivacion }}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.derivadoEn != historiaPaciente[key - 1].derivadoEn %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Derivado En:</b>
                                                    <b class="text-capitalize">{{ historia.derivadoEn }}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.empresaTransporteDerivacion != historiaPaciente[key - 1].empresaTransporteDerivacion %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Empresa de Transporte de Derivacion:</b>
                                                    <b class="text-capitalize">{{ historia.empresaTransporteDerivacion }}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.fechaAltaPorPermiso != historiaPaciente[key - 1].fechaAltaPorPermiso %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Fecha de Alta Por Permiso:</b>
                                                    de
                                                    <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaAltaPorPermiso is not empty ? historiaPaciente[key - 1].fechaAltaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                                    a
                                                    <b class="text-capitalize">{{ historia.fechaAltaPorPermiso is not empty ? historia.fechaAltaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.fechaBajaPorPermiso != historiaPaciente[key - 1].fechaBajaPorPermiso %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Fecha de Baja Por Permiso:</b>
                                                    de
                                                    <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaBajaPorPermiso is not empty ? historiaPaciente[key - 1].fechaBajaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                                    a
                                                    <b class="text-capitalize">{{ historia.fechaBajaPorPermiso is not empty ? historia.fechaBajaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.dePermiso != historiaPaciente[key - 1].dePermiso %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">De Permiso:</b>
                                                    de
                                                    <b class="text-capitalize">{{ historiaPaciente[key - 1].dePermiso is empty or historiaPaciente[key - 1].dePermiso == 0 ? 'no' : 'si' }}</b>
                                                    a
                                                    <b class="text-capitalize">{{ historia.dePermiso is empty or historia.dePermiso == 0 ? 'no' : 'si'}}</b>
                                                    <br>
                                                {% endif %}
                                                {% if historia.ambulatorio != historiaPaciente[key - 1].ambulatorio %}
                                                    {% set cambio = 1 %}
                                                    <b class="text-capitalize">Ambulatorio:</b>
                                                    de
                                                    <b class="text-capitalize">{{ historiaPaciente[key - 1].ambulatorio is empty or historiaPaciente[key - 1].ambulatorio == 0 ? 'no' : 'si' }}</b>
                                                    a
                                                    <b class="text-capitalize">{{ historia.ambulatorio is empty or historia.ambulatorio == 0 ? 'no' : 'si'}}</b>
                                                    <br>
                                                {% endif %}
                                                {% if cambio == 0 %}
                                                    <b class="text-capitalize">No se registraron cambios</b>
                                                {% endif %}
                                                {% if historia.docReferente != historiaPaciente[key - 1].docReferente %}
                                                    {% set cambio = 1 %}
                                                    {% set docsReferenteAnterior = historiaPaciente[key - 1].docReferente %}
                                                    
                                                    {% set docReferenteAnteriorNombre = '' %}
                                                    {% set docReferenteNombre = '' %}

                                                    {% for docId in docsReferenteAnterior %}
                                                        {% set doc = userRepository.find(docId) %}
                                                        {% set docReferenteAnteriorNombre = (docId) ? docReferenteAnteriorNombre ~ ' ' ~ doc.getNombre() ~ ' ' ~ doc.getApellido() : 'sin referente'%}
                                                    {% endfor %}

                                                    {% set docsReferente = historia.docReferenteArray %}
                                                    {% for docId in docsReferente %}
                                                        {% set doc = userRepository.find(docId) %}
                                                        {% set docReferenteNombre = (docId) ? docReferenteNombre ~ ' ' ~ doc.getNombre() ~ ' ' ~ doc.getApellido() : 'sin referente'%}
                                                    {% endfor %}

                                                    {% set docReferenteAnteriorNombre = docReferenteAnteriorNombre ? docReferenteAnteriorNombre : 'sin referente' %}
                                                    {% set docReferenteNombre = docReferenteNombre ? docReferenteNombre : 'sin referente' %}
                                                    
                                                    <b class="text-capitalize">Doc Referente:</b>
                                                    de
                                                    <b class="text-capitalize">{{ docReferenteAnteriorNombre }}</b>
                                                    a
                                                    <b class="text-capitalize">{{ docReferenteNombre }}</b>
                                                    <br>
                                                {% endif %}
                                                {% if cambio == 0 %}
                                                    <b class="text-capitalize">No se registraron cambios</b>
                                                {% endif %}
                                            </td>
                                        {% else %}
                                            <td>{{ historia.fecha ? historia.fecha|date('d/m/Y') : ''}}</td>
                                            <td>
                                                <b class="text-capitalize">
                                                    Primer Registro - modalidad:
                                                    {% if(historia.modalidad == 1) %}
                                                        Ambulatorio
                                                    {% elseif(historia.modalidad == 2) %}
                                                        Internacion
                                                    {% elseif(historia.modalidad == 3) %}
                                                        Hospital de día
                                                    {% elseif(historia.modalidad == 4) %}
                                                        ART
                                                    {% endif %}
                                                </b>
                                            </td>
                                        {% endif %}
                                        <td class="lowercase">{{ historia.usuario }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="15">No existen registros</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            No existen registros
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Sección de Indicaciones Médicas -->
        <div id="accordion" style="width: 100%;" class="indicaciones-imprimir">
            <div class="col-12 mb-4 history-col-12" id="indicacionesScroll">
                <div class="col-lg-2 col-sm-12 col-md-2">
                    <h4>Indicaciones Médicas</h4>
                </div>
                <div class="col-lg-1 col-sm-12 col-md-1">
                    <a href class="btn btn-link abrir" aria-expanded="true" aria-controls="collapseOne" data-toogle="cerrado" data-seccion="indicaciones-section">
                        <i class="fas fa-chevron-down"></i>
                    </a>
                </div>
                <div class="col-lg-9 col-sm-12 col-md-9">
                    <div class="text-right">
                        <a href="{{ path('cardex_paciente', {'id': cliente.id}) }}" class="btn btn-info">
                            <i class="fas fa-clipboard-list"></i> Ver Cardex Completo
                        </a>
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_DOCTOR') %}
                            <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Nueva Indicación
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-12">
                    <div id="indicaciones-section" class="collapse {% if section == 'indicaciones' %} show {% endif %}" aria-labelledby="headingOne" data-parent="#accordion">
                        <div class="indicaciones-resumen-container">
                            <!-- Indicaciones Activas -->
                            <h5 class="mt-3 mb-3">Indicaciones Médicas Actuales</h5>
                            
                            {% if indicacionesRecientes is defined and indicacionesRecientes|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th style="width: 12%">Fecha</th>
                                                <th style="width: 25%">Medicamento</th>
                                                <th>Indicación/Dosis</th>
                                                <th style="width: 20%">Profesional</th>
                                                <th style="width: 10%">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for indicacion in indicacionesRecientes %}
                                                <tr>
                                                    <td>
                                                        <strong>{{ indicacion.fecha|date('d/m/Y') }}</strong>
                                                        <div class="small text-muted">
                                                            {{ mesesNombres[indicacion.mes] }} {{ indicacion.year }}
                                                        </div>
                                                    </td>
                                                    <td>
                                                        {% if indicacion.tipoIndicacion is defined and indicacion.tipoIndicacion %}
                                                            <div class="badge badge-info mb-1">{{ indicacion.tipoIndicacion|capitalize }}</div>
                                                        {% endif %}
                                                        
                                                        {% if indicacion.consumibleNombre is defined and indicacion.consumibleNombre %}
                                                            <div class="font-weight-bold">{{ indicacion.consumibleNombre }}</div>
                                                            {% if indicacion.unidadMedida is defined and indicacion.unidadMedida %}
                                                                <div class="small text-muted">{{ indicacion.cantidad }} {{ indicacion.unidadMedida }}</div>
                                                            {% elseif indicacion.unidades is defined and indicacion.unidades %}
                                                                <div class="small text-muted">{{ indicacion.unidades }}</div>
                                                            {% endif %}
                                                            
                                                            {% if indicacion.viaAdministracion is defined and indicacion.viaAdministracion %}
                                                                <div class="small">
                                                                    <span class="font-weight-bold">Vía:</span> {{ indicacion.viaAdministracion|capitalize }}
                                                                </div>
                                                            {% endif %}
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if indicacion.notas is defined and indicacion.notas %}
                                                            <div class="indicacion-notas">{{ indicacion.notas|nl2br }}</div>
                                                        {% endif %}
                                                        
                                                        <div class="d-flex flex-wrap justify-content-between">
                                                            <div class="mr-2">
                                                                <span class="font-weight-bold">Cantidad:</span> {{ indicacion.cantidad is defined ? indicacion.cantidad : '1' }}
                                                            </div>
                                                            
                                                            {% if indicacion.frecuencia is defined and indicacion.frecuencia %}
                                                                <div>
                                                                    <span class="font-weight-bold">Frecuencia:</span> 
                                                                    {{ indicacion.frecuencia|capitalize }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        
                                                        {% if indicacion.duracion is defined and indicacion.duracion %}
                                                            <div>
                                                                <span class="font-weight-bold">Duración:</span> 
                                                                {{ indicacion.duracion }}
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-user-md mr-1"></i>
                                                            {% if indicacion.doctorNombre is defined and indicacion.doctorNombre and indicacion.doctorApellido is defined and indicacion.doctorApellido %}
                                                                {{ indicacion.doctorNombre }} {{ indicacion.doctorApellido }}
                                                            {% else %}
                                                                Usuario del sistema
                                                            {% endif %}
                                                        </div>
                                                    </td>
                                                    <td>
                                                        {% if indicacion.activo is defined and indicacion.activo %}
                                                            <span class="badge badge-success">Activa</span>
                                                        {% elseif indicacion.activo is defined and not indicacion.activo %}
                                                            <span class="badge badge-secondary">Suspendida</span>
                                                        {% else %}
                                                            <span class="badge badge-info">Registrada</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                
                                {% if ultimaIndicacion is defined and ultimaIndicacion %}
                                <div class="card mt-4 border-info">
                                    <div class="card-header bg-info text-white">
                                        <h6 class="mb-0 d-flex justify-content-between align-items-center">
                                            <span><i class="fas fa-star mr-2"></i> Última indicación médica</span>
                                            <span class="badge badge-light">{{ ultimaIndicacion.fecha|date('d/m/Y H:i') }}</span>
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                {% if ultimaIndicacion.tipoIndicacion is defined and ultimaIndicacion.tipoIndicacion %}
                                                    <div class="mb-2">
                                                        <strong class="text-muted">Tipo:</strong>
                                                        <span class="badge badge-info">{{ ultimaIndicacion.tipoIndicacion|capitalize }}</span>
                                                    </div>
                                                {% endif %}
                                                
                                                <div class="mb-2">
                                                    <strong class="text-muted">{% if ultimaIndicacion.tipoIndicacion is defined and ultimaIndicacion.tipoIndicacion == 'medicamento' %}Medicamento:{% else %}Descripción:{% endif %}</strong><br>
                                                    <span class="h5">{{ ultimaIndicacion.consumibleNombre }}</span>
                                                </div>
                                                
                                                <div class="mb-2">
                                                    <strong class="text-muted">Cantidad:</strong><br>
                                                    {{ ultimaIndicacion.cantidad }} {% if ultimaIndicacion.unidades is defined and ultimaIndicacion.unidades %}<small>({{ ultimaIndicacion.unidades }})</small>{% endif %}
                                                </div>
                                                
                                                {% if ultimaIndicacion.viaAdministracion is defined and ultimaIndicacion.viaAdministracion %}
                                                    <div class="mb-2">
                                                        <strong class="text-muted">Vía de administración:</strong><br>
                                                        {{ ultimaIndicacion.viaAdministracion|capitalize }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="col-md-6">
                                                {% if ultimaIndicacion.frecuencia is defined and ultimaIndicacion.frecuencia %}
                                                    <div class="mb-2">
                                                        <strong class="text-muted">Frecuencia:</strong><br>
                                                        {{ ultimaIndicacion.frecuencia|capitalize }}
                                                    </div>
                                                {% endif %}
                                                
                                                {% if ultimaIndicacion.duracion is defined and ultimaIndicacion.duracion %}
                                                    <div class="mb-2">
                                                        <strong class="text-muted">Duración:</strong><br>
                                                        {{ ultimaIndicacion.duracion }}
                                                    </div>
                                                {% endif %}
                                                
                                                <div class="mb-2">
                                                    <strong class="text-muted">Indicado por:</strong><br>
                                                    {% if ultimaIndicacion.doctorNombre is defined and ultimaIndicacion.doctorNombre and ultimaIndicacion.doctorApellido is defined and ultimaIndicacion.doctorApellido %}
                                                        {{ ultimaIndicacion.doctorNombre }} {{ ultimaIndicacion.doctorApellido }}
                                                    {% else %}
                                                        Usuario del sistema
                                                    {% endif %}
                                                </div>
                                                
                                                {% if ultimaIndicacion.notas is defined and ultimaIndicacion.notas %}
                                                <div class="mb-2">
                                                    <strong class="text-muted">Notas:</strong><br>
                                                    {{ ultimaIndicacion.notas|nl2br }}
                                                </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                            {% else %}
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle mr-2"></i>
                                    No hay indicaciones actuales registradas para este paciente. 
                                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_DOCTOR') %}
                                    <p class="mb-0 mt-2">Puedes agregar una nueva indicación usando el botón "Nueva Indicación".</p>
                                    {% endif %}
                                </div>
                            {% endif %}
                            
                            {# Botón de "Nueva Indicación" eliminado de aquí para evitar duplicación.
                               Ya existe un botón similar en el encabezado de la sección. #}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-12 mb-4 history-col-12 epicrisis-al-alta" >
            {% if historiaEgreso is not empty %}
                <div class="col-4">
                    <h4>Epicrisis al Alta</h4>
                </div>
                <div class="col-8">

                </div>
                <div class="col-12">
                    <table class="table table-responsive table-wrapper-scroll-y my-custom-scrollbar" >
                        <tbody>
                        {% for hist in historiaEgreso %}
                            <tr style="background-color: #dee2e6">
                                <td>{{ hist.fecha ? hist.fecha|date('d/m/Y') : ''}}</td>
                            </tr>
                            <tr>
                                <td>{{ hist.epicrisisAlta | raw }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    <a class="btn btn-default" href="javascript:history.back();">volver</a>
{% endblock %}

