{% extends 'base.html.twig' %}

{% block title %}Historico{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            .printable, .printable * {
                visibility: visible;
            }
            .printable {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .no-print, .no-print * {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            tr.novedades-section {
                display: table-row !important;
            }
            
            /* Ajustes para mejorar la impresión en formato paisaje */
            @page {
                size: landscape;
                margin: 10mm;
            }
            
            table.table {
                font-size: 11px !important;
                width: 100% !important;
                table-layout: fixed !important;
            }
            
            /* Ajustar anchos de columnas para que quepan en la página */
            table.table th, table.table td {
                padding: 2px !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: normal !important;
                word-break: break-word !important;
            }
        }
        
        /* Estilos para el resumen (compacto) */
        .summary-mode .no-changes {
            display: none !important;
        }
        
        /* Botones de impresión y exportación */
        .print-export-buttons {
            margin-top: 10px;
        }
        .print-export-buttons button {
            margin-right: 10px;
        }
        
        /* Estilo para el botón de PDF */
        .btn-pdf {
            background-color: #dc3545;
            color: white;
        }
        
        /* Estilo para el botón de Excel */
        .btn-excel {
            background-color: #28a745;
            color: white;
        }
        
        /* Estilo para el botón de impresión condensada */
        .btn-print-summary {
            background-color: #007bff;
            color: white;
        }
    </style>
{% endblock %}
{% block panelTitle %}Historico{% endblock %}
{% block body %}
    <form>
        <div class="row">
            <div class="col">
                <label for="from">Desde</label>
                <input class="form-control" type="date" id="from" name="from" value="{{ from }}">
            </div>
            <div class="col">
                <label for="to">Hasta</label>
                <input class="form-control" type="date" id="to" name="to" value="{{ to }}">
            </div>
            <div class="col">
                <label for="modalidad">Estado</label>
                <select class="form-control" name="modalidad">
                    <option value="0">Todos</option>
                    <option value="2" {{ modalidad == 2 ? 'selected' : '' }}>Internados</option>
                    <option value="1" {{ modalidad == 1 ? 'selected' : '' }}>Ambulatorios</option>
                </select>
            </div>
            <div class="col">
                <label for="nombre">Nombre / Apellido</label>
                <input class="form-control" type="text" id="nombre" name="nombre" value="{{ nombre }}">
            </div>
            <div class="col">
                <label for="obraSocial">O. Social</label>
                <select class="form-control" name="obraSocial">
                    <option value="">Seleccione una O. Social</option>
                    {% for idObra, obra in obraSociales %}
                        <option {{ obraSocial == idObra ? 'selected' : '' }} value="{{ idObra }}">{{ obra }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-5">
                <label for="prof">Profesional</label>
                <select class="form-control" name="prof">
                    <option value="">Seleccione un Profesional</option>
                    {% for profesional in profesionales %}
                        <option class="text-uppercase" {{ prof == profesional.id ? 'selected' : '' }} value="{{ profesional.id }}">{{ profesional.apellido }} {{ profesional.nombre }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-2">
                <label for="vto">Vto. Autorizaciones</label>
                <input class="form-control" type="date" id="vto" name="vto" value="{{ vto }}">
            </div>
            <div class="col-2">
                <label for="vto">Resultados por Página</label>
                <select class="form-control" name="limit" id="limit">
                    <option value="10" {% if (limit == 10) %} selected {% endif %}>10</option>
                    <option value="50" {% if (limit == 50) %} selected {% endif %}>50</option>
                    <option value="100" {% if (limit == 100) %} selected {% endif %}>100</option>
                    <option value="200" {% if (limit == 200) %} selected {% endif %}>200</option>
                    <option value="100000000000000" {% if (limit == 100000000000000) %} selected {% endif %}>Todos</option>

                </select>
            </div>
            <div class="col-2">
                <label for="vto">H. C.</label>
                <input class="form-control" type="text" id="hc" autocomplete="off" name="hc" value="{{ hc }}">
            </div>
        </div>
        <div class="row mt-4">
            <div class="col">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a href="{{ path('cliente_historicos') }}" class="btn btn-action">Limpiar</a>
                
                <!-- Nuevos botones para impresión y exportación -->
                <div class="print-export-buttons d-inline-block ml-4">
                    <button type="button" class="btn btn-print-summary" id="btnPrintSummary">
                        <i class="fas fa-print"></i> Imprimir Resumen
                    </button>
                    <button type="button" class="btn btn-pdf" id="btnExportPDF">
                        <i class="fas fa-file-pdf"></i> Exportar PDF
                    </button>
                    <button type="button" class="btn btn-excel" id="btnExportExcel">
                        <i class="fas fa-file-excel"></i> Exportar Excel
                    </button>
                </div>
            </div>
            <div class="col">
                <h5>Total: <span class="badge badge-secondary">{{ total }}</span></h5>
            </div>
        </div>
    </form>
    <div class="printable">
        <div class="row mt-4">
            <table class="table">
                <thead>
                    <tr>
                        <th colspan="10">
                            {% if maxPages > 1 %}
                            <nav aria-label="Page navigation example">
                                <ul class="pagination">
                                    {%if thisPage > 1 %}
                                        <li class="page-item" >
                                            <a class="page-link" href="{{ path('cliente_historicos', {currentPage: (thisPage-1 < 1 ? 1 : thisPage-1),
                                                                            from: ((from) ? from : ''), 
                                                                            to: ((to) ? to : ''), 
                                                                            vto: ((vto) ? vto : ''), 
                                                                            nombre: ((nombre) ? nombre : ''), 
                                                                            estado: ((estado) ? estado : ''), 
                                                                            obraSocial: ((obraSocial) ? obraSocial : ''), 
                                                                            prof: ((prof) ? prof : ''), 
                                                                            modalidad: ((modalidad) ? modalidad : ''), 
                                                                            hab: ((hab) ? hab : ''), 
                                                                            hc: ((hc) ? hc : ''), 
                                            }) }}">«</a>
                                        </li>
                                    {% endif %}

                                    {# Render each page number #}
                                    {% for i in 1..maxPages %}
                                        <li class="page-item {% if thisPage == i %}active{% endif %}">
                                            <a class="page-link" href="{{ path('cliente_historicos', {
                                                                            currentPage: i, 
                                                                            from: ((from) ? from : ''), 
                                                                            to: ((to) ? to : ''), 
                                                                            vto: ((vto) ? vto : ''), 
                                                                            nombre: ((nombre) ? nombre : ''), 
                                                                            estado: ((estado) ? estado : ''), 
                                                                            obraSocial: ((obraSocial) ? obraSocial : ''), 
                                                                            prof: ((prof) ? prof : ''), 
                                                                            modalidad: ((modalidad) ? modalidad : ''), 
                                                                            hab: ((hab) ? hab : ''), 
                                                                            hc: ((hc) ? hc : ''), 
                                                }) 
                                            }}">
                                                {{ i }}
                                            </a>
                                        </li>
                                    {% endfor %}

                                    {# `»` arrow #}
                                    {%if thisPage < maxPages %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('cliente_historicos', {currentPage: (thisPage+1 <= maxPages ? thisPage+1 : thisPage),
                                                                                                    from: ((from) ? from : ''), 
                                                                                                    to: ((to) ? to : ''), 
                                                                                                    vto: ((vto) ? vto : ''), 
                                                                                                    nombre: ((nombre) ? nombre : ''), 
                                                                                                    estado: ((estado) ? estado : ''), 
                                                                                                    obraSocial: ((obraSocial) ? obraSocial : ''), 
                                                                                                    prof: ((prof) ? prof : ''), 
                                                                                                    modalidad: ((modalidad) ? modalidad : ''), 
                                                                                                    hab: ((hab) ? hab : ''), 
                                                                                                    hc: ((hc) ? hc : ''), 
                                            }) }}">»</a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </nav>
                            {% endif %}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for cliente, historiaPaciente in historiasArray %}
                        <tr class="cliente-tr">
                            <td class="text-capitalize datos" >
                                H.C.: {{ historiaPaciente[0].cliente.hClinica }}
                            </td>
                            <td class="text-capitalize datos">
                                {% if prof is defined %}
                                    <a class="" href="{{ path('evolucion_index', {'cliente': historiaPaciente[0].cliente.id, 'prof': prof}) }}">
                                        {{ cliente }}
                                    </a>
                                {% else %}
                                    <a class="" href="{{ path('evolucion_index', {'cliente': historiaPaciente[0].cliente.id}) }}">
                                        {{ cliente }}
                                    </a>
                                {% endif %}
                            </td>
                            <td class="datos">
                            {% set last = historiaPaciente|last %}
                            {% if last.fechaIngreso is not null %}
                                Ingreso: {{ last.fechaIngreso | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.cliente.vtoSesiones is not null %}
                                Vto Sesiones: {{ last.cliente.vtoSesiones | date('d/m/Y')}}
                            
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.fechaDerivacion is not null %}
                                Derivacion: {{ last.fechaDerivacion | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.fechaReingresoDerivacion is not null %}
                                R. Derivacion: {{ last.fechaReingresoDerivacion | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.fechaBajaPorPermiso is not null %}
                                Baja Por Permiso: {{ last.fechaBajaPorPermiso | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.fechaAltaPorPermiso is not null %}
                                Alta Por Permiso: {{ last.fechaAltaPorPermiso | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            {% if last.fechaEngreso is not null %}
                                Egreso: {{ last.fechaEngreso | date('d/m/Y')}}
                            {% endif %}
                            </td>
                            <td class="datos">
                            Doc Referente:<b>
                                {% set historia = historiaPaciente | last %}
                                {% for profesional in profesionales %}
                                    {% if profesional.id in historia.docReferente %}
                                        {{ profesional.nombre }} {{ profesional.apellido }}
                                    {% endif %}
                                    {% endfor %}
                                {% if historia.docReferente | length == 0 %}
                                    Ninguno
                                {% endif %}
                                </b>

                                <a href class="btn btn-link abrir" aria-expanded="true" aria-controls="collapseOne" data-toogle="cerrado" data-seccion="novedades-section-{{historiaPaciente[0].cliente.id}}">
                                    <i class="fas fa-chevron-down"></i>
                                </a>
                            </td>
                        </tr>
                        <tr class="novedades-section-{{historiaPaciente[0].cliente.id}}" style="display:none">
                            <th>Fecha</th>
                            <th colspan="8">Novedad</th>
                            <th>Usuario</th>
                        </tr>
                        
                        {% for key, historia in historiaPaciente %}
                            <tr class="novedades-section-{{historiaPaciente[0].cliente.id}}" style="display:none">
                                {% if key > 0 %}
                                    {% set cambio = 0 %}
                                    <td class="novedades">{{ historia.fecha ? historia.fecha|date('d/m/Y') : ''}}</td>
                                    <td colspan="8" class="lowercase">
                                        {% if historia.modalidad != historiaPaciente[key - 1].modalidad %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">modalidad:</b> de <b class="text-capitalize">
                                            {% if(historiaPaciente[key - 1].modalidad == 1) %}
                                                Ambulatorio
                                            {% elseif(historiaPaciente[key - 1].modalidad == 2) %}
                                                Internacion
                                            {% elseif(historiaPaciente[key - 1].modalidad == 3) %}
                                                Hospital de día
                                            {% elseif(historiaPaciente[key - 1].modalidad == 4) %}
                                                ART
                                            {% endif %}
                                        </b>
                                            a
                                            <b class="text-capitalize">
                                                {% if(historia.modalidad == 1) %}
                                                    Ambulatorio
                                                {% elseif(historia.modalidad == 2) %}
                                                    Internacion
                                                {% elseif(historia.modalidad == 3) %}
                                                    Hospital de día
                                                {% elseif(historia.modalidad == 4) %}
                                                    ART
                                                {% endif %}
                                            </b>
                                            <br>
                                        {% endif %}
                                        {% if historia.patologia != historiaPaciente[key - 1].patologia %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Patología:</b> de
                                            <b class="text-capitalize">
                                                {% if(historia.patologia == 1) %}
                                                    Neurologicas
                                                {% elseif(historia.patologia == 2) %}
                                                    Traumatológicas
                                                {% elseif(historia.patologia == 3) %}
                                                    Respiratorias
                                                {% elseif(historia.patologia == 4) %}
                                                    Paliativos
                                                {% elseif(historia.patologia == 4) %}
                                                    Patologías laborales
                                                {% endif %}
                                            </b>
                                            a
                                            <b class="text-capitalize">
                                                {% if(historiaPaciente[key - 1].patologia == 1) %}
                                                    Neurologicas
                                                {% elseif(historiaPaciente[key - 1].patologia == 2) %}
                                                    Traumatológicas
                                                {% elseif(historiaPaciente[key - 1].patologia == 3) %}
                                                    Respiratorias
                                                {% elseif(historiaPaciente[key - 1].patologia == 4) %}
                                                    Paliativos
                                                {% elseif(historiaPaciente[key - 1].patologia == 4) %}
                                                    Patologías laborales
                                                {% endif %}
                                            </b>
                                            <br>
                                        {% endif %}
                                        {% if historia.patologiaEspecifica != historiaPaciente[key - 1].patologiaEspecifica %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Patologia Especifica:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].patologiaEspecifica }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.patologiaEspecifica }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.obraSocial != historiaPaciente[key - 1].obraSocial %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Obra Social:</b>
                                            de
                                            <b class="text-capitalize">
                                                {% if (historiaPaciente[key - 1].obraSocial is not empty) %}
                                                    {% set obrasSocialesCliente = historiaPaciente[key - 1].obraSocial|split(',') %}
                                                    {% for obraSocialCliente in obrasSocialesCliente %}
                                                        <div>{{ obraSociales[obraSocialCliente] }}</div>
                                                    {% endfor %}
                                                {% else %}
                                                    Vacío
                                                {% endif %}
                                            </b>
                                            a
                                            <b class="text-capitalize">
                                            {% if (historia.obraSocial is not empty) %}
                                                {% set obrasSocialesCliente = historia.obraSocial|split(',') %}
                                                {% for obraSocialCliente in obrasSocialesCliente %}
                                                    <div>{{ obraSociales[obraSocialCliente] }}</div>
                                                {% endfor %}
                                            {% else %}
                                                Vacío
                                            {% endif %}
                                            </b>
                                            <br>
                                        {% endif %}

                                        {% if historia.nAfiliadoObraSocial != historiaPaciente[key - 1].nAfiliadoObraSocial %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Nº Afiliado OS:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].nAfiliadoObraSocial }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.nAfiliadoObraSocial }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.sistemaDeEmergencia != historiaPaciente[key - 1].sistemaDeEmergencia %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Sistema De Emergencia:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].sistemaDeEmergencia }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.sistemaDeEmergencia }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.nAfiliadoSistemaDeEmergencia != historiaPaciente[key - 1].nAfiliadoSistemaDeEmergencia %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Nº Afiliado SdE:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].nAfiliadoSistemaDeEmergencia }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.nAfiliadoSistemaDeEmergencia }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.habitacion != historiaPaciente[key - 1].habitacion %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">habitacion:</b>
                                            de
                                            <b class="text-capitalize">{{ (historiaPaciente[key - 1].habitacion and historiaPaciente[key - 1].habitacion in habitacionesArray|keys) ? habitacionesArray[historiaPaciente[key - 1].habitacion] : 'ninguna' }}</b>
                                            a
                                            <b class="text-capitalize">{{ (historia.habitacion and historia.habitacion in habitacionesArray|keys) ? habitacionesArray[historia.habitacion] : 'ninguna'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.cama != historiaPaciente[key - 1].cama %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">cama:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].cama ?? 'ninguna' }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.cama ?? 'ninguna'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaIngreso != historiaPaciente[key - 1].fechaIngreso %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de Ingreso:</b>
                                            de
                                            <b class="text-capitalize">{% if historiaPaciente[key - 1].fechaIngreso %} {{ historiaPaciente[key - 1].fechaIngreso | date('d/m/Y') }} {% else %} 'sin fecha' {% endif %}</b>
                                            a
                                            <b class="text-capitalize">{% if historia.fechaIngreso %} {{ historia.fechaIngreso | date('d/m/Y') }} {% else %} 'sin fecha' {% endif %}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaEngreso != historiaPaciente[key - 1].fechaEngreso %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de Egreso:</b>
                                            de
                                            <b class="text-capitalize">{% if historiaPaciente[key - 1].fechaEngreso %} {{ historiaPaciente[key - 1].fechaEngreso | date('d/m/Y') }} {% else %} 'sin fecha' {% endif %}</b>
                                            a
                                            <b class="text-capitalize">{% if historia.fechaEngreso %} {{ historia.fechaEngreso | date('d/m/Y') }} {% else %} 'sin fecha' {% endif %}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaDerivacion != historiaPaciente[key - 1].fechaDerivacion %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de Derivacion:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaDerivacion is not empty ? historiaPaciente[key - 1].fechaDerivacion | date('d/m/Y') : 'Vacío' }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.fechaDerivacion is not empty ? historia.fechaDerivacion | date('d/m/Y') : 'Vacio' }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaReingresoDerivacion != historiaPaciente[key - 1].fechaReingresoDerivacion %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de reingreso de Derivacion:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaReingresoDerivacion is not empty ? historiaPaciente[key - 1].fechaReingresoDerivacion | date('d/m/Y') : 'Vacío' }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.fechaReingresoDerivacion is not empty ? historia.fechaReingresoDerivacion | date('d/m/Y') : 'Vacio' }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.motivoDerivacion != historiaPaciente[key - 1].motivoDerivacion %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Motivo de Derivacion:</b>
                                            <b class="text-capitalize">{{ historia.motivoDerivacion }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.derivadoEn != historiaPaciente[key - 1].derivadoEn %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Derivado En:</b>
                                            <b class="text-capitalize">{{ historia.derivadoEn }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.empresaTransporteDerivacion != historiaPaciente[key - 1].empresaTransporteDerivacion %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Empresa de Transporte de Derivacion:</b>
                                            <b class="text-capitalize">{{ historia.empresaTransporteDerivacion }}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaAltaPorPermiso != historiaPaciente[key - 1].fechaAltaPorPermiso %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de Alta Por Permiso:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaAltaPorPermiso is not empty ? historiaPaciente[key - 1].fechaAltaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.fechaAltaPorPermiso is not empty ? historia.fechaAltaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.fechaBajaPorPermiso != historiaPaciente[key - 1].fechaBajaPorPermiso %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Fecha de Baja Por Permiso:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].fechaBajaPorPermiso is not empty ? historiaPaciente[key - 1].fechaBajaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.fechaBajaPorPermiso is not empty ? historia.fechaBajaPorPermiso | date('d/m/Y') : 'vacio'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.dePermiso != historiaPaciente[key - 1].dePermiso %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">De Permiso:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].dePermiso is empty or historiaPaciente[key - 1].dePermiso == 0 ? 'no' : 'si' }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.dePermiso is empty or historia.dePermiso == 0 ? 'no' : 'si'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.ambulatorio != historiaPaciente[key - 1].ambulatorio %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Ambulatorio:</b>
                                            de
                                            <b class="text-capitalize">{{ historiaPaciente[key - 1].ambulatorio is empty or historiaPaciente[key - 1].ambulatorio == 0 ? 'no' : 'si' }}</b>
                                            a
                                            <b class="text-capitalize">{{ historia.ambulatorio is empty or historia.ambulatorio == 0 ? 'no' : 'si'}}</b>
                                            <br>
                                        {% endif %}
                                        {% if historia.docReferente != historiaPaciente[key - 1].docReferente %}
                                            {% set cambio = 1 %}
                                            <b class="text-capitalize">Doc Referente:</b>
                                            de
                                            {% for profesional in profesionales %}
                                                {% if profesional.id in historiaPaciente[key - 1].docReferente %}
                                                    <div>{{ profesional.nombre }} {{ profesional.apellido }}</div>
                                                {% endif %}
                                            {% endfor %}
                                            {% if historiaPaciente[key - 1].docReferente | length == 0 %}
                                                Ninguno
                                            {% endif %}
                                            a
                                            <br>
                                            <b class="text-capitalize">
                                            {% for profesional in profesionales %}
                                                {% if profesional.id in historia.docReferente %}
                                                    <div>{{ profesional.nombre }} {{ profesional.apellido }}</div>
                                                {% endif %}
                                            {% endfor %}
                                                {% if historia.docReferente | length == 0 %}
                                                    Ninguno
                                                {% endif %}
                                            </b>
                                        {% endif %}
                                        {% if cambio == 0 %}
                                            <b class="text-capitalize">No se registraron cambios</b>
                                        {% endif %}
                                    </td>
                                {% else %}
                                    <td class="novedades">{{ historia.fecha ? historia.fecha|date('d/m/Y') : ''}}</td>
                                    <td colspan="8" class="novedades">
                                        <b class="text-capitalize">
                                            Primer Registro - modalidad:
                                            {% if(historia.modalidad == 1) %}
                                                Ambulatorio
                                            {% elseif(historia.modalidad == 2) %}
                                                Internacion
                                            {% elseif(historia.modalidad == 3) %}
                                                Hospital de día
                                            {% elseif(historia.modalidad == 4) %}
                                                ART
                                            {% endif %}
                                        </b>
                                    </td>
                                {% endif %}
                                <td class="novedades" class="lowercase">{{ historia.usuario }}</td>
                            </tr>
                        {% endfor %}
                        
                    {% else %}
                        <tr>
                            <td colspan="10">No existen registros</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="10" class="datos">
                            Total: {{ total }}
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="row">
            <!-- Resumen por Patología -->
            <div class="col-md-6 mb-4">
                <div class="card summary-card">
                    <div class="card-header">
                        <h5 class="mb-0">Distribución por Patología</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="patologiaChart" width="400" height="300"></canvas>
                        <div class="mt-3 patologia-list" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Patología</th><th>Cantidad</th></tr></thead>
                                <tbody>
                                {% for nombre, cantidad in patologiasCount %}
                                    <tr><td>{{ nombre }}</td><td>{{ cantidad }}</td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Resumen por Edad -->
            <div class="col-md-6 mb-4">
                <div class="card summary-card">
                    <div class="card-header">
                        <h5 class="mb-0">Distribución por Rango Etario</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="edadChart" width="400" height="300"></canvas>
                        <div class="mt-3 edad-list" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Rango</th><th>Cantidad</th></tr></thead>
                                <tbody>
                                {% for rango, cantidad in edadesRangos %}
                                    <tr><td>{{ rango }}</td><td>{{ cantidad }}</td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gráfico de Patologías
        const patLabels = {{ patologiasCount|keys|json_encode|raw }};
        const patData = {{ patologiasCount|values|json_encode|raw }};
        const patCtx = document.getElementById('patologiaChart').getContext('2d');
        new Chart(patCtx, {
            type: 'pie',
            data: {
                labels: patLabels,
                datasets: [{
                    data: patData,
                    backgroundColor: ['#60b9b9', '#b088be', '#ffc107', '#dc3545', '#6c757d']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'right' } } }
        });
        // Gráfico de Edades
        const edadLabels = {{ edadesRangos|keys|json_encode|raw }};
        const edadData = {{ edadesRangos|values|json_encode|raw }};
        const edadCtx = document.getElementById('edadChart').getContext('2d');
        new Chart(edadCtx, {
            type: 'bar',
            data: {
                labels: edadLabels,
                datasets: [{
                    label: 'Pacientes',
                    data: edadData,
                    backgroundColor: '#60b9b9'
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });
    });
    </script>
{% endblock %}

{% block modalImprimir %}
    <div class="form-check">
        <input class="form-check-input check" type="checkbox" checked value="datos" id="datos">
        <label class="form-check-label" for="id">
            Datos
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input check" type="checkbox" checked value="novedades" id="novedades">
        <label class="form-check-label" for="email">
            Novedades
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" checked value="todos" id="todos">
        <label class="form-check-label" for="todos">
            Todos
        </label>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $('.abrir').click(function (e) {
            e.preventDefault();
            let seccion = $(this).data('seccion');
            
            if($(this).data('toogle') === 'cerrado') {
                $('.'+seccion).show();
                $(this).data('toogle', 'abierto');
                $(this).html('<i class="fas fa-chevron-up"></i>');
            } else {
                $('.'+seccion).hide();
                $(this).data('toogle', 'cerrado');
                $(this).html('<i class="fas fa-chevron-down"></i>');
            }
        });

        // Funciones para la impresión y exportación
        $(document).ready(function() {
            // Impresión en formato resumido
            $('#btnPrintSummary').click(function() {
                // Mostrar todas las secciones de novedades antes de imprimir
                $('.novedades-section').show();
                
                // Ocultar filas sin cambios en el modo resumen
                $('.printable').addClass('summary-mode');
                
                // Configurar para imprimir solo los cambios significativos
                window.print();
                
                // Restaurar después de imprimir
                setTimeout(function() {
                    $('.printable').removeClass('summary-mode');
                    $('.novedades-section').hide();
                }, 1000);
            });
            
            // Exportar a PDF
            $('#btnExportPDF').click(function() {
                // Mostrar todas las secciones de novedades antes de imprimir
                $('.novedades-section').each(function() {
                    $(this).show();
                });
                
                // Crear formulario para enviar a controlador de impresión
                let form = $('<form action="{{ path("imprimir_historico_pacientes") }}" method="POST"></form>');
                
                // Añadir los parámetros de filtro actuales
                let params = {
                    'from': $('#from').val(),
                    'to': $('#to').val(),
                    'modalidad': $('select[name="modalidad"]').val(),
                    'nombre': $('#nombre').val(),
                    'obraSocial': $('select[name="obraSocial"]').val(),
                    'prof': $('select[name="prof"]').val(),
                    'vto': $('#vto').val(),
                    'hc': $('#hc').val()
                };
                
                // Añadir cada parámetro como input hidden
                $.each(params, function(key, value) {
                    form.append('<input type="hidden" name="' + key + '" value="' + value + '">');
                });
                
                // Añadir el formulario al DOM y enviarlo
                $('body').append(form);
                form.submit();
                form.remove();
                
                // Ocultar secciones después de enviar
                setTimeout(function() {
                    $('.novedades-section').each(function() {
                        $(this).hide();
                    });
                }, 500);
            });
            
            // Exportar a Excel
            $('#btnExportExcel').click(function() {
                // Crear formulario para enviar a controlador de exportación
                let form = $('<form action="{{ path("exportar_historico_excel") }}" method="POST"></form>');
                
                // Añadir los parámetros de filtro actuales
                let params = {
                    'from': $('#from').val(),
                    'to': $('#to').val(),
                    'modalidad': $('select[name="modalidad"]').val(),
                    'nombre': $('#nombre').val(),
                    'obraSocial': $('select[name="obraSocial"]').val(),
                    'prof': $('select[name="prof"]').val(),
                    'vto': $('#vto').val(),
                    'hc': $('#hc').val()
                };
                
                // Añadir cada parámetro como input hidden
                $.each(params, function(key, value) {
                    form.append('<input type="hidden" name="' + key + '" value="' + value + '">');
                });
                
                // Añadir el formulario al DOM y enviarlo
                $('body').append(form);
                form.submit();
                form.remove();
            });
        });
    </script>
{% endblock %}