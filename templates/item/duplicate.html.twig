{% extends 'base.html.twig' %}

{% block title %}Clonar ítem: {{ item.nombre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .body-content {
            overflow: auto !important;
            height: auto !important;
        }
        .container {
            max-width: 100%;
            overflow: visible;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row my-4">
            <div class="col">
                <h1>Clonar ítem: {{ item.nombre }}</h1>
                <div class="mb-3">
                    <a href="{{ path('app_item_show', {'id': item.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver al detalle
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4>Información de clonación</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <h5>Configuración del clon</h5>
                            <p class="text-muted">Configura los valores para el nuevo ítem. Los campos están pre-llenados con los valores del ítem original.</p>
                        </div>

                        {% if item.imagen %}
                            <div class="text-center mb-4">
                                <p>Imagen que se utilizará:</p>
                                <img src="{{ asset('uploads/items/imagenes/' ~ item.imagen) }}" alt="{{ item.nombre }}" class="img-fluid mb-3 rounded" style="max-height: 200px;">
                            </div>
                        {% else %}
                            <div class="alert alert-info mb-4">
                                El ítem original no tiene imagen. Los nuevos ítems tampoco tendrán imagen.
                            </div>
                        {% endif %}

                        <form method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="nombre" class="font-weight-bold">Nombre del clon:</label>
                                        <input type="text" id="nombre" name="nombre" value="{{ item.nombre }}" class="form-control" required>
                                        <small class="form-text text-muted">Nombre que tendrán los clones</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="identificador" class="font-weight-bold">Identificador:</label>
                                        <input type="text" id="identificador" name="identificador" value="{{ item.identificador }}" class="form-control">
                                        <small class="form-text text-muted">Identificador que tendrán todos los clones</small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="tipo" class="font-weight-bold">Tipo:</label>
                                        <select id="tipo" name="tipo" class="form-control" required>
                                            {% if tiposItem is defined and tiposItem|length > 0 %}
                                                {% for tipo in tiposItem %}
                                                    <option value="{{ tipo.id }}" {% if tipo.id == item.tipo.id %}selected{% endif %}>{{ tipo.nombre }}</option>
                                                {% endfor %}
                                            {% else %}
                                                <option value="">No hay tipos disponibles</option>
                                            {% endif %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="ubicacion" class="font-weight-bold">Ubicación:</label>
                                        <select id="ubicacion" name="ubicacion" class="form-control" required>
                                            {% if ubicaciones is defined and ubicaciones|length > 0 %}
                                                {% for ubicacion in ubicaciones %}
                                                    <option value="{{ ubicacion.id }}" {% if ubicacion.id == item.ubicacionActual.id %}selected{% endif %}>{{ ubicacion.nombre }}</option>
                                                {% endfor %}
                                            {% else %}
                                                <option value="">No hay ubicaciones disponibles</option>
                                            {% endif %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label for="cantidad" class="font-weight-bold">Cantidad de clones a crear:</label>
                                <input type="number" id="cantidad" name="cantidad" min="1" value="1" class="form-control" required>
                                <small class="form-text text-muted">
                                    Cada clon será un ítem independiente con su propio código QR, pero compartirá la misma imagen que el ítem original.
                                </small>
                            </div>


                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-clone"></i> Clonar ítem
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Validación simple del formulario
            const form = document.querySelector('form');
            
            form.addEventListener('submit', function(e) {
                const nombre = document.getElementById('nombre').value.trim();
                const tipo = document.getElementById('tipo').value;
                const ubicacion = document.getElementById('ubicacion').value;
                const cantidad = parseInt(document.getElementById('cantidad').value);
                
                if (!nombre || !tipo || !ubicacion || cantidad <= 0) {
                    e.preventDefault();
                    alert('Por favor completa todos los campos requeridos correctamente.');
                    return false;
                }
            });
        });
    </script>
{% endblock %}
