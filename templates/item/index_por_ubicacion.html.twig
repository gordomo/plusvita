{% extends 'base.html.twig' %}

{% block title %}Inventario en {{ ubicacion.nombre }}{% endblock %}
{% block panelTitle %}Inventario en {{ ubicacion.nombre }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row my-4">
        <div class="col">
            
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row mb-4">
        <div class="col">
            <a href="{{ path('app_ubicacion_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver a Ubicaciones
            </a>
            <a href="{{ path('app_item_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear Nuevo Ítem
            </a>
        </div>
        
        <div class="col-auto">
            <span class="badge badge-pill badge-info p-2" style="font-size: 1rem;">
                <i class="fas fa-boxes mr-1"></i> {{ items|length }} ítems en total
            </span>
        </div>
    </div>

    {% if itemsPorTipo|length > 0 %}
        <!-- Resumen por tipo -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Resumen por tipo</h4>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    {% for tipoInfo in itemsPorTipo %}
                        <a href="#tipo-{{ tipoInfo.tipo.id }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">{{ tipoInfo.tipo.nombre }}</h5>
                                <small class="text-muted">{{ tipoInfo.tipo.descripcion|default('Sin descripción') }}</small>
                            </div>
                            <span class="badge badge-primary badge-pill">{{ tipoInfo.totalItems }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Detalles por tipo -->
        {% for tipoId, tipoInfo in itemsPorTipo %}
            <div id="tipo-{{ tipoInfo.tipo.id }}" class="card mb-4">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">{{ tipoInfo.tipo.nombre }}</h4>
                    <span class="badge badge-light">{{ tipoInfo.totalItems }} ítems</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th width="60">Imagen</th>
                                    <th>Nombre</th>
                                    <th>Identificador</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in tipoInfo.items %}
                                    <tr>
                                        <td>
                                            {% if item.imagen %}
                                                <img src="{{ asset('uploads/items/imagenes/' ~ item.imagen) }}" alt="{{ item.nombre }}" class="img-thumbnail" style="max-width: 50px; max-height: 50px;">
                                            {% else %}
                                                <div class="text-center text-muted">
                                                    <i class="fas fa-ban" style="font-size: 1.5rem;"></i>
                                                </div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <strong>{{ item.nombre }}</strong>
                                        </td>
                                        <td>{{ item.identificador|default('Sin identificador') }}</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('app_item_show', { id: item.id }) }}" class="btn btn-sm btn-info" data-toggle="tooltip" title="Ver detalles">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="{{ path('app_item_edit', { id: item.id }) }}" class="btn btn-sm btn-warning" data-toggle="tooltip" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="{{ path('make_qr_item', { id: item.id }) }}" class="btn btn-sm btn-secondary" data-toggle="tooltip" title="Ver código QR" target="_blank">
                                                    <i class="fas fa-qrcode"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle mr-2"></i> No hay ítems registrados para esta ubicación. 
            <a href="{{ path('app_item_new') }}" class="alert-link">Crear un nuevo ítem</a>.
        </div>
    {% endif %}
</div>

<script>
    // Inicializar tooltips de Bootstrap
    $(document).ready(function(){
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
{% endblock %}