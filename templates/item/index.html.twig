{% extends 'base.html.twig' %}

{% block title %}Inventario{% endblock %}
{% block panelTitle %}Listado Completo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Estilos específicos para los dropdowns en esta página */
        body .table-responsive .dropdown-menu.show,
        body .row .dropdown-menu.show {
            background-color: #ffffff !important;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border: 1px solid rgba(0,0,0,0.15);
        }
        
        body .table-responsive .dropdown-menu .dropdown-item,
        body .row .dropdown-menu .dropdown-item {
            color: #333333 !important;
            padding: 0.5rem 1rem;
        }
        
        body .table-responsive .dropdown-menu .dropdown-item:hover,
        body .row .dropdown-menu .dropdown-item:focus,
        body .row .dropdown-menu .dropdown-item:hover,
        body .table-responsive .dropdown-menu .dropdown-item:focus {
            color: #ffffff !important;
            background-color: #007bff !important;
            text-decoration: none;
        }
        
        body .table-responsive .dropdown-menu .dropdown-divider,
        body .row .dropdown-menu .dropdown-divider {
            border-top: 1px solid #e9ecef;
            margin: 0.5rem 0;
        }
        
        /* Estilos para los grupos de items */
        .tipo-card {
            border: 1px solid #007bff;
            border-radius: 0.25rem;
            box-shadow: 0 2px 4px rgba(0, 123, 255, 0.1);
            transition: all 0.2s ease;
        }
        
        .tipo-card:hover {
            box-shadow: 0 4px 8px rgba(0, 123, 255, 0.2);
        }
        
        .card-header.bg-white {
            padding: 0.75rem 1.25rem;
            background-color: #ffffff !important;
        }
        
        .card-header.text-primary h5 {
            font-weight: 400;
            font-size: 1.2rem;
            color: #007bff;
        }
        
        .badge-primary {
            background-color: #007bff;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }
        
        .table thead th {
            border-top: none;
            border-bottom: 2px solid #007bff;
            background-color: #f8f9fa;
        }
        
        /* Estilos para el segundo nivel de agrupación */
        .border-bottom {
            border-bottom: 1px solid #dee2e6 !important;
        }
        
        .border-bottom:last-child {
            border-bottom: none !important;
        }
        
        /* Hover effect para los grupos de nombres */
        [role="button"][data-toggle="collapse"]:hover {
            background-color: #e9ecef !important;
        }
        
        /* Estilos para las tablas anidadas */
        .table-responsive .table {
            margin-bottom: 0;
        }
        
        .table-responsive .table td {
            padding: 0.5rem;
            vertical-align: middle;
        }
    </style>
{% endblock %}

{% block titleButtons %}{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show">
            {{ message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
{% endfor %}

<div class="row mb-3">
    <div class="col">
        <!-- Botones de acción -->
        <a href="{{ path('app_ubicacion_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a Ubicaciones
        </a>
        <a href="{{ path('app_item_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Crear Nuevo Ítem
        </a>
    </div>
    
    {% set hayFiltros = (ubicacion is defined and ubicacion) or (tipoItem is defined and tipoItem) %}
    <div class="col text-right">
        <!-- Filtros -->
        <div class="dropdown d-inline-block mr-2">
            <button class="btn btn-outline-primary dropdown-toggle" type="button" id="dropdownUbicacion" data-toggle="dropdown" aria-expanded="false">
                {% if ubicacion is defined and ubicacion %}
                    Ubicación: {{ ubicacion.nombre }}
                {% else %}
                    Filtrar por ubicación
                {% endif %}
            </button>
            {# Filtrar ubicaciones según tipo seleccionado #}
            {% set ubicacionesDisponibles = ubicaciones|default([]) %}
            {% if tipoItem is defined and tipoItem %}
                {% set ubicacionesDisponibles = [] %}
                {% for item in items %}
                    {% if item.Tipo and item.Tipo.id == tipoItem.id %}
                        {% set ubi = item.ubicacionActual %}
                        {% if ubi and ubi not in ubicacionesDisponibles %}
                            {% set ubicacionesDisponibles = ubicacionesDisponibles|merge([ubi]) %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <div class="dropdown-menu" aria-labelledby="dropdownUbicacion">
                <a class="dropdown-item" href="{{ path('app_item_index', tipoItem is defined and tipoItem ? {'tipoItem': tipoItem.id} : {}) }}">Todas las ubicaciones</a>
                <div class="dropdown-divider"></div>
                {% for ubi in ubicacionesDisponibles %}
                    <a class="dropdown-item" href="{{ path(tipoItem is defined and tipoItem ? 'app_item_index_tipo' : 'app_item_index', tipoItem is defined and tipoItem ? {'tipoItem': tipoItem.id, 'ubicacion': ubi.id} : {'ubicacion': ubi.id}) }}">
                        {{ ubi.nombre }}
                    </a>
                {% endfor %}
            </div>
        </div>
        
        <div class="dropdown d-inline-block">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="dropdownTipo" data-toggle="dropdown" aria-expanded="false">
                {% if tipoItem is defined and tipoItem %}
                    Tipo: {{ tipoItem.nombre }}
                {% else %}
                    Filtrar por tipo
                {% endif %}
            </button>
            {# Filtrar tipos según ubicación seleccionada #}
            {% set tiposDisponibles = tiposItem|default([]) %}
            {% if ubicacion is defined and ubicacion %}
                {% set tiposDisponibles = [] %}
                {% for item in items %}
                    {% if item.ubicacionActual and item.ubicacionActual.id == ubicacion.id %}
                        {% set tipo = item.Tipo %}
                        {% if tipo and tipo not in tiposDisponibles %}
                            {% set tiposDisponibles = tiposDisponibles|merge([tipo]) %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <div class="dropdown-menu" aria-labelledby="dropdownTipo">
                <a class="dropdown-item" href="{{ path('app_item_index', ubicacion is defined and ubicacion ? {'ubicacion': ubicacion.id} : {}) }}">Todos los tipos</a>
                <div class="dropdown-divider"></div>
                {% for tipo in tiposDisponibles %}
                    <a class="dropdown-item" href="{{ path(ubicacion is defined and ubicacion ? 'app_item_index_tipo' : 'app_item_index_tipo', ubicacion is defined and ubicacion ? {'tipoItem': tipo.id, 'ubicacion': ubicacion.id} : {'tipoItem': tipo.id}) }}">
                        {{ tipo.nombre }}
                    </a>
                {% endfor %}
            </div>
        </div>
        {% if hayFiltros %}
        <a href="{{ path('app_item_index') }}" class="btn btn-outline-danger ml-2">
            <i class="fas fa-times"></i> Limpiar filtros
        </a>
        {% endif %}
    </div>
</div>

<!-- Aquí empieza el listado de items agrupados por tipo -->
<div>
    {% set tipoActual = "" %}
    {% set gruposTipo = {} %}
    
    {# Organizar los grupos por tipo #}
    {% for grupo in itemsAgrupados %}
        {% if gruposTipo[grupo.tipo] is not defined %}
            {% set gruposTipo = gruposTipo|merge({(grupo.tipo): []}) %}
        {% endif %}
        {% set gruposTipo = gruposTipo|merge({(grupo.tipo): gruposTipo[grupo.tipo]|merge([grupo])}) %}
    {% endfor %}
    
    {# Ordenar los tipos alfabéticamente #}
    {% set gruposTipoOrdenados = {} %}
    {% for tipo in gruposTipo|keys|sort %}
        {% set gruposTipoOrdenados = gruposTipoOrdenados|merge({(tipo): gruposTipo[tipo]}) %}
    {% endfor %}
    {% set gruposTipo = gruposTipoOrdenados %}
    
    {# Mostrar los grupos por tipo #}
    {% for tipo, grupos in gruposTipo %}
        {% set totalItems = 0 %}
        {% for item in items %}
            {% if item.Tipo and item.Tipo.nombre == tipo %}
                {% set totalItems = totalItems + 1 %}
            {% endif %}
        {% endfor %}
        {% set tipoId = 'tipo-' ~ loop.index %}
        <div class="card mb-4 tipo-card">
            <div class="card-header bg-white text-primary" role="button" data-toggle="collapse" data-target="#{{ tipoId }}" aria-expanded="false" aria-controls="{{ tipoId }}" style="cursor: pointer; border-bottom: 2px solid #007bff;">
                <h5 class="mb-0 d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-caret-right mr-2"></i>
                         {% set nombreTipo = tipo|title %}
                        {{ nombreTipo }}
                    </span>
                    <span class="badge badge-primary">{{ totalItems }} ítems</span>
                </h5>
            </div>
            <div class="collapse" id="{{ tipoId }}">
                <div class="card-body p-0">
                    {# Agrupar items por nombre dentro de cada tipo #}
                    {% set itemsPorNombre = {} %}
                    {% for item in items %}
                        {% if item.Tipo and item.Tipo.nombre == tipo %}
                            {% set nombreItem = item.nombre|title %}
                            {% if itemsPorNombre[nombreItem] is not defined %}
                                {% set itemsPorNombre = itemsPorNombre|merge({(nombreItem): []}) %}
                            {% endif %}
                            {% set itemsPorNombre = itemsPorNombre|merge({(nombreItem): itemsPorNombre[nombreItem]|merge([item])}) %}
                        {% endif %}
                    {% endfor %}
                    
                    {# Mostrar grupos por nombre #}
                    {% for nombreItem, itemsDelNombre in itemsPorNombre %}
                        {% set cantidadItems = itemsDelNombre|length %}
                        {% set nombreId = tipoId ~ '-nombre-' ~ loop.index %}
                        
                        <div class="border-bottom">
                            <div class="d-flex justify-content-between align-items-center py-2 px-3" 
                                 role="button" data-toggle="collapse" data-target="#{{ nombreId }}" 
                                 aria-expanded="false" aria-controls="{{ nombreId }}" 
                                 style="cursor: pointer; background-color: #f8f9fa;">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-caret-right mr-2"></i>
                                    <strong>{{ nombreItem }}</strong>
                                </div>
                                <span class="badge badge-secondary">{{ cantidadItems }} unidades</span>
                            </div>
                            
                            <div class="collapse" id="{{ nombreId }}">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="thead-light">
                                            <tr>
                                                <th class="pl-3">Imagen</th>
                                                <th>Identificador</th>
                                                <th>Cantidad</th>
                                                <th>Ubicación</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for item in itemsDelNombre %}
                                                <tr>
                                                    <td class="pl-3">
                                                        {% if item.imagen %}
                                                            <img src="{{ asset('uploads/items/imagenes/' ~ item.imagen) }}" alt="{{ item.nombre }}" class="img-thumbnail" style="max-width: 50px;">
                                                        {% else %}
                                                            <span class="badge badge-secondary">Sin imagen</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if item.identificador %}
                                                            <code>{{ item.identificador }}</code>
                                                        {% else %}
                                                            <span class="text-muted">Sin identificador</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <span class="badge badge-info">{{ item.cantidad ?? 1 }}</span>
                                                    </td>
                                                    <td>
                                                        {% if item.ubicacionActual %}
                                                            <a href="{{ path('app_item_index_ubicacion', { ubicacion: item.ubicacionActual.id }) }}" class="text-decoration-none">
                                                                <i class="fas fa-map-marker-alt text-primary"></i> {{ item.ubicacionActual.nombre }}
                                                            </a>
                                                        {% else %}
                                                            <span class="text-muted">Sin ubicación</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('app_item_show', {'id': item.id}) }}" class="btn btn-sm btn-outline-info" title="Ver detalle">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a href="{{ path('app_item_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-warning" title="Editar">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <a href="{{ path('app_item_duplicate', {'id': item.id}) }}" class="btn btn-sm btn-outline-info" title="Duplicar">
                                                                <i class="fas fa-clone"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-sm btn-outline-primary" title="Mover" 
                                                                    onclick="openMoveModal({{ item.id }}, '{{ item.nombre|e('js') }}', {{ item.cantidad ?? 1 }})">
                                                                <i class="fas fa-arrows-alt"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">No hay ítems disponibles</div>
    {% endfor %}
</div>

{# Modal para mover items #}
<div class="modal fade" id="moveModal" tabindex="-1" aria-labelledby="moveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" id="moveForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="moveModalLabel">Mover Item</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="item_id" id="moveItemId">
                    <p>Nombre: <strong id="moveItemName"></strong></p>
                    <p>Cantidad disponible: <strong id="moveItemQuantity"></strong></p>
                    
                    <div class="form-group">
                        <label for="newQuantity">Cantidad a mover:</label>
                        <input type="number" class="form-control" id="newQuantity" name="quantity" min="1" value="1" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="newLocation">Nueva ubicación:</label>
                        <select class="form-control" id="newLocation" name="location" required>
                            <option value="">Seleccione una ubicación</option>
                            {% for ubicacion in ubicaciones %}
                                <option value="{{ ubicacion.id }}">{{ ubicacion.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Mover</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Si quieres mantener la tabla original, puedes dejarla debajo o comentarla -->
{# ...tabla original aquí si se desea... #}
{% endblock %}

{% block modalImprimir %}
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="1" id="Imagen" name="Imagen" checked>
        <label class="form-check-label" for="Imagen">Imagen</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="2" id="Nombre" name="Nombre" checked>
        <label class="form-check-label" for="Nombre">Nombre</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="3" id="Identificador" name="Identificador" checked>
        <label class="form-check-label" for="Identificador">Identificador</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="4" id="Ubicacion" name="Ubicacion" checked>
        <label class="form-check-label" for="Ubicacion">Ubicación</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="5" id="Tipo" name="Tipo" checked>
        <label class="form-check-label" for="Tipo">Tipo</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="6" id="QR" name="QR" checked>
        <label class="form-check-label" for="QR">Código QR</label>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var tituloExcel = 'Inventario_Items.xlsx';
        
        // Manejar el cambio de ícono al colapsar/expandir grupos
        $(document).ready(function() {
            // Asegurar que los iconos muestran el estado correcto al cargar
            $('.card-header').each(function() {
                var icon = $(this).find('i.fas');
                var isExpanded = $(this).attr('aria-expanded') === 'true';
                
                if (isExpanded) {
                    icon.removeClass('fa-caret-right').addClass('fa-caret-down');
                } else {
                    icon.removeClass('fa-caret-down').addClass('fa-caret-right');
                }
            });
            
            // Manejar el cambio al hacer clic en headers de tipo
            $('.card-header').on('click', function() {
                var icon = $(this).find('i.fas');
                if (icon.hasClass('fa-caret-down')) {
                    icon.removeClass('fa-caret-down').addClass('fa-caret-right');
                } else {
                    icon.removeClass('fa-caret-right').addClass('fa-caret-down');
                }
            });
            
            // Manejar el cambio al hacer clic en headers de nombre (segundo nivel)
            $('[role="button"][data-toggle="collapse"]').on('click', function() {
                // Solo para los elementos que no son card-header (segundo nivel)
                if (!$(this).hasClass('card-header')) {
                    var icon = $(this).find('i.fas');
                    if (icon.hasClass('fa-caret-down')) {
                        icon.removeClass('fa-caret-down').addClass('fa-caret-right');
                    } else {
                        icon.removeClass('fa-caret-right').addClass('fa-caret-down');
                    }
                }
            });
        });
        
        // Función para abrir el modal de mover item
        function openMoveModal(itemId, itemName, itemQuantity) {
            document.getElementById('moveItemId').value = itemId;
            document.getElementById('moveItemName').textContent = itemName;
            document.getElementById('moveItemQuantity').textContent = itemQuantity;
            document.getElementById('newQuantity').value = 1;
            document.getElementById('newQuantity').max = itemQuantity;
            document.getElementById('newLocation').value = '';
            
            // Establecer la acción del formulario con el ID del item
            document.getElementById('moveForm').action = '/item/' + itemId + '/move';
            
            $('#moveModal').modal('show');
        }
        
        function getHtmlToPrint(checkboxes, conHead) {
            let htmlToPrint = '<table border="1">';
            
            if (conHead) {
                htmlToPrint += '<thead><tr>';
                if (checkboxes.includes('1')) htmlToPrint += '<th>Imagen</th>';
                if (checkboxes.includes('2')) htmlToPrint += '<th>Nombre</th>';
                if (checkboxes.includes('3')) htmlToPrint += '<th>Identificador</th>';
                if (checkboxes.includes('4')) htmlToPrint += '<th>Ubicación</th>';
                if (checkboxes.includes('5')) htmlToPrint += '<th>Tipo</th>';
                if (checkboxes.includes('6')) htmlToPrint += '<th>Código QR</th>';
                htmlToPrint += '</tr></thead>';
            }
            
            htmlToPrint += '<tbody>';
            {% for item in items %}
                htmlToPrint += '<tr>';
                if (checkboxes.includes('1')) htmlToPrint += '<td>{% if item.imagen %}Sí{% else %}No{% endif %}</td>';
                if (checkboxes.includes('2')) htmlToPrint += '<td>{{ item.nombre }}</td>';
                if (checkboxes.includes('3')) htmlToPrint += '<td>{{ item.identificador|default("Sin identificador") }}</td>';
                if (checkboxes.includes('4')) htmlToPrint += '<td>{{ item.ubicacionActual.nombre }}</td>';
                if (checkboxes.includes('5')) htmlToPrint += '<td>{{ item.Tipo.nombre }}</td>';
                if (checkboxes.includes('6')) htmlToPrint += '<td>{% if item.codigoQr %}<img src="{{ asset("uploads/items/qr/" ~ item.codigoQr) }}" width="80" alt="QR">{% else %}Sin QR{% endif %}</td>';
                htmlToPrint += '</tr>';
            {% endfor %}
            htmlToPrint += '</tbody></table>';
            return htmlToPrint;
        }
    </script>
{% endblock %}
