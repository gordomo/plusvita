{% extends 'base.html.twig' %}

{% block title %}Dashboard de Roles y Permisos{% endblock %}
{% block panelTitle %}Dashboard de Roles y Permisos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        
        .stats-card.success {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }
        
        .stats-card.warning {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        
        .stats-card.info {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        
        .quick-action-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }
        
        .quick-action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        
        .role-badge {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
            border-radius: 1rem;
        }
        
        .permission-preview {
            max-height: 200px;
            overflow-y: auto;
        }
        
        .recent-activity {
            max-height: 300px;
            overflow-y: auto;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Estadísticas principales -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">{{ totalUsers }}</h3>
                        <p class="mb-0">Usuarios Activos</p>
                    </div>
                    <i class="fas fa-users fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">{{ totalRoles }}</h3>
                        <p class="mb-0">Roles Configurados</p>
                    </div>
                    <i class="fas fa-user-tag fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">{{ totalPermissions }}</h3>
                        <p class="mb-0">Permisos Disponibles</p>
                    </div>
                    <i class="fas fa-key fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0">{{ usersWithoutRoles }}</h3>
                        <p class="mb-0">Sin Roles</p>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Acciones rápidas -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt mr-2"></i>
                        Acciones Rápidas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('role_new') }}" class="btn btn-primary quick-action-card">
                            <i class="fas fa-plus mr-2"></i>
                            Crear Nuevo Rol
                        </a>
                        <a href="{{ path('user_management_index') }}" class="btn btn-success quick-action-card">
                            <i class="fas fa-users mr-2"></i>
                            Gestionar Usuarios
                        </a>
                        <a href="{{ path('role_index') }}" class="btn btn-info quick-action-card">
                            <i class="fas fa-list mr-2"></i>
                            Ver Todos los Roles
                        </a>
                        <a href="{{ path('app_command_initialize_roles') }}" class="btn btn-warning quick-action-card">
                            <i class="fas fa-sync mr-2"></i>
                            Inicializar Permisos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Roles más utilizados -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie mr-2"></i>
                        Roles Más Utilizados
                    </h5>
                </div>
                <div class="card-body">
                    {% for role in popularRoles %}
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge badge-primary role-badge">{{ role.displayName }}</span>
                            <small class="text-muted d-block">{{ role.userCount }} usuarios</small>
                        </div>
                        <div class="text-right">
                            <div class="progress" style="width: 100px; height: 8px;">
                                <div class="progress-bar" style="width: {{ (role.userCount / totalUsers * 100)|round }}%"></div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Usuarios sin roles -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        Usuarios Sin Roles
                    </h5>
                </div>
                <div class="card-body">
                    {% if usersWithoutRolesList|length > 0 %}
                        <div class="recent-activity">
                            {% for user in usersWithoutRolesList %}
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong>{{ user.nombre ?? user.username }}</strong>
                                    <br>
                                    <small class="text-muted">{{ user.email }}</small>
                                </div>
                                <a href="{{ path('user_edit_roles', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-user-plus"></i>
                                </a>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-3">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <p class="text-muted mb-0">Todos los usuarios tienen roles asignados</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Vista detallada de roles -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt mr-2"></i>
                        Resumen de Permisos por Rol
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% for role in rolesWithPermissions %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header">
                                    <h6 class="mb-0">
                                        <i class="fas fa-user-tag mr-2"></i>
                                        {{ role.displayName }}
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-3">{{ role.description }}</p>
                                    
                                    <div class="permission-preview">
                                        <strong>Permisos:</strong>
                                        {% for permission in role.permissions|slice(0, 5) %}
                                            <span class="badge badge-light badge-sm d-inline-block mb-1">
                                                {{ permission.displayName }}
                                            </span>
                                        {% endfor %}
                                        {% if role.permissions|length > 5 %}
                                            <small class="text-muted">... y {{ role.permissions|length - 5 }} más</small>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="mt-3">
                                        <a href="{{ path('role_show', {'id': role.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Ver Detalles
                                        </a>
                                        <a href="{{ path('role_permissions', {'id': role.id}) }}" class="btn btn-sm btn-outline-warning">
                                            <i class="fas fa-key"></i> Permisos
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
