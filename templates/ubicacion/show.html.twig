{% extends 'base.html.twig' %}

{% block title %}{{ ubicacion.nombre }} - Gestión de Ubicación{% endblock %}
{% block panelTitle %}{{ ubicacion.nombre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }
        
        .movement-item {
            border-left: 4px solid #007bff;
            padding: 15px;
            margin-bottom: 10px;
            background-color: #f8f9fa;
            border-radius: 0 5px 5px 0;
        }
        
        .movement-date {
            color: #666;
            font-size: 0.85rem;
        }
        
        .movement-motive {
            font-weight: 500;
            color: #333;
        }
        
        .item-link {
            color: #007bff;
            text-decoration: none;
        }
        
        .item-link:hover {
            text-decoration: underline;
        }
        
        .no-movements {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .section-header {
            background-color: #007bff;
            color: white;
            padding: 10px 15px;
            margin: 0;
            border-radius: 5px 5px 0 0;
        }
        
        .section-content {
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 5px 5px;
            padding: 20px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Información de la ubicación -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="stats-card">
                <div class="row">
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">{{ totalItems }}</div>
                            <div class="stat-label">Items Actuales</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">{{ movimientos|length }}</div>
                            <div class="stat-label">Movimientos Totales</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">{{ tiposUnicos|keys|length }}</div>
                            <div class="stat-label">Tipos Diferentes</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-item">
                            <div class="stat-number">{{ ubicacion.descripcion ? 'Sí' : 'No' }}</div>
                            <div class="stat-label">Descripción</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Información básica -->
        <div class="col-md-4">
            <div class="card">
                <h5 class="section-header">
                    <i class="fas fa-info-circle"></i> Información de la Ubicación
                </h5>
                <div class="section-content">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Nombre:</th>
                            <td>{{ ubicacion.nombre }}</td>
                        </tr>
                        <tr>
                            <th>Descripción:</th>
                            <td>{{ ubicacion.descripcion ?: 'Sin descripción' }}</td>
                        </tr>
                        <tr>
                            <th>Items actuales:</th>
                            <td><strong>{{ totalItems }}</strong></td>
                        </tr>
                    </table>
                    
                    <div class="mt-3">
                        <a href="{{ path('app_ubicacion_index') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Volver al Listado
                        </a>
                        <a href="{{ path('app_ubicacion_edit', { id: ubicacion.id }) }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                        <a href="{{ path('app_novedad_ubicacion_index', { ubicacionId: ubicacion.id }) }}" class="btn btn-info btn-sm">
                            <i class="fas fa-clipboard-list"></i> Gestión de Novedades
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items en esta ubicación -->
        <div class="col-md-8">
            <div class="card">
                <h5 class="section-header">
                    <i class="fas fa-box"></i> Items en esta Ubicación ({{ totalItems }})
                </h5>
                <div class="section-content">
                    {% if itemsEnUbicacion|length > 0 %}
                        <div class="row">
                            {% for item in itemsEnUbicacion %}
                                <div class="col-md-6 mb-3">
                                    <div class="card border-left-primary">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <a href="{{ path('app_item_show', {id: item.id}) }}" class="item-link">
                                                    {{ item.nombre }}
                                                </a>
                                            </h6>
                                            <p class="card-text">
                                                <small class="text-muted">
                                                    <strong>Tipo:</strong> {{ item.tipo ? item.tipo.nombre : 'Sin tipo' }}<br>
                                                    <strong>ID:</strong> {{ item.identificador ?: 'Sin ID' }}
                                                </small>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="no-movements">
                            <i class="fas fa-box-open fa-3x mb-3"></i>
                            <p>No hay items en esta ubicación actualmente.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de movimientos -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <h5 class="section-header">
                    <i class="fas fa-history"></i> Historial de Movimientos ({{ movimientos|length }})
                </h5>
                <div class="section-content">
                    {% if movimientos|length > 0 %}
                        <div class="timeline">
                            {% for movimiento in movimientos %}
                                <div class="movement-item">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="movement-motive">
                                                <strong>{{ movimiento.motivo }}</strong>
                                            </div>
                                            <div class="movement-date">
                                                <i class="fas fa-calendar"></i> {{ movimiento.fecha|date('d/m/Y H:i') }}
                                                {% if movimiento.cantidad %}
                                                    | <i class="fas fa-hashtag"></i> Cantidad: {{ movimiento.cantidad }}
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-right">
                                            {% if movimiento.item %}
                                                <a href="{{ path('app_item_show', {id: movimiento.item.id}) }}" class="item-link">
                                                    <i class="fas fa-box"></i> {{ movimiento.item.nombre }}
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="no-movements">
                            <i class="fas fa-history fa-3x mb-3"></i>
                            <p>No hay movimientos registrados para esta ubicación.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}