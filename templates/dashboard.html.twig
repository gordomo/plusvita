{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        .dashboard-container .section-heading {
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #eee;
            font-weight: 600;
        }
        
        .dashboard-container .section-title {
            border-left: 4px solid #b088be;
            padding-left: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .dashboard-container .dashboard-card {
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
            transition: transform 0.2s ease;
        }
        
        .dashboard-container .dashboard-card:hover {
            transform: translateY(-3px);
        }
        
        .dashboard-filters {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .notification-bell {
            display: inline-block;
            position: relative;
        }
        
        .notification-bell .badge {
            position: absolute;
            top: -5px;
            right: -5px;
            border-radius: 50%;
            background: red;
            color: white;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
        }
        
        .hospital-summary table td {
            vertical-align: middle;
        }
        
        .hospital-summary .room-status {
            font-weight: 600;
        }
        
        .hospital-summary .room-status.full {
            color: #dc3545;
        }
        
        .hospital-summary .room-status.available {
            color: #28a745;
        }
        
        /* Color scheme consistent with patient screens */
        .camas-section .section-heading {
            border-color: #60b9b9;
        }
        
        .ambulatorios-section .section-heading {
            border-color: #b088be;
        }
        
        .ingresos-section .section-heading {
            border-color: #889cbe;
        }
    </style>
{% endblock %}

{% block panelTitle %}
<div class="d-flex justify-content-between align-items-center">
    <div>
        Dashboard <br><span class="text-muted" style="font-size: 15px;">{{ modalidad }}</span>
    </div>
    {% if (hayContratosVencidos or hayVencenEsteMes) and is_granted('ROLE_ADMIN') %}
        <div class="notification-bell">
            <a href="{{ path('doctor_index', {'vencidos': (hayContratosVencidos) ? 1 : 2}) }}" class="btn btn-light">
                <i class="bell far fa-bell" style="color: {{ colorCampana }}"></i>
                {% if hayContratosVencidos %}
                    <span class="badge">{{ hayContratosVencidos }}</span>
                {% endif %}
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block filtros %}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="col-sm" style="align-items: center; justify-content: center; display: flex;">
            <button class="btn btn-outline-primary" data-toggle="modal" data-target="#filtros">
                <i class="fas fa-filter"></i> Filtrar
            </button>
        </div>
    {% endif %}
{% endblock %}

{% block body %}
    {% if not app.user %}
        <div class="alert alert-info">
            Por favor, ingrese con su usuario y contraseña
            <a href="{{ path('app_login') }}" class="btn btn-primary ml-3">Ingresar</a>
        </div>
    {% elseif is_granted('ROLE_ADMIN') %}
        <div class="dashboard-container printiable">
            <div class="row">
                <div class="col-12">
                    <h3 class="section-title camas-section">Ocupación de Camas</h3>
                </div>
            </div>
            
            <div class="hospital-summary">
                <div class="table-responsive">
                    <table class="table table-hover dashboard border-0 mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="habitacion">Habitación</th>
                                <th class="paciente">Paciente</th>
                                <th class="obraSocial">Obra Social</th>
                                <th class="patología">Patología</th>
                                <th class="edad">Edad</th>
                                <th class="dieta">Dieta</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for key, data in habitacionesYpacientes %}
                                <tr class="{{ ( data.disponibles ) ? 'incompleta' : 'completa' }}">
                                    <td class="habitacion" colspan="6">
                                        {% set habitacion = habitacionRepository.find(key) %}
                                        {% set nombreHabitacion = habitacion.nombre ?? 'habitacion borrada'%}
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="font-weight-bold">{{ nombreHabitacion }}</span>
                                            <span class="room-status {{ data.disponibles > 0 ? 'available' : 'full' }}">
                                                {{ data.totales - data.disponibles }}/{{ data.totales }} 
                                                <small class="text-muted">({{ data.disponibles }} disponibles)</small>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                {% for paciente in data.clientes %}
                                <tr>
                                    <td class="border-0"></td>
                                    <td class="paciente border-0" >
                                        <a href="{{ path('cliente_historial', {id: paciente.id}) }}">{{ paciente.nombre }} {{ paciente.apellido }}</a>
                                    </td>
                                    <td class="obraSocial {{ (data.clientes | length > 1 and key != 0) ? '' : 'border-0' }}">
                                        <div>{{ paciente.obraSocial.nombre ?? 'No Tiene' }}</div>
                                    </td>
                                    <td class="patología {{ (data.clientes | length > 1 and key != 0) ? '' : 'border-0' }}">
                                        {{ paciente.motivoIngEspecifico }}
                                    </td>
                                    <td class="edad {{ (data.clientes | length > 1 and key != 0) ? '' : 'border-0' }}">
                                        {{ paciente.edad }}
                                    </td>
                                    <td class="dieta {{ (data.clientes | length > 1 and key != 0) ? '' : 'border-0' }}">
                                        {{ paciente.dieta }}
                                    </td>
                                </tr>
                                {% endfor %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% elseif is_granted('ROLE_STAFF') %}
        <div class="dashboard-container">
            <div class="row">
                {% if isDoctor %}
                    <div class="col-md-4">
                        <a href="{{ path('doctor_agenda', {'periodo': 'dia'}) }}" class="text-decoration-none">
                            <div class="card dashboard-card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="far fa-calendar-alt mr-2"></i> Agenda</h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-muted">Administre sus turnos y eventos diarios</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('doctor_historia') }}" class="text-decoration-none">
                            <div class="card dashboard-card">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="fas fa-user-injured mr-2"></i> Pacientes</h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-muted">Acceda a historias clínicas de pacientes</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="{{ path('liquidar', {'id': app.user.id}) }}" class="text-decoration-none">
                            <div class="card dashboard-card">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="fas fa-money-check-alt mr-2"></i> Liquidaciones</h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-muted">Imprima y exporte sus liquidaciones</p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endif %}
                {% if isEnfermero %}
                    <div class="col-md-4">
                        <a href="{{ path('prescripcion_index', {'id': app.user.id}) }}" class="text-decoration-none">
                            <div class="card dashboard-card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-user-nurse mr-2"></i> Prescripciones</h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-muted">Administre prescripciones médicas por paciente</p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block modalImprimir %}
    <div class="dashboard-filter-options">
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="habitacion" id="habitacion" checked>
            <label class="form-check-label" for="habitacion">
                Habitación
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="paciente" id="paciente" checked>
            <label class="form-check-label" for="paciente">
                Paciente
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="obraSocial" id="obraSocial" checked>
            <label class="form-check-label" for="obraSocial">
                Obra Social
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="patologia" id="patologia" checked>
            <label class="form-check-label" for="patologia">
                Patología
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="dieta" id="dieta">
            <label class="form-check-label" for="dieta">
                Dieta
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input check" type="checkbox" value="edad" id="edad">
            <label class="form-check-label" for="edad">
                Edad
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="todos" id="todos">
            <label class="form-check-label" for="todos">
                Todos
            </label>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var tituloExcel = 'dashboard.xlsx';
        let printUrl = "{{ path('imprimir') }}";
        let dashboardFilterUrl = "{{ path('dashboard_index_filtro_cantidad_pacientes') }}";
    </script>
    <script src="{{ asset('assets/js/dashboard.js') }}"></script>
{% endblock %}