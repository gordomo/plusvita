{% extends 'base.html.twig' %}

{% block title %}Permisos del Rol: {{ role.displayName }}{% endblock %}
{% block panelTitle %}Gestionar Permisos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .permission-category {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        
        .permission-item {
            display: flex;
            align-items: center;
            padding: 0.5rem;
            border: 1px solid #e9ecef;
            border-radius: 0.25rem;
            margin-bottom: 0.5rem;
            background: white;
            transition: all 0.2s ease;
        }
        
        .permission-item:hover {
            background-color: #f8f9fa;
            border-color: #007bff;
        }
        
        .permission-checkbox {
            margin-right: 0.75rem;
        }
        
        .permission-info {
            flex-grow: 1;
        }
        
        .permission-name {
            font-weight: 600;
            color: #495057;
        }
        
        .permission-description {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 0.25rem;
        }
        
        .category-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            padding: 0.75rem 1rem;
            border-radius: 0.375rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        
        .select-all-category {
            margin-bottom: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-key mr-2"></i>
                    Permisos del Rol: {{ role.displayName }}
                </h2>
                <div>
                    <a href="{{ path('role_show', {'id': role.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver al Rol
                    </a>
                </div>
            </div>
        </div>
    </div>

    <form method="post" id="permissionsForm">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-shield-alt mr-2"></i>
                            Seleccionar Permisos
                        </h5>
                        <p class="text-muted mb-0 mt-2">
                            Marca los permisos que deseas asignar a este rol. Los permisos están organizados por categorías.
                        </p>
                    </div>
                    <div class="card-body">
                        {% for category, permissions in permissionsByCategory %}
                        <div class="permission-category">
                            <div class="category-header">
                                <i class="fas fa-folder mr-2"></i>
                                {{ category }}
                            </div>
                            
                            <div class="select-all-category">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input category-select-all" 
                                           id="select_all_{{ loop.index }}" 
                                           data-category="{{ loop.index }}">
                                    <label class="form-check-label" for="select_all_{{ loop.index }}">
                                        <strong>Seleccionar todos los permisos de {{ category }}</strong>
                                    </label>
                                </div>
                            </div>
                            
                            {% for permission in permissions %}
                            <div class="permission-item">
                                <div class="permission-checkbox">
                                    <div class="form-check">
                                        <input type="checkbox" 
                                               class="form-check-input permission-checkbox-input" 
                                               name="permissions[]" 
                                               value="{{ permission.id }}" 
                                               id="permission_{{ permission.id }}"
                                               data-category="{{ loop.parent.loop.index }}"
                                               {% if permission.id in rolePermissionIds %}checked{% endif %}>
                                        <label class="form-check-label" for="permission_{{ permission.id }}"></label>
                                    </div>
                                </div>
                                <div class="permission-info">
                                    <div class="permission-name">{{ permission.displayName }}</div>
                                    {% if permission.description %}
                                    <div class="permission-description">{{ permission.description }}</div>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">Resumen de Selección</h6>
                                <p class="text-muted mb-0">
                                    <span id="selected-count">0</span> permisos seleccionados de 
                                    <span id="total-count">{{ permissionsByCategory|length > 0 ? permissionsByCategory|first|length : 0 }}</span> disponibles
                                </p>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save"></i> Guardar Permisos
                                </button>
                                <a href="{{ path('role_show', {'id': role.id}) }}" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-times"></i> Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para actualizar contadores
    function updateCounters() {
        const selected = document.querySelectorAll('input[name="permissions[]"]:checked').length;
        const total = document.querySelectorAll('input[name="permissions[]"]').length;
        
        document.getElementById('selected-count').textContent = selected;
        document.getElementById('total-count').textContent = total;
    }
    
    // Función para manejar "seleccionar todo" por categoría
    function handleCategorySelectAll() {
        document.querySelectorAll('.category-select-all').forEach(selectAll => {
            selectAll.addEventListener('change', function() {
                const category = this.dataset.category;
                const isChecked = this.checked;
                
                document.querySelectorAll(`input[data-category="${category}"]`).forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                
                updateCounters();
            });
        });
    }
    
    // Función para manejar cambios en permisos individuales
    function handleIndividualPermissions() {
        document.querySelectorAll('.permission-checkbox-input').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const category = this.dataset.category;
                const categoryCheckboxes = document.querySelectorAll(`input[data-category="${category}"]`);
                const categorySelectAll = document.querySelector(`input[data-category="${category}"].category-select-all`);
                
                const checkedCount = Array.from(categoryCheckboxes).filter(cb => cb.checked).length;
                const totalCount = categoryCheckboxes.length;
                
                if (categorySelectAll) {
                    categorySelectAll.checked = checkedCount === totalCount;
                    categorySelectAll.indeterminate = checkedCount > 0 && checkedCount < totalCount;
                }
                
                updateCounters();
            });
        });
    }
    
    // Inicializar
    updateCounters();
    handleCategorySelectAll();
    handleIndividualPermissions();
    
    // Manejar envío del formulario
    document.getElementById('permissionsForm').addEventListener('submit', function(e) {
        const selectedPermissions = document.querySelectorAll('input[name="permissions[]"]:checked').length;
        
        if (selectedPermissions === 0) {
            e.preventDefault();
            alert('Por favor selecciona al menos un permiso para este rol.');
            return false;
        }
        
        if (!confirm(`¿Estás seguro de que quieres asignar ${selectedPermissions} permisos a este rol?`)) {
            e.preventDefault();
            return false;
        }
    });
});
</script>
{% endblock %}
