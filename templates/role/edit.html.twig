{% extends 'base.html.twig' %}

{% block title %}Editar Rol: {{ role.displayName }}{% endblock %}
{% block panelTitle %}Editar Rol{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .permissions-checkboxes {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            background-color: #f8f9fa;
        }
        
        .permissions-checkboxes .form-check {
            margin-bottom: 0.5rem;
        }
        
        .permissions-checkboxes .form-check-label {
            font-size: 0.9rem;
        }
        
        .permissions-checkboxes .form-check-input:checked + .form-check-label {
            font-weight: 600;
            color: #007bff;
        }
        
        .permission-group {
            margin-bottom: 1.5rem;
        }
        
        .permission-group-title {
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.75rem;
            padding-bottom: 0.25rem;
            border-bottom: 2px solid #007bff;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user-tag mr-2"></i>
                        Editar Rol: {{ role.displayName }}
                    </h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.name) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.displayName) }}
                            </div>
                        </div>
                        
                        {{ form_row(form.description) }}
                        
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.isActive) }}
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-info-circle mr-2"></i>
                        Información del Rol
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">ID:</dt>
                        <dd class="col-sm-7">{{ role.id }}</dd>
                        
                        <dt class="col-sm-5">Tipo:</dt>
                        <dd class="col-sm-7">
                            {% if role.isSystem %}
                                <span class="badge badge-warning">
                                    <i class="fas fa-cog"></i> Sistema
                                </span>
                            {% else %}
                                <span class="badge badge-info">
                                    <i class="fas fa-user"></i> Personalizado
                                </span>
                            {% endif %}
                        </dd>
                        
                        <dt class="col-sm-5">Creado:</dt>
                        <dd class="col-sm-7">{{ role.createdAt|date('d/m/Y H:i') }}</dd>
                        
                        <dt class="col-sm-5">Última actualización:</dt>
                        <dd class="col-sm-7">{{ role.updatedAt|date('d/m/Y H:i') }}</dd>
                    </dl>
                    
                    {% if role.isSystem %}
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Rol del sistema:</strong> Este es un rol predefinido del sistema. 
                        Algunos campos pueden estar restringidos.
                    </div>
                    {% endif %}
                </div>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}
