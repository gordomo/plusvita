{% extends 'base.html.twig' %}

{% block title %}Rol: {{ role.displayName }}{% endblock %}
{% block panelTitle %}Detalles del Rol{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .permission-badge {
            display: inline-block;
            margin: 0.125rem;
            font-size: 0.8rem;
        }
        
        .role-info-card {
            border-left: 4px solid #007bff;
        }
        
        .permissions-section {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-user-tag mr-2"></i>
                    {{ role.displayName }}
                </h2>
                <div>
                    <a href="{{ path('role_edit', {'id': role.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    <a href="{{ path('role_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card role-info-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle mr-2"></i>
                        Información del Rol
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Nombre:</dt>
                                <dd class="col-sm-8">
                                    <code>{{ role.name }}</code>
                                </dd>
                                
                                <dt class="col-sm-4">Nombre para mostrar:</dt>
                                <dd class="col-sm-8">{{ role.displayName }}</dd>
                                
                                <dt class="col-sm-4">Estado:</dt>
                                <dd class="col-sm-8">
                                    {% if role.isActive %}
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Activo
                                        </span>
                                    {% else %}
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times"></i> Inactivo
                                        </span>
                                    {% endif %}
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Tipo:</dt>
                                <dd class="col-sm-8">
                                    {% if role.isSystem %}
                                        <span class="badge badge-warning">
                                            <i class="fas fa-cog"></i> Sistema
                                        </span>
                                    {% else %}
                                        <span class="badge badge-info">
                                            <i class="fas fa-user"></i> Personalizado
                                        </span>
                                    {% endif %}
                                </dd>
                                
                                <dt class="col-sm-4">Creado:</dt>
                                <dd class="col-sm-8">{{ role.createdAt|date('d/m/Y H:i') }}</dd>
                                
                                <dt class="col-sm-4">Actualizado:</dt>
                                <dd class="col-sm-8">{{ role.updatedAt|date('d/m/Y H:i') }}</dd>
                            </dl>
                        </div>
                    </div>
                    
                    {% if role.description %}
                    <div class="mt-3">
                        <h6>Descripción:</h6>
                        <p class="text-muted">{{ role.description }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-cogs mr-2"></i>
                        Acciones
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('role_permissions', {'id': role.id}) }}" class="btn btn-warning">
                            <i class="fas fa-key"></i> Gestionar Permisos
                        </a>
                        <a href="{{ path('role_edit', {'id': role.id}) }}" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Editar Rol
                        </a>
                        
                        {% if not role.isSystem %}
                        <a href="{{ path('role_delete', {'id': role.id}) }}" 
                           class="btn btn-danger"
                           onclick="return confirm('¿Estás seguro de que quieres eliminar este rol?')">
                            <i class="fas fa-trash"></i> Eliminar Rol
                        </a>
                        {% endif %}
                        
                        <a href="{{ path('role_index') }}" class="btn btn-secondary">
                            <i class="fas fa-list"></i> Ver Todos los Roles
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-key mr-2"></i>
                        Permisos Asignados
                    </h5>
                </div>
                <div class="card-body">
                    {% if role.permissions|length > 0 %}
                        <div class="permissions-section">
                            {% for permission in role.permissions %}
                                <span class="badge badge-secondary permission-badge">
                                    <i class="fas fa-shield-alt mr-1"></i>
                                    {{ permission.displayName }}
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-exclamation-triangle fa-2x text-muted mb-3"></i>
                            <p class="text-muted">Este rol no tiene permisos asignados.</p>
                            <a href="{{ path('role_edit', {'id': role.id}) }}" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Asignar Permisos
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
