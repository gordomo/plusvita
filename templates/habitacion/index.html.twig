{% extends 'base.html.twig' %}

{% block title %}Habitaciones{% endblock %}
{% block panelTitle %}Habitaciones{% endblock %}
{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm">
                <div>
                    <ul class="nav nav-tabs justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link {{  pestana == 'todas' ? 'active' : ''  }}" href="{{ path('habitacion_index') }}">Todas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{  pestana == 'camas-vacias' ? 'active' : ''  }}" href="{{ path('habitacion_index') }}?pestana=camas-vacias">Habitaciones con camas Disponibles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{  pestana == 'completas' ? 'active' : ''  }}"  href="{{ path('habitacion_index') }}?pestana=completas">Habitaciones Completas</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-sm">
                <div class="input-group mb-3">
                    <div>
                        <a href="{{ path('habitacion_new') }}" class="btn-success btn" style="border-radius: 0">Nueva Habitación</a>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Camas Totales: <span id="camasTotales"></span></th>
                <th>Camas Ocupadas: <span id="ocupadas"></span></th>
                <th>Camas Disponibles: <span id="disponibles"></span></th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% set camas = 0 %}
        {% set ocupadas = 0 %}
        {% set disponibles = 0 %}
        {% for habitacion in habitacions %}
            <tr class="bg-light">
                <td>{{ habitacion.nombre }}</td>
                <td>{{ habitacion.camasDisponibles }}</td>
                {% set camasOcupadas = habitacion.camasOcupadas|length %}
                <td>{{ camasOcupadas ? camasOcupadas : 0 }}</td>
                {% set camasDisp = habitacion.camasDisponibles - camasOcupadas %}
                <td>{{ camasDisp }}</td>
                <td>
                    <a href="{{ path('habitacion_edit', {'id': habitacion.id}) }}"><i class="fas fa-pencil-alt"></i></a>
                </td>
            </tr>
            {% set pacientesEnHab = clienteRepository.findActivosSinPag(fecha, '', habitacion.id) %}
                    {% for paciente in pacientesEnHab %}
                <tr {% if paciente.dePermiso %} style="border-left: 3px solid #6c757d;" title="Paciente de permiso" {% endif %}>
                    <td colspan="4">
                        <a href="{{ path('evolucion_index', {cliente: paciente.id}) }}">
                            {{ paciente.nombre }} {{ paciente.apellido }}
                            {% if paciente.dePermiso %}
                                <small class="text-muted">
                                    <i class="fa fa-clock-o" aria-hidden="true"></i> De permiso 
                                    {% if paciente.fechaAltaPorPermiso %}
                                        - Regresa: {{ paciente.fechaAltaPorPermiso|date('d/m/Y') }}
                                    {% endif %}
                                </small>
                            {% endif %}
                        </a>
                    </td>
                    <td colspan="1">
                        {% if not paciente.dePermiso %}
                            {% if not paciente.ambulatorioPresente %}
                                <a class="btn btn-default" href="{{ path('dar_presente', {'id': paciente.id, 'pestana': pestana}) }}">
                                    <i class="fa fa-check-square-o" aria-hidden="true"></i> dar presente
                                </a>
                            {% endif %}
                            {% if paciente.ambulatorioPresente %}
                                <a class="btn btn-default" href="{{ path('dar_ausente', {'id': paciente.id, 'pestana': pestana}) }}">
                                    <i class="fa fa-window-close-o" aria-hidden="true"></i> dar ausente
                                </a>
                            {% endif %}
                        {% else %}
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('cliente_reingreso_permiso', {'id': paciente.id}) }}" title="Reingresar de permiso">
                                <i class="fa fa-undo" aria-hidden="true"></i> Reingresar
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {% set camas = camas + camasOcupadas + camasDisp %}
            {% set ocupadas = ocupadas + camasOcupadas %}
            {% set disponibles = disponibles + camasDisp %}
        {% else %}
            <tr>
                <td colspan="5">No existen registros</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <script>
        var camas = "{{camas}}";
        var ocupadas = "{{ocupadas}}";
        var disponibles = "{{disponibles}}";
        document.getElementById('camasTotales').innerHTML = camas;
        document.getElementById('ocupadas').innerHTML = ocupadas;
        document.getElementById('disponibles').innerHTML = disponibles;
    </script>
{% endblock %}
