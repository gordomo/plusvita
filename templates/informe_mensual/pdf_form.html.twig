{% extends 'base.html.twig' %}

{% block title %}Generar PDF - Informe Mensual{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h4>Generar PDF del Informe Mensual</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <h5>Información del Informe</h5>
                            <p><strong>Paciente:</strong> {{ informeMensual.cliente.nombre }} {{ informeMensual.cliente.apellido }}</p>
                            <p><strong>Doctor:</strong> {% if informeMensual.doctor %} {{ informeMensual.doctor.nombre }} {{ informeMensual.doctor.apellido }} {% else %} Doctor desconocido {% endif %}</p>
                            <p><strong>Mes correspondiente:</strong> {{ informeMensual.mesCorrespondiente }}</p>
                            <p><strong>Fecha de creación:</strong> {{ informeMensual.fechaCreacion|date('d/m/Y') }}</p>
                        </div>

                        <form method="GET" action="{{ path('informe_mensual_pdf', {'id': informeMensual.id}) }}">
                            <div class="mb-3">
                                <label for="fecha" class="form-label">
                                    <strong>Fecha para el PDF:</strong>
                                    <small class="text-muted">(opcional - si no se selecciona, se usará la fecha de creación)</small>
                                </label>
                                <input type="date" 
                                       class="form-control" 
                                       id="fecha" 
                                       name="fecha" 
                                       value="{{ "now"|date('Y-m-d') }}"
                                       max="{{ "now"|date('Y-m-d') }}">
                                <div class="form-text">
                                    Selecciona la fecha que aparecerá en el PDF. Por defecto se usará la fecha actual.
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-file-pdf"></i> Generar PDF
                                </button>
                                <a href="{{ path('informe_mensual_show', {'id': informeMensual.id}) }}" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Volver al Informe
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .card {
            margin-top: 2rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
        .form-label strong {
            color: #495057;
        }
        .text-muted {
            font-size: 0.875rem;
        }
        .btn {
            padding: 0.75rem 1.5rem;
        }
        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }
        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }
    </style>
{% endblock %}
