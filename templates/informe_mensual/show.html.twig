{% extends 'base.html.twig' %}

{% block title %}Informe Mensual{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Informe Mensual</h3>
                        <div class="card-tools">
                            <a href="{{ path('doctor_historia') }}" class="btn btn-sm btn-default">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                            <a href="{{ path('informe_mensual_edit', {'id': informeMensual.id}) }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a href="{{ path('informe_mensual_pdf', {'id': informeMensual.id}) }}" class="btn btn-sm btn-danger" target="_blank">
                                <i class="fas fa-file-pdf"></i> Generar PDF
                            </a>
                            <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#deleteModal">
                                <i class="fas fa-trash"></i> Eliminar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Paciente:</strong> {{ informeMensual.cliente.nombre }} {{ informeMensual.cliente.apellido }}</p>
                                <p><strong>DNI:</strong> {{ informeMensual.cliente.dni }}</p>
                                <p><strong>Obra Social:</strong> {{ informeMensual.cliente.obraSocial ? informeMensual.cliente.obraSocial.nombre : 'No especificada' }}</p>
                            </div>
                            <div class="col-md-6 text-right">                            <p><strong>Fecha:</strong> {{ informeMensual.fechaCreacion|date("d/m/Y") }}</p>
                            <p><strong>Médico:</strong> {{ informeMensual.doctor.nombre }} {{ informeMensual.doctor.apellido }}</p>
                            </div>
                        </div>
                        <hr>
                        
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <p><strong>Lugar:</strong> {{ informeMensual.lugar }}</p>
                                <p><strong>Mes correspondiente:</strong> {{ informeMensual.mesCorrespondiente }}</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Fecha de creación:</strong> {{ informeMensual.fechaCreacion|date("d/m/Y H:i") }}</p>
                            </div>
                        </div>
                        
                        {% if informeMensual.escaras %}
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <h5>Escaras</h5>
                                <div class="p-3 bg-light">{{ informeMensual.escaras|raw }}</div>
                            </div>
                            {% if informeMensual.tipoEscaras %}
                            <div class="col-md-6">
                                <h5>Tipo de Escaras</h5>
                                <div class="p-3 bg-light">{{ informeMensual.tipoEscaras }}</div>
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.requerimientosEspeciales %}
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Requerimientos Especiales</h5>
                                <div class="p-3 bg-light">{{ informeMensual.requerimientosEspeciales|raw }}</div>
                            </div>
                        </div>
                        {% endif %}
                        
                        <div class="row mt-3">
                            {% if informeMensual.oxigeno %}
                            <div class="col-md-4">
                                <h5>O2</h5>
                                <div class="p-3 bg-light">{{ informeMensual.oxigeno }}</div>
                            </div>
                            {% endif %}
                            
                            {% if informeMensual.armBpap %}
                            <div class="col-md-4">
                                <h5>ARM/BPAP</h5>
                                <div class="p-3 bg-light">{{ informeMensual.armBpap }}</div>
                            </div>
                            {% endif %}
                            
                            {% if informeMensual.traqueo %}
                            <div class="col-md-4">
                                <h5>Traqueo</h5>
                                <div class="p-3 bg-light">{{ informeMensual.traqueo }}</div>
                            </div>
                            {% endif %}
                        </div>
                        
                        {% if informeMensual.alimentacion or informeMensual.tipoAlimentacion %}
                        <div class="row mt-3">
                            {% if informeMensual.alimentacion %}
                            <div class="col-md-6">
                                <h5>Alimentación</h5>
                                <div class="p-3 bg-light">{{ informeMensual.alimentacion }}</div>
                            </div>
                            {% endif %}
                            
                            {% if informeMensual.tipoAlimentacion %}
                            <div class="col-md-6">
                                <h5>Tipo de Alimentación</h5>
                                <div class="p-3 bg-light">{{ informeMensual.tipoAlimentacion }}</div>
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.imcMayor40 or informeMensual.aislamientoContacto %}
                        <div class="row mt-3">
                            {% if informeMensual.imcMayor40 %}
                            <div class="col-md-6">
                                <h5>IMC +40</h5>
                                <div class="p-3 bg-light">Sí</div>
                            </div>
                            {% endif %}
                            
                            {% if informeMensual.aislamientoContacto %}
                            <div class="col-md-6">
                                <h5>Aislamiento de Contacto</h5>
                                <div class="p-3 bg-light">{{ informeMensual.aislamientoContacto }}</div>
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.derivacionesSegundoNivel %}
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Derivaciones a II nivel</h5>
                                <div class="p-3 bg-light">{{ informeMensual.derivacionesSegundoNivel|raw }}</div>
                            </div>
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.antecedentes %}
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Antecedentes</h5>
                                <div class="p-3 bg-light">{{ informeMensual.antecedentes|raw }}</div>
                            </div>
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.estadoActual %}
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Estado Actual</h5>
                                <div class="p-3 bg-light" style="white-space: pre-line;">{{ informeMensual.estadoActual|nl2br|raw }}</div>
                            </div>
                        </div>
                        {% endif %}
                        
                        {% if informeMensual.pedidoMedico %}
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Pedido Médico</h5>
                                <div class="p-3 bg-light">{{ informeMensual.pedidoMedico|raw }}</div>
                            </div>
                        </div>
                        {% endif %}

                        <!-- Campos eliminados: evolucionMensual, medicacionActual, frecuenciaSesiones, estudiosComplementarios, proximasConsultas, observaciones -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación de eliminación -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminación</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    ¿Está seguro de que desea eliminar este informe mensual?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <a href="{{ path('informe_mensual_delete', {'id': informeMensual.id}) }}" class="btn btn-danger">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
