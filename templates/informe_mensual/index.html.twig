{% extends 'base.html.twig' %}

{% block title %}Informes Mensuales{% endblock %}
{% block panelTitle %}Informes Mensuales{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        .filter-card {
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .filter-card .card-header {
            background-color: #60b9b9;
            color: white;
            font-weight: 600;
        }
        
        .filter-section {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }
        
        .filter-section:last-child {
            border-bottom: none;
        }
        
        .filter-label {
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }
        
        .btn-filter {
            background-color: #b088be;
            border-color: #b088be;
        }
        
        .btn-filter:hover {
            background-color: #9870a6;
            border-color: #9870a6;
        }
        
        .btn-reset {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }
        
        .btn-reset:hover {
            background-color: #5a6268;
            border-color: #5a6268;
        }
        
        .table-reports th {
            background-color: #60b9b9;
            color: white;
            vertical-align: middle;
        }
        
        .table-reports td {
            vertical-align: middle;
        }
        
        .active-filter-badge {
            background-color: #b088be;
            color: white;
            font-size: 0.8rem;
            padding: 3px 8px;
            border-radius: 10px;
            margin-right: 5px;
            display: inline-block;
            margin-bottom: 5px;
        }
        
        .flatpickr-input {
            background-color: white !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <!-- Filtros -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card filter-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-filter mr-2"></i>Filtros
                            <button type="button" class="btn btn-sm btn-link text-white float-right" id="toggle-filters">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h5>
                    </div>
                    <div class="card-body p-0" id="filters-body">
                        <form id="filter-form" method="get" action="{{ path('informe_mensual_index') }}">
                            <div class="row m-0">
                                <!-- Filtro por Paciente -->
                                <div class="col-md-3 filter-section">
                                    <div class="filter-label">Paciente</div>
                                    <select name="paciente" class="form-control" id="paciente-filter">
                                        <option value="">Todos los pacientes</option>
                                        {% for paciente in pacientes %}
                                            <option value="{{ paciente.id }}" {% if filtros.pacienteId == paciente.id %}selected{% endif %}>
                                                {{ paciente.apellido }}, {{ paciente.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                
                                <!-- Filtro por Doctor (solo para administradores) -->
                                {% if is_granted('monthly_report.manage') %}
                                    <div class="col-md-3 filter-section">
                                        <div class="filter-label">Doctor</div>
                                        <select name="doctor" class="form-control" id="doctor-filter">
                                            <option value="">Todos los doctores</option>
                                            {% for doctor in doctores %}
                                                <option value="{{ doctor.id }}" {% if filtros.doctorId == doctor.id %}selected{% endif %}>
                                                    {{ doctor.apellido }}, {{ doctor.nombre }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                {% endif %}
                                
                                <!-- Filtro por Fecha -->
                                <div class="col-md-4 filter-section">
                                    <div class="filter-label">Rango de fechas</div>
                                    <div class="input-group">
                                        <input type="text" class="form-control datepicker" name="desde" id="desde" placeholder="Fecha desde" value="{{ filtros.desde }}" autocomplete="off">
                                        <div class="input-group-append input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-arrows-alt-h"></i></span>
                                        </div>
                                        <input type="text" class="form-control datepicker" name="hasta" id="hasta" placeholder="Fecha hasta" value="{{ filtros.hasta }}" autocomplete="off">
                                    </div>
                                </div>
                                
                                <!-- Botones de acción -->
                                <div class="col-md-2 filter-section d-flex align-items-end">
                                    <div class="btn-group w-100">
                                        <button type="submit" class="btn btn-filter">
                                            <i class="fas fa-search mr-1"></i> Filtrar
                                        </button>
                                        <a href="{{ path('informe_mensual_index') }}" class="btn btn-reset">
                                            <i class="fas fa-sync-alt mr-1"></i> Limpiar
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Filtros activos -->
                            {% if filtros.pacienteId or filtros.doctorId or filtros.desde or filtros.hasta %}
                            <div class="row m-0">
                                <div class="col-12 filter-section">
                                    <div class="filter-label">Filtros activos:</div>
                                    <div id="active-filters">
                                        {% if filtros.pacienteId %}
                                            {% for paciente in pacientes %}
                                                {% if paciente.id == filtros.pacienteId %}
                                                    <span class="active-filter-badge">
                                                        <i class="fas fa-user mr-1"></i> Paciente: {{ paciente.apellido }}, {{ paciente.nombre }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        
                                        {% if filtros.doctorId %}
                                            {% for doctor in doctores %}
                                                {% if doctor.id == filtros.doctorId %}
                                                    <span class="active-filter-badge">
                                                        <i class="fas fa-user-md mr-1"></i> Doctor: {{ doctor.apellido }}, {{ doctor.nombre }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        
                                        {% if filtros.desde %}
                                            <span class="active-filter-badge">
                                                <i class="fas fa-calendar-alt mr-1"></i> Desde: {{ filtros.desde }}
                                            </span>
                                        {% endif %}
                                        
                                        {% if filtros.hasta %}
                                            <span class="active-filter-badge">
                                                <i class="fas fa-calendar-alt mr-1"></i> Hasta: {{ filtros.hasta }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Tabla de informes -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="card-title mb-0">Listado de Informes</h3>
                            <div class="card-tools">
                                <a href="{{ path('doctor_historia') }}" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-arrow-left mr-1"></i> Volver a Historias
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        
                        {% if informes is empty %}
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle mr-2"></i>No hay informes mensuales registrados con los filtros seleccionados.
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-reports">
                                    <thead>
                                        <tr>
                                            <th width="15%">Fecha</th>
                                            <th width="30%">Paciente</th>
                                            <th width="30%">Doctor</th>
                                            <th width="15%">Mes correspondiente</th>
                                            <th width="10%">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for informe in informes %}
                                            <tr>
                                                <td>{{ informe.fechaCreacion|date('d/m/Y') }}</td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <i class="fas fa-user-circle mr-2 text-muted"></i>
                                                        <span>{{ informe.cliente.apellido }}, {{ informe.cliente.nombre }}</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <i class="fas fa-user-md mr-2 text-muted"></i>
                                                        <span>{{ informe.doctor.apellido }}, {{ informe.doctor.nombre }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ informe.mesCorrespondiente }}</td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('informe_mensual_show', {'id': informe.id}) }}" class="btn btn-sm btn-info mr-1" title="Ver detalle">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        {% if is_granted('monthly_report.manage') or (is_granted('monthly_report.edit') and informe.doctor.email == app.user.email) %}
                                                            <a href="{{ path('informe_mensual_edit', {'id': informe.id}) }}" class="btn btn-sm btn-primary mr-1" title="Editar informe">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                        {% endif %}
                                                        <a href="{{ path('informe_mensual_pdf', {'id': informe.id}) }}" class="btn btn-sm btn-danger" target="_blank" title="Generar PDF">
                                                            <i class="fas fa-file-pdf"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="text-muted">Total: {{ informes|length }} informe(s)</span>
                                <div>
                                    <button type="button" class="btn btn-success btn-sm" id="export-excel" title="Exportar a Excel">
                                        <i class="fas fa-file-excel mr-1"></i> Excel
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm" id="export-pdf" title="Exportar a PDF">
                                        <i class="fas fa-file-pdf mr-1"></i> PDF
                                    </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar selectores de fecha
            flatpickr(".datepicker", {
                locale: "es",
                dateFormat: "Y-m-d",
                allowInput: true,
                altFormat: "d/m/Y",
                altInput: true,
                disableMobile: true
            });
            
            // Manejar toggle de filtros
            document.getElementById('toggle-filters').addEventListener('click', function() {
                const filterBody = document.getElementById('filters-body');
                const icon = this.querySelector('i');
                
                if (filterBody.style.display === 'none') {
                    filterBody.style.display = 'block';
                    icon.classList.replace('fa-chevron-up', 'fa-chevron-down');
                } else {
                    filterBody.style.display = 'none';
                    icon.classList.replace('fa-chevron-down', 'fa-chevron-up');
                }
            });
            
            // Exportar a Excel
            document.getElementById('export-excel').addEventListener('click', function() {
                alert('Función de exportar a Excel será implementada próximamente.');
            });
            
            // Exportar a PDF
            document.getElementById('export-pdf').addEventListener('click', function() {
                alert('Función de exportar a PDF será implementada próximamente.');
            });
        });
    </script>
{% endblock %}

