{% extends 'base.html.twig' %}

{% block title %}Nuevo Informe Mensual{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Nuevo Informe Mensual</h3>
                        <div class="card-tools">
                            <a href="{{ path('doctor_historia') }}" class="btn btn-sm btn-default">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Paciente:</strong> {{ cliente.nombre }} {{ cliente.apellido }}</p>
                                <p><strong>DNI:</strong> {{ cliente.dni }}</p>
                                <p><strong>Obra Social:</strong> {{ cliente.obraSocial ? cliente.obraSocial.nombre : 'No especificada' }}</p>
                            </div>
                            <div class="col-md-6 text-right">
                                <p><strong>Fecha:</strong> {{ "now"|date("d/m/Y") }}</p>
                                <p><strong>Médico:</strong> {{ doctor ? doctor.apellido : 'No autenticado' }}</p>
                            </div>
                        </div>
                        <hr>

                        {{ form_start(form, {'attr': {'class': 'informe-mensual-form'}}) }}
                        

                        {{ form_rest(form) }}

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Guardar Informe
                                </button>
                            </div>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function() {
        // Inicializar Select2 para el campo de doctor
        if ($('.select2').length > 0) {
            $('.select2').select2({
                theme: 'bootstrap4',
                language: 'es',
                width: '100%',
                placeholder: 'Seleccione un doctor'
            });
        }
        // Si hay campos de fecha, inicializar datepicker
        if ($('.js-datepicker').length > 0) {
            $('.js-datepicker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true
            });
        }
        
        // Agregar funcionalidad para el campo de estado actual
        const estadoActualField = $('#informe_mensual_estadoActual');
        if (estadoActualField.length > 0) {
                    
            // Manejar el clic del botón regenerar
            $('#regenerarEstadoActual').on('click', function() {
                if (confirm('¿Está seguro de que desea regenerar la información del estado actual? Esto sobrescribirá cualquier cambio que haya realizado.')) {
                    // Recargar la página para obtener información fresca
                    window.location.reload();
                }
            });
            
            // Agregar indicador visual cuando el campo ha sido modificado
            let contenidoOriginal = estadoActualField.val();
            estadoActualField.on('input', function() {
                if ($(this).val() !== contenidoOriginal) {
                    $(this).addClass('border-warning');
                    if (!$(this).next('.campo-modificado').length) {
                        $(this).after('<small class="text-warning campo-modificado"><i class="fas fa-edit"></i> Campo modificado manualmente</small>');
                    }
                } else {
                    $(this).removeClass('border-warning');
                    $(this).next('.campo-modificado').remove();
                }
            });
        }
    });
</script>
{% endblock %}
