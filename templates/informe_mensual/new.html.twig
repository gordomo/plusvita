{% extends 'base.html.twig' %}

{% block title %}Nuevo Informe Mensual{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Nuevo Informe Mensual</h3>
                        <div class="card-tools">
                            <a href="{{ path('doctor_historia') }}" class="btn btn-sm btn-default">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Paciente:</strong> {{ cliente.nombre }} {{ cliente.apellido }}</p>
                                <p><strong>DNI:</strong> {{ cliente.dni }}</p>
                                <p><strong>Obra Social:</strong> {{ cliente.obraSocial ? cliente.obraSocial.nombre : 'No especificada' }}</p>
                            </div>
                            <div class="col-md-6 text-right">
                                <p><strong>Fecha:</strong> {{ "now"|date("d/m/Y") }}</p>
                                <p><strong>Médico:</strong> {{ doctor ? doctor.apellido : 'No autenticado' }}</p>
                            </div>
                        </div>
                        <hr>

                        {{ form_start(form, {'attr': {'class': 'informe-mensual-form'}}) }}
                        

                        {{ form_rest(form) }}

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Guardar Informe
                                </button>
                            </div>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    $(document).ready(function() {
        // Si hay campos de fecha, inicializar datepicker
        if ($('.js-datepicker').length > 0) {
            $('.js-datepicker').datepicker({
                format: 'dd/mm/yyyy',
                language: 'es',
                autoclose: true
            });
        }
        
        // Si hay campos de texto enriquecido, inicializar editor si summernote está disponible
        if ($('textarea').length > 0 && typeof $.fn.summernote !== 'undefined') {
            $('textarea').summernote({
                height: 100,
                toolbar: [
                    ['style', ['bold', 'italic', 'underline', 'clear']],
                    ['font', ['strikethrough']],
                    ['para', ['ul', 'ol']]
                ]
            });
        }
    });
</script>
{% endblock %}
