{% extends 'base.html.twig' %}

{% block title %}Contratos por Vencer{% endblock %}
{% block panelTitle %}Alertas de Vencimiento de Contratos{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-sm-12">
                <a href="{{ path('user_contract_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </div>
        </div>

        {% if expired is not empty %}
            <div class="alert alert-danger">
                <h5><i class="fas fa-exclamation-circle"></i> Contratos Vencidos ({{ expired|length }})</h5>
            </div>
            <table class="table table-striped table-danger">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Vencimiento</th>
                        <th>CBU</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contract in expired %}
                        <tr>
                            <td>{{ contract.user.nombre }} {{ contract.user.apellido }}</td>
                            <td>{{ contract.user.email }}</td>
                            <td>{{ contract.tipoLabel }}</td>
                            <td>
                                {{ contract.vtoContrato | date('d/m/Y') }}
                                <span class="badge badge-danger">
                                    Vencido hace {{ contract.vtoContrato.diff(date()).days }} días
                                </span>
                            </td>
                            <td>{{ contract.cbu ?? '-' }}</td>
                            <td>
                                <a href="{{ path('user_contract_by_user', {'id': contract.user.id}) }}" 
                                   class="btn btn-sm btn-info" title="Ver contratos">
                                    <i class="fas fa-list"></i>
                                </a>
                                <a href="{{ path('user_contract_new', {'userId': contract.user.id}) }}" 
                                   class="btn btn-sm btn-success" title="Renovar">
                                    <i class="fas fa-sync"></i> Renovar
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> No hay contratos vencidos
            </div>
        {% endif %}

        <hr>

        {% if expiring_this_month is not empty %}
            <div class="alert alert-warning">
                <h5><i class="fas fa-exclamation-triangle"></i> Contratos que Vencen Este Mes ({{ expiring_this_month|length }})</h5>
            </div>
            <table class="table table-striped table-warning">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Vencimiento</th>
                        <th>CBU</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contract in expiring_this_month %}
                        <tr>
                            <td>{{ contract.user.nombre }} {{ contract.user.apellido }}</td>
                            <td>{{ contract.user.email }}</td>
                            <td>{{ contract.tipoLabel }}</td>
                            <td>
                                {{ contract.vtoContrato | date('d/m/Y') }}
                                {% set daysLeft = date().diff(contract.vtoContrato).days %}
                                <span class="badge badge-warning">
                                    {{ daysLeft }} días restantes
                                </span>
                            </td>
                            <td>{{ contract.cbu ?? '-' }}</td>
                            <td>
                                <a href="{{ path('user_contract_by_user', {'id': contract.user.id}) }}" 
                                   class="btn btn-sm btn-info" title="Ver contratos">
                                    <i class="fas fa-list"></i>
                                </a>
                                <a href="{{ path('user_contract_new', {'userId': contract.user.id}) }}" 
                                   class="btn btn-sm btn-success" title="Renovar">
                                    <i class="fas fa-sync"></i> Renovar
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No hay contratos que venzan este mes
            </div>
        {% endif %}
    </div>
{% endblock %}
