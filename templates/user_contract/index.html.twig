{% extends 'base.html.twig' %}

{% block title %}Contratos Activos{% endblock %}
{% block panelTitle %}Gestión de Contratos{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-sm-6">
                <h4>Contratos Activos</h4>
            </div>
            <div class="col-sm-6 text-right">
                <a href="{{ path('user_contract_expiring') }}" class="btn btn-warning">
                    <i class="fas fa-exclamation-triangle"></i> Ver Vencimientos
                </a>
            </div>
        </div>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Tipo</th>
                    <th>Inicio</th>
                    <th>Vencimiento</th>
                    <th>CBU</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for contract in contracts %}
                    {% set isExpired = contract.isExpired %}
                    {% set expiresThisMonth = contract.expiresThisMonth %}
                    <tr {% if isExpired %}class="table-danger"{% elseif expiresThisMonth %}class="table-warning"{% endif %}>
                        <td>{{ contract.user.nombre }} {{ contract.user.apellido }}</td>
                        <td>{{ contract.user.email }}</td>
                        <td>{{ contract.tipoLabel }}</td>
                        <td>{{ contract.inicioContrato | date('d/m/Y') }}</td>
                        <td>
                            {% if contract.vtoContrato %}
                                {{ contract.vtoContrato | date('d/m/Y') }}
                            {% else %}
                                <span class="text-muted">Indefinido</span>
                            {% endif %}
                        </td>
                        <td>{{ contract.cbu ?? '-' }}</td>
                        <td>
                            {% if isExpired %}
                                <span class="badge badge-danger">Vencido</span>
                            {% elseif expiresThisMonth %}
                                <span class="badge badge-warning">Vence este mes</span>
                            {% else %}
                                <span class="badge badge-success">Vigente</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('user_contract_by_user', {'id': contract.user.id}) }}" 
                               class="btn btn-sm btn-info" title="Ver contratos del usuario">
                                <i class="fas fa-list"></i>
                            </a>
                            <a href="{{ path('user_contract_show', {'id': contract.id}) }}" 
                               class="btn btn-sm btn-primary" title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('user_contract_edit', {'id': contract.id}) }}" 
                               class="btn btn-sm btn-warning" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">No hay contratos activos</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
