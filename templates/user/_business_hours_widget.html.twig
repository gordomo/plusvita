{# Widget para gestionar múltiples rangos de horarios por día #}
<div class="business-hours-widget" data-day="{{ day }}" data-day-number="{{ dayNumber }}">
    <div class="time-ranges-container">
        {% for range in ranges %}
            <div class="time-range-row mb-2" data-range-index="{{ loop.index0 }}">
                <div class="row">
                    <div class="col-md-3">
                        <label class="small">Desde:</label>
                        <select name="doctor_{{ day }}_ranges[{{ loop.index0 }}][start]" class="form-control form-control-sm time-select">
                            <option value="">Seleccione hora</option>
                            {% for hour, label in hours %}
                                <option value="{{ hour }}" {% if range.start == hour %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="small">Hasta:</label>
                        <select name="doctor_{{ day }}_ranges[{{ loop.index0 }}][end]" class="form-control form-control-sm time-select">
                            <option value="">Seleccione hora</option>
                            {% for hour, label in hours %}
                                <option value="{{ hour }}" {% if range.end == hour %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="small">Termina al día siguiente:</label>
                        <div class="form-check mt-2">
                            <input type="checkbox" name="doctor_{{ day }}_ranges[{{ loop.index0 }}][nextDay]" 
                                   class="form-check-input next-day-checkbox" 
                                   value="1" 
                                   {% if range.nextDay %}checked{% endif %}>
                            <label class="form-check-label small">Sí</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-sm btn-danger remove-range-btn mt-4" {% if ranges|length == 1 %}disabled{% endif %}>
                            <i class="fas fa-trash"></i> Eliminar
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <button type="button" class="btn btn-sm btn-success add-range-btn mt-2">
        <i class="fas fa-plus"></i> Agregar otro horario
    </button>
</div>

