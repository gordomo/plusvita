{% extends 'base.html.twig' %}

{% block title %}Medicación - {{ cliente.nombre }} {{ cliente.apellido }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .horario-card {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            margin-bottom: 20px;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .horario-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }
        
        .horario-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 15px 20px;
            border-bottom: 1px solid #dee2e6;
            border-radius: 11px 11px 0 0;
        }
        
        .horario-body {
            padding: 20px;
        }
        
        .horario-item {
            display: flex;
            align-items: center;
            padding: 15px 10px;
            border-bottom: 1px solid #f1f3f4;
            transition: all 0.2s ease;
        }
        
        .horario-item:hover {
            background-color: #f8f9fa;
        }
        
        .horario-item:last-child {
            border-bottom: none;
        }
        
        .horario-time {
            min-width: 100px;
            font-weight: 600;
            font-size: 1.2em;
            text-align: center;
            background-color: #f8f9fa;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
            margin-right: 15px;
        }
        
        .horario-checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            margin: 0 15px;
        }
        
        .horario-checkbox input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
        
        .horario-checkbox input[type="checkbox"]:disabled {
            cursor: not-allowed;
            opacity: 0.5;
        }
        
        .horario-details {
            flex-grow: 1;
        }
        
        .horario-status {
            margin-left: auto;
            min-width: 120px;
            text-align: right;
        }
        
        .en-ventana {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            border-radius: 0 8px 8px 0;
        }
        
        .en-ventana .horario-time {
            background-color: #ffc107;
            color: #212529;
            border-color: #ffc107;
            font-weight: 700;
        }
        
        .administrado {
            background-color: #d4edda;
            border-left: 4px solid #28a745;
            border-radius: 0 8px 8px 0;
        }
        
        .administrado .horario-time {
            background-color: #28a745;
            color: white;
            border-color: #28a745;
        }
        
        .fuera-ventana {
            background-color: #f8f9fa;
            color: #6c757d;
            border-radius: 0 8px 8px 0;
        }
        
        .fuera-ventana .horario-time {
            background-color: #e9ecef;
            color: #6c757d;
            border-color: #ced4da;
        }
        
        .medicamento-nombre {
            font-weight: 600;
            color: #495057;
        }
        
        .medicamento-dosis {
            font-size: 0.9em;
            color: #6c757d;
        }
        
        .resumen-dia {
            background: linear-gradient(45deg, #007bff, #0056b3);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,123,255,0.3);
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            margin-bottom: 8px;
        }
        
        .stat-label {
            font-size: 0.95rem;
            opacity: 0.95;
            font-weight: 500;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        }
        
        .btn-revertir {
            font-size: 0.8em;
            padding: 2px 8px;
        }
        
        .no-medicacion {
            text-align: center;
            padding: 40px;
            color: #6c757d;
        }
        
        .alert-info-custom {
            background-color: #e7f3ff;
            border: 1px solid #b3d9ff;
            color: #0c5460;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 25px;
            border-left: 4px solid #007bff;
        }
        
        .signos-vitales-card {
            border: 2px solid #17a2b8;
            border-radius: 12px;
            margin-bottom: 25px;
            background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
            box-shadow: 0 4px 12px rgba(23, 162, 184, 0.2);
        }
        
        .signos-vitales-header {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            color: white;
            padding: 20px;
            border-radius: 10px 10px 0 0;
        }
        
        .signos-vitales-body {
            padding: 20px;
        }
        
        .signos-vitales-bloqueado {
            border-color: #dc3545;
            background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%);
        }
        
        .signos-vitales-bloqueado .signos-vitales-header {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        }
        
        .signos-vitales-completado {
            border-color: #28a745;
            background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
        }
        
        .signos-vitales-completado .signos-vitales-header {
            background: linear-gradient(135deg, #28a745 0%, #218838 100%);
        }
        
        .indicaciones-pendientes-list {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin-top: 15px;
            border-radius: 5px;
        }
        
        .indicaciones-pendientes-list ul {
            margin-bottom: 0;
            padding-left: 20px;
        }
        
        .signos-vitales-historial {
            background-color: #f8f9fa;
            border-left: 4px solid #17a2b8;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }
        
        .signos-vitales-item {
            background-color: white;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
        }
        
        .signos-vitales-item:last-child {
            margin-bottom: 0;
        }
        
        .signos-vitales-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #e9ecef;
        }
        
        .signos-vitales-item-content {
            color: #495057;
            white-space: pre-wrap;
        }
        
        .signos-vitales-item-meta {
            font-size: 0.85em;
            color: #6c757d;
        }
    </style>
{% endblock %}

{% block panelTitle %}
    <div id="head">
        <h3>
            <i class="fas fa-syringe mr-2"></i>
            Kardex
        </h3>
        <p class="mb-0">
            <strong class="text-capitalize">{{ cliente.nombre }} {{ cliente.apellido }}</strong> 
            - H.C.: {{ cliente.id }} 
            - Fecha: {{ fechaHoy|date('d/m/Y') }}
        </p>
    </div>
{% endblock %}

{% block titleButtons %}
    <div class="d-flex">
        <a href="javascript:history.back()" class="btn btn-outline-secondary mr-2">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
        <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-outline-primary mr-2">
            <i class="fas fa-pills"></i> Ver Indicaciones
        </a>
        {% if is_granted('patient.indication') %}
        <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-outline-success mr-2">
            <i class="fas fa-plus"></i> Agregar Indicación
        </a>
        {% endif %}
        <button class="btn btn-outline-warning mr-2" onclick="regenerarHorarios({{ cliente.id }})">
            <i class="fas fa-cogs"></i> Regenerar Horarios
        </button>
        <button class="btn btn-success" onclick="location.reload()">
            <i class="fas fa-sync"></i> Actualizar
        </button>
    </div>
{% endblock %}

{% block body %}
    <!-- Resumen del día -->
    <div class="resumen-dia">
        <div class="row" id="resumenDia">
            <div class="col-md-3 stat-item">
                <div class="stat-number" id="totalMedicaciones">-</div>
                <div class="stat-label">Total del día</div>
            </div>
            <div class="col-md-3 stat-item">
                <div class="stat-number text-success" id="administradas">-</div>
                <div class="stat-label">Administradas</div>
            </div>
            <div class="col-md-3 stat-item">
                <div class="stat-number text-warning" id="pendientes">-</div>
                <div class="stat-label">Pendientes</div>
            </div>
            <div class="col-md-3 stat-item">
                <div class="stat-number" id="porcentaje">-</div>
                <div class="stat-label">% Completado</div>
            </div>
        </div>
    </div>
    
    <!-- Información sobre ventana horaria -->
    <div class="alert-info-custom">
        <i class="fas fa-info-circle mr-2"></i>
        <strong>Ventana de administración:</strong> Puede marcar la medicación como administrada desde 2 horas antes hasta 2 horas después del horario programado.
        Los horarios resaltados en <span class="badge badge-warning">amarillo</span> están en ventana de administración actualmente.
    </div>
    
    <!-- Sección de Signos Vitales (solo para pacientes internados) -->
    {% if estaInternado %}
        <div class="signos-vitales-card {% if signosVitalesCompletados %}signos-vitales-completado{% elseif signosVitalesBloqueados %}signos-vitales-bloqueado{% endif %}">
            <div class="signos-vitales-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-heartbeat mr-2"></i>
                        Medir Signos Vitales - Turno {{ turnoService.obtenerNombreTurno(turnoActual) }}
                    </h4>
                </div>
                
            </div>
            <div class="signos-vitales-body">
                {% if signosVitalesDelTurno|length > 0 %}
                    <div class="signos-vitales-historial">
                        <h6 class="mb-3">
                            <i class="fas fa-history mr-2"></i>
                            Tomas Registradas en este Turno ({{ signosVitalesDelTurno|length }})
                        </h6>
                        {% for sv in signosVitalesDelTurno %}
                            <div class="signos-vitales-item">
                                <div class="signos-vitales-item-header">
                                    <div>
                                        <strong>
                                            <i class="fas fa-heartbeat text-danger mr-2"></i>
                                            Toma #{{ loop.index }}
                                        </strong>
                                    </div>
                                    <div class="signos-vitales-item-meta">
                                        <i class="fas fa-clock mr-1"></i>
                                        {{ sv.fechaHoraRegistro|date('d/m/Y H:i') }}
                                        {% if usuariosSignosVitales[sv.id] is defined %}
                                            <span class="ml-2">
                                                <i class="fas fa-user mr-1"></i>
                                                {{ usuariosSignosVitales[sv.id].nombre }} {{ usuariosSignosVitales[sv.id].apellido }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="signos-vitales-item-content">
                                    {{ sv.notas|nl2br }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                
                {% if signosVitalesBloqueados %}
                    <div class="d-flex align-items-start">
                        <i class="fas fa-lock fa-lg mr-3 mt-1"></i>
                            <div class="flex-grow-1">
                                <p class="mb-2">
                                    <strong>Los signos vitales están bloqueados</strong> porque hay indicaciones pendientes en este turno que deben completarse primero.
                                </p>
                                
                                <div class="mb-0">
                                    <strong class="d-block mb-2">Indicaciones pendientes en el turno:</strong>
                                    <ul class="mb-0 pl-3" style="list-style-type: none;">
                                        {% for horario in indicacionesPendientesEnTurno %}
                                            <li class="mb-1">
                                                <i class="fas fa-pills mr-2"></i>
                                                {% set indicacion = horario.indicacion %}
                                                {% if indicacion.tipoIndicacion == 'medicamento' and consumiblesArray[indicacion.consumibleId] is defined %}
                                                    <strong>{{ consumiblesArray[indicacion.consumibleId] }}</strong>
                                                {% elseif indicacion.procedimientoPersonalizado %}
                                                    <strong>{{ indicacion.procedimientoPersonalizado }}</strong>
                                                {% else %}
                                                    <strong>Indicación sin especificar</strong>
                                                {% endif %}
                                                <span class="badge badge-light ml-2">
                                                    <i class="fas fa-clock"></i> Horario: {{ horario.horario|date('H:i') }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                    </div>
                {% endif %}
                
                {% if not signosVitalesBloqueados %}
                    <div class="mt-3">
                        {% if signosVitalesDelTurno|length > 0 %}
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle mr-2"></i>
                                Puede registrar una nueva toma de signos vitales para este turno si es necesario.
                            </div>
                        {% else %}
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle mr-2"></i>
                                <strong>Instrucciones:</strong> Debe medir los signos vitales del paciente y registrar las notas correspondientes.
                                Una vez completado, será obligatorio ingresar una evolución de enfermería.
                            </div>
                        {% endif %}
                        
                        <form id="formSignosVitales" onsubmit="registrarSignosVitales(event)">
                            <div class="form-group">
                                <label for="notasSignosVitales">
                                    <strong>Notas de Signos Vitales:</strong>
                                    <small class="text-muted">(Temperatura, presión arterial, frecuencia cardíaca, frecuencia respiratoria, etc.)</small>
                                </label>
                                <textarea 
                                    class="form-control" 
                                    id="notasSignosVitales" 
                                    name="notas" 
                                    rows="4" 
                                    required
                                    placeholder="Ejemplo: TA: 120/80 mmHg, FC: 72 lpm, FR: 16 rpm, Temp: 36.5°C, Sat O2: 98%"></textarea>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save mr-2"></i>
                                {% if signosVitalesDelTurno|length > 0 %}
                                    Registrar Nueva Toma
                                {% else %}
                                    Registrar Signos Vitales
                                {% endif %}
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
    
    {% if horariosPorIndicacion|length > 0 %}
        <!-- Listado de medicaciones por indicación -->
        {% for indicacionId, data in horariosPorIndicacion %}
            <div class="horario-card">
                <div class="horario-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">
                                {% if data.indicacion.tipoIndicacion == 'medicamento' and consumiblesArray[data.indicacion.consumibleId] is defined %}
                                    <i class="fas fa-pills text-primary mr-2"></i>
                                    {{ consumiblesArray[data.indicacion.consumibleId] }}
                                {% elseif data.indicacion.procedimientoPersonalizado %}
                                    <i class="fas fa-procedures text-success mr-2"></i>
                                    {{ data.indicacion.procedimientoPersonalizado }}
                                {% else %}
                                    <i class="fas fa-question-circle text-secondary mr-2"></i>
                                    Indicación sin especificar
                                {% endif %}
                            </h5>
                            <small class="text-muted">
                                {% if data.indicacion.tipoIndicacion == 'medicamento' %}
                                    Dosis: {{ data.indicacion.cantidad }} {{ data.indicacion.unidadMedida }} - 
                                {% endif %}
                                Frecuencia: {{ data.indicacion.frecuencia|default('N/D') }}
                                {% if data.indicacion.notas %}
                                    <br><em>{{ data.indicacion.notas }}</em>
                                {% endif %}
                            </small>
                        </div>
                        <div>
                            {% if data.indicacion.estadoSuspendido %}
                                <span class="badge badge-warning">Suspendida</span>
                            {% else %}
                                <span class="badge badge-success">Activa</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="horario-body">
                    {% if data.sin_horarios is defined and data.sin_horarios %}
                        <!-- Indicación sin horarios -->
                        {% if data.indicacion.frecuencia == 'sos' %}
                            <div class="horario-item">
                                <div class="horario-time">
                                    <span class="badge badge-info">SOS</span>
                                </div>
                                <div class="horario-checkbox">
                                    <input type="checkbox" 
                                           class="form-check-input horario-check"
                                           title="Administrar según necesidad">
                                </div>
                                <div class="horario-details">
                                    <div class="medicamento-nombre">
                                        {% if data.indicacion.tipoIndicacion == 'medicamento' %}
                                            {{ data.indicacion.cantidad }} {{ data.indicacion.unidadMedida }}
                                        {% else %}
                                            Procedimiento/Control
                                        {% endif %}
                                    </div>
                                    <div class="medicamento-dosis text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Administrar según necesidad
                                    </div>
                                </div>
                                <div class="horario-status">
                                    <span class="badge badge-info">
                                        <i class="fas fa-hand-paper"></i>
                                        Según necesidad
                                    </span>
                                </div>
                            </div>
                        {% else %}
                            <div class="horario-item en-ventana">
                                <div class="horario-time">
                                    <input type="time" 
                                           class="form-control form-control-sm" 
                                           id="primeraToma_{{ data.indicacion.id }}"
                                           value="{{ "now"|date("H:i") }}"
                                           style="width: 100px;">
                                </div>
                                <div class="horario-checkbox">
                                    <input type="checkbox" 
                                           id="check_primeraToma_{{ data.indicacion.id }}"
                                           class="form-check-input"
                                           onclick="registrarPrimeraToma({{ data.indicacion.id }}, {{ cliente.id }})">
                                </div>
                                <div class="horario-details">
                                    <div class="medicamento-nombre">
                                        {% if data.indicacion.tipoIndicacion == 'medicamento' %}
                                            {{ data.indicacion.cantidad }} {{ data.indicacion.unidadMedida }}
                                        {% else %}
                                            Procedimiento/Control
                                        {% endif %}
                                    </div>
                                    <div class="medicamento-dosis text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Primera toma - Los siguientes horarios se generarán cada {{ data.indicacion.frecuencia }}
                                    </div>
                                </div>
                                <div class="horario-status">
                                    <span class="badge badge-warning">
                                        <i class="fas fa-clock"></i>
                                        Primera toma pendiente
                                    </span>
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        {% for horario in data.horarios %}
                            <div class="horario-item 
                                        {% if horario.administrado %}administrado
                                        {% elseif horario.id in horariosEnVentanaIds %}en-ventana
                                        {% else %}fuera-ventana{% endif %}">
                                
                                <div class="horario-time">
                                    {{ horario.horario|date('H:i') }}
                                </div>
                                
                                <div class="horario-checkbox">
                                    {% if horario.administrado %}
                                        <input type="checkbox" 
                                               checked 
                                               disabled
                                               class="form-check-input">
                                    {% elseif horario.id in horariosEnVentanaIds %}
                                        <input type="checkbox" 
                                               id="horario_{{ horario.id }}"
                                               class="form-check-input horario-check"
                                               data-horario-id="{{ horario.id }}">
                                    {% else %}
                                        <input type="checkbox" 
                                               disabled
                                               class="form-check-input"
                                               title="Fuera de ventana horaria">
                                    {% endif %}
                                </div>
                                
                                <div class="horario-details">
                                    <div class="medicamento-nombre">
                                        {% if data.indicacion.tipoIndicacion == 'medicamento' %}
                                            {{ data.indicacion.cantidad }} {{ data.indicacion.unidadMedida }}
                                        {% else %}
                                            Procedimiento/Control
                                        {% endif %}
                                    </div>
                                    {% if horario.observaciones %}
                                        <div class="medicamento-dosis">
                                            <i class="fas fa-comment text-info"></i>
                                            {{ horario.observaciones }}
                                        </div>
                                    {% endif %}
                                </div>
                                
                                <div class="horario-status">
                                    {% if horario.administrado %}
                                        <div>
                                            <span class="badge badge-success">
                                                <i class="fas fa-check"></i>
                                                Administrado
                                            </span>
                                            <div class="text-muted small">
                                                {{ horario.fechaAdministracion|date('H:i') }}
                                            </div>
                                            <button class="btn btn-outline-secondary btn-revertir mt-1" 
                                                    onclick="revertirMedicacion({{ horario.id }})"
                                                    title="Revertir administración">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                        </div>
                                    {% elseif horario.id in horariosEnVentanaIds %}
                                        <span class="badge badge-warning">
                                            <i class="fas fa-clock"></i>
                                            Disponible hasta {{ ventanasHorarias[horario.id].fin|date('H:i') }}
                                        </span>
                                    {% elseif data.indicacion.frecuencia == 'sos' %}
                                        <span class="badge badge-info">
                                            <i class="fas fa-hand-paper"></i>
                                            SOS
                                        </span>
                                    {% else %}
                                        {% set proximo_horario = ventanasHorarias[horario.id].inicio|date('H:i') %}
                                        <span class="badge badge-secondary">
                                            <i class="fas fa-lock"></i>
                                            Bloqueado hasta {{ proximo_horario }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="no-medicacion">
            <i class="fas fa-pills fa-3x text-muted mb-3"></i>
            <h4>No hay medicación programada para hoy</h4>
            <p class="text-muted">
                Este paciente no tiene horarios de medicación programados para el día {{ fechaHoy|date('d/m/Y') }}.
            </p>
            {% if is_granted('patient.indication') %}
            <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Agregar Indicación
            </a>
            {% endif %}
        </div>
    {% endif %}

    <!-- Input oculto para cliente ID -->
    <input type="hidden" id="clienteId" value="{{ cliente.id }}">

    <!-- Modal para Evolución de Enfermería -->
    <div class="modal fade" id="modalEvolucionEnfermeria" tabindex="-1" role="dialog" aria-labelledby="modalEvolucionEnfermeriaLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalEvolucionEnfermeriaLabel">
                        <i class="fas fa-file-medical mr-2"></i>
                        Evolución de Enfermería
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-2"></i>
                        Los signos vitales fueron registrados correctamente. Por favor, complete la evolución de enfermería.
                    </div>
                    <form id="formEvolucionEnfermeria">
                        <div class="form-group">
                            <label for="evolucionDescripcion">
                                <strong>Evolución de Enfermería:</strong>
                            </label>
                            <textarea 
                                class="form-control" 
                                id="evolucionDescripcion" 
                                name="descripcion" 
                                rows="6" 
                                required
                                placeholder="Ingrese la evolución de enfermería..."></textarea>
                            <small class="form-text text-muted">
                                Describa la evolución del paciente, observaciones, cambios, etc.
                            </small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-lg" id="btnGuardarEvolucion">
                        <i class="fas fa-save mr-2"></i>Guardar Evolución
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Cargar resumen del día
            cargarResumenDia();
            
            // Manejar checkboxes de horarios
            $('.horario-check').change(function() {
                const horarioId = $(this).data('horario-id');
                const isChecked = $(this).is(':checked');
                
                if (isChecked) {
                    administrarMedicacion(horarioId);
                }
            });
            
            // Manejar guardar evolución de enfermería
            $('#btnGuardarEvolucion').click(function() {
                guardarEvolucionEnfermeria();
            });
            
            // Prevenir cerrar el modal con ESC o click fuera
            $('#modalEvolucionEnfermeria').on('hide.bs.modal', function (e) {
                // No permitir cerrar hasta que se guarde la evolución
                return false;
            });
        });
        
        function cargarResumenDia() {
            const clienteId = $('#clienteId').val();
            
            $.ajax({
                url: `{{ path('medicacion_resumen_dia', {'id': '__ID__'}) }}`.replace('__ID__', clienteId),
                method: 'GET',
                success: function(data) {
                    $('#totalMedicaciones').text(data.total);
                    $('#administradas').text(data.administrados);
                    $('#pendientes').text(data.pendientes);
                    $('#porcentaje').text(data.porcentaje + '%');
                },
                error: function() {
                    console.error('Error cargando resumen del día');
                }
            });
        }
        
        function administrarMedicacion(horarioId) {
            // Pedir observaciones opcionales
            const observaciones = prompt("Observaciones (opcional):");
            if (observaciones === null) {
                // Usuario canceló, desmarcar checkbox
                $(`#horario_${horarioId}`).prop('checked', false);
                return;
            }
            
            $.ajax({
                url: `{{ path('medicacion_administrar', {'id': '__ID__'}) }}`.replace('__ID__', horarioId),
                method: 'POST',
                data: {
                    observaciones: observaciones
                },
                success: function(response) {
                    if (response.success) {
                        // Mostrar mensaje de éxito
                        mostrarMensaje('success', response.message);
                        
                        // Recargar página para actualizar estado
                        setTimeout(() => {
                            location.reload();
                        }, 1500);
                    } else {
                        // Mostrar error y desmarcar
                        mostrarMensaje('error', response.message);
                        $(`#horario_${horarioId}`).prop('checked', false);
                    }
                },
                error: function() {
                    mostrarMensaje('error', 'Error de comunicación con el servidor');
                    $(`#horario_${horarioId}`).prop('checked', false);
                }
            });
        }
        
        function revertirMedicacion(horarioId) {
            if (confirm('¿Está seguro de que desea revertir esta administración?')) {
                $.ajax({
                    url: `{{ path('medicacion_revertir', {'id': '__ID__'}) }}`.replace('__ID__', horarioId),
                    method: 'POST',
                    success: function(response) {
                        if (response.success) {
                            mostrarMensaje('success', response.message);
                            setTimeout(() => {
                                location.reload();
                            }, 1500);
                        } else {
                            mostrarMensaje('error', response.message);
                        }
                    },
                    error: function() {
                        mostrarMensaje('error', 'Error de comunicación con el servidor');
                    }
                });
            }
        }
        
        function registrarPrimeraToma(indicacionId, clienteId) {
            const checkbox = $(`#check_primeraToma_${indicacionId}`);
            if (!checkbox.is(':checked')) {
                return;
            }

            const hora = $(`#primeraToma_${indicacionId}`).val();
            if (!hora) {
                mostrarMensaje('error', 'Debe seleccionar una hora para la primera toma');
                checkbox.prop('checked', false);
                return;
            }
            
            // Pedir observaciones opcionales
            const observaciones = prompt("Observaciones (opcional):");
            if (observaciones === null) {
                // Usuario canceló, desmarcar checkbox
                checkbox.prop('checked', false);
                return;
            }
            
            // Mostrar loading
            mostrarMensaje('info', '<i class="fas fa-spinner fa-spin mr-2"></i>Registrando primera toma...');
            
            $.ajax({
                url: `{{ path('medicacion_registrar_primera_toma', {'id': '__ID__'}) }}`.replace('__ID__', indicacionId),
                method: 'POST',
                data: {
                    hora: hora,
                    observaciones: observaciones
                },
                success: function(response) {
                    if (response.success) {
                        mostrarMensaje('success', response.message);
                        // Recargar página después de 2 segundos
                        setTimeout(() => {
                            location.reload();
                        }, 2000);
                    } else {
                        mostrarMensaje('error', response.message);
                        checkbox.prop('checked', false);
                    }
                },
                error: function() {
                    mostrarMensaje('error', 'Error de comunicación con el servidor');
                    checkbox.prop('checked', false);
                }
            });
        }
        
        function mostrarMensaje(tipo, mensaje) {
            let alertClass, icono;
            
            switch(tipo) {
                case 'success':
                    alertClass = 'alert-success';
                    icono = 'fa-check-circle';
                    break;
                case 'warning':
                    alertClass = 'alert-warning';
                    icono = 'fa-exclamation-triangle';
                    break;
                case 'info':
                    alertClass = 'alert-info';
                    icono = 'fa-info-circle';
                    break;
                default:
                    alertClass = 'alert-danger';
                    icono = 'fa-exclamation-circle';
            }
            
            const alert = $(`
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    <i class="fas ${icono} mr-2"></i>
                    ${mensaje}
                    <button type="button" class="close" data-dismiss="alert">
                        <span>&times;</span>
                    </button>
                </div>
            `);
            
            // Remover alertas anteriores del mismo tipo para evitar acumulación
            // EXCLUIR los alerts dentro del bloque de signos vitales
            $('.alert').not('.signos-vitales-body .alert').remove();
            
            // Insertar al inicio del body
            $('.resumen-dia').after(alert);
            
            // Auto-remover después de 8 segundos (más tiempo para leer los mensajes largos)
            setTimeout(() => {
                alert.fadeOut();
            }, 8000);
        }
        
        function registrarSignosVitales(event) {
            event.preventDefault();
            
            const clienteId = $('#clienteId').val();
            const notas = $('#notasSignosVitales').val();
            
            if (!notas || notas.trim() === '') {
                mostrarMensaje('error', 'Debe ingresar las notas de los signos vitales');
                return;
            }
            
            // Confirmar antes de registrar
            if (!confirm('¿Confirma que desea registrar los signos vitales? Después deberá completar la evolución de enfermería.')) {
                return;
            }
            
            $.ajax({
                url: `{{ path('medicacion_registrar_signos_vitales', {'id': '__ID__'}) }}`.replace('__ID__', clienteId),
                method: 'POST',
                data: {
                    notas: notas
                },
                success: function(response) {
                    if (response.success) {
                        if (response.requiere_evolucion) {
                            // Mostrar modal para evolución de enfermería
                            $('#evolucionDescripcion').val('');
                            $('#modalEvolucionEnfermeria').modal('show');
                        } else {
                            mostrarMensaje('success', response.message);
                            setTimeout(() => {
                                location.reload();
                            }, 2000);
                        }
                    } else {
                        mostrarMensaje('error', response.message);
                    }
                },
                error: function(xhr) {
                    let mensaje = 'Error de comunicación con el servidor';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        mensaje = xhr.responseJSON.message;
                    }
                    mostrarMensaje('error', mensaje);
                }
            });
        }
        
        function guardarEvolucionEnfermeria() {
            const clienteId = $('#clienteId').val();
            const descripcion = $('#evolucionDescripcion').val();
            
            if (!descripcion || descripcion.trim() === '') {
                mostrarMensaje('error', 'Debe ingresar la evolución de enfermería');
                return;
            }
            
            // Deshabilitar botón mientras se guarda
            $('#btnGuardarEvolucion').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Guardando...');
            
            $.ajax({
                url: `{{ path('medicacion_guardar_evolucion_enfermeria', {'id': '__ID__'}) }}`.replace('__ID__', clienteId),
                method: 'POST',
                data: {
                    descripcion: descripcion
                },
                success: function(response) {
                    if (response.success) {
                        mostrarMensaje('success', response.message);
                        // Cerrar modal y recargar página
                        $('#modalEvolucionEnfermeria').modal('hide');
                        setTimeout(() => {
                            location.reload();
                        }, 1500);
                    } else {
                        mostrarMensaje('error', response.message);
                        $('#btnGuardarEvolucion').prop('disabled', false).html('<i class="fas fa-save mr-2"></i>Guardar Evolución');
                    }
                },
                error: function(xhr) {
                    let mensaje = 'Error de comunicación con el servidor';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        mensaje = xhr.responseJSON.message;
                    }
                    mostrarMensaje('error', mensaje);
                    $('#btnGuardarEvolucion').prop('disabled', false).html('<i class="fas fa-save mr-2"></i>Guardar Evolución');
                }
            });
        }
    </script>
{% endblock %}
