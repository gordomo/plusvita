{% extends 'base.html.twig' %}

{% block title %}Ver Permiso{% endblock %}
{% block panelTitle %}Detalle del Permiso{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-key mr-2"></i>
                        {{ permission.displayName }}
                    </h5>
                    <div>
                        <a href="{{ path('permission_edit', {'id': permission.id}) }}" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="30%">Nombre del Permiso</th>
                                <td><code class="text-primary">{{ permission.name }}</code></td>
                            </tr>
                            <tr>
                                <th>Nombre para Mostrar</th>
                                <td>{{ permission.displayName }}</td>
                            </tr>
                            <tr>
                                <th>Categoría</th>
                                <td>
                                    <span class="badge badge-info">{{ permission.category }}</span>
                                </td>
                            </tr>
                            <tr>
                                <th>Descripción</th>
                                <td>{{ permission.description ?? 'Sin descripción' }}</td>
                            </tr>
                            <tr>
                                <th>Estado</th>
                                <td>
                                    {% if permission.isActive %}
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Activo
                                        </span>
                                    {% else %}
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times"></i> Inactivo
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Fecha de Creación</th>
                                <td>{{ permission.createdAt|date('d/m/Y H:i:s') }}</td>
                            </tr>
                            {% if permission.updatedAt %}
                            <tr>
                                <th>Última Actualización</th>
                                <td>{{ permission.updatedAt|date('d/m/Y H:i:s') }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <th>Roles que tienen este permiso</th>
                                <td>
                                    {% if permission.roles|length > 0 %}
                                        {% for role in permission.roles %}
                                            <span class="badge badge-primary mr-1">{{ role.displayName }}</span>
                                        {% endfor %}
                                    {% else %}
                                        <em class="text-muted">No asignado a ningún rol</em>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('permission_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver a la Lista
                        </a>
                        <button type="button" class="btn btn-danger" onclick="deletePermission()">
                            <i class="fas fa-trash"></i> Eliminar Permiso
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="delete-form" method="post" action="{{ path('permission_delete', {'id': permission.id}) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ permission.id) }}">
    <input type="hidden" name="_method" value="DELETE">
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function deletePermission() {
            if (confirm('¿Estás seguro de que quieres eliminar este permiso? Esta acción no se puede deshacer.')) {
                document.getElementById('delete-form').submit();
            }
        }
    </script>
{% endblock %}
