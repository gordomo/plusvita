{% extends 'base.html.twig' %}

{% block title %}Permisos del Sistema{% endblock %}
{% block panelTitle %}Permisos del Sistema{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .category-section {
            margin-bottom: 2rem;
        }
        .category-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem;
            border-radius: 0.5rem 0.5rem 0 0;
            margin-bottom: 0;
        }
        .permission-table {
            margin-bottom: 0;
        }
        .badge-category {
            font-size: 0.75rem;
            padding: 0.35rem 0.65rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a href="{{ path('role_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Volver a Roles
                    </a>
                </div>
                <div>
                    <a href="{{ path('permission_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nuevo Permiso
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% if permissions|length > 0 %}
        {% set grouped_permissions = {} %}
        {% for permission in permissions %}
            {% set category = permission.category ?? 'Sin Categoría' %}
            {% if grouped_permissions[category] is not defined %}
                {% set grouped_permissions = grouped_permissions|merge({(category): []}) %}
            {% endif %}
            {% set grouped_permissions = grouped_permissions|merge({(category): grouped_permissions[category]|merge([permission])}) %}
        {% endfor %}

        {% for category, perms in grouped_permissions %}
        <div class="category-section">
            <div class="card">
                <div class="category-header">
                    <h5 class="mb-0">
                        <i class="fas fa-folder-open mr-2"></i>
                        {{ category }}
                        <span class="badge badge-light ml-2">{{ perms|length }}</span>
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table permission-table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th width="20%">Nombre</th>
                                <th width="25%">Nombre para Mostrar</th>
                                <th width="35%">Descripción</th>
                                <th width="10%" class="text-center">Estado</th>
                                <th width="10%" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for permission in perms %}
                            <tr>
                                <td>
                                    <code class="text-primary">{{ permission.name }}</code>
                                </td>
                                <td>{{ permission.displayName }}</td>
                                <td>
                                    <small class="text-muted">{{ permission.description }}</small>
                                </td>
                                <td class="text-center">
                                    {% if permission.isActive %}
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Activo
                                        </span>
                                    {% else %}
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times"></i> Inactivo
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('permission_show', {'id': permission.id}) }}" 
                                           class="btn btn-outline-info" 
                                           title="Ver">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('permission_edit', {'id': permission.id}) }}" 
                                           class="btn btn-outline-primary" 
                                           title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-outline-danger" 
                                                title="Eliminar"
                                                onclick="deletePermission({{ permission.id }})">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-key fa-3x text-muted mb-3"></i>
                <h4>No hay permisos configurados</h4>
                <p class="text-muted">Comienza creando tu primer permiso del sistema.</p>
                <a href="{{ path('permission_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Crear Primer Permiso
                </a>
            </div>
        </div>
    {% endif %}
</div>

<form id="delete-form" method="post" style="display: none;">
    <input type="hidden" name="_token" id="csrf-token">
    <input type="hidden" name="_method" value="DELETE">
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function deletePermission(permissionId) {
            if (confirm('¿Estás seguro de que quieres eliminar este permiso? Esta acción no se puede deshacer.')) {
                const form = document.getElementById('delete-form');
                form.action = '{{ path('permission_delete', {'id': '__ID__'}) }}'.replace('__ID__', permissionId);
                
                fetch(form.action, {
                    method: 'DELETE',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new FormData(form)
                })
                .then(() => {
                    window.location.reload();
                })
                .catch(error => {
                    alert('Error al eliminar el permiso');
                    console.error(error);
                });
            }
        }
    </script>
{% endblock %}
