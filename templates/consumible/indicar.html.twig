{% extends 'base.html.twig' %}

{% block title %}Consumibles Imputar{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/indicaciones-simple.css') }}">
{% endblock %}

{% block panelTitle %}
    <div id="head">
        <h3>Cargar Indicaciones</h3>
        Paciente: <strong class="text-capitalize">{{ cliente.nombre }} {{ cliente.apellido }}</strong>
    </div>
{% endblock %}

{% block titleButtons %}
    <div class="d-flex">
        <a href="javascript:history.back()" class="btn btn-danger mr-2">Volver</a>
        <!--<a href="{{ path('consumible_new') }}" class="btn btn-success mr-2">Nuevo Consumible</a>
        <a href="{{ path('cliente_index') }}" class="btn btn-info mr-2">Pacientes</a>
        <a href="{{ path('consumible_imputar_view', {'id': cliente.id}) }}" class="btn btn-info">Imputar</a>-->
    </div>
{% endblock %}
{% block body %}
    {% set rowCount = 0 %}

    <div class="indicaciones-container">
        <!-- Pestañas de navegación simplificadas -->
        <div class="indicaciones-tabs">
            <button class="tab-btn active" id="mostrarActivas">Activas</button>
            <button class="tab-btn" id="mostrarProximas">Próximas a vencer</button>
            <button class="tab-btn" id="mostrarHistoricas">Históricas</button>
            {% if is_granted('patient.indication') %}
            <button class="btn btn-sm btn-primary ml-auto" id="agregarItem">
                <i class="fas fa-plus"></i> Nueva
            </button>
            {% endif %}
        </div>
        
        <!-- Área para indicaciones existentes -->
        <div id="indicacionesLista">
            <!-- Contenedor para indicaciones activas -->
            <div class="indicacionesActivas">
                <div class="listado-indicaciones mb-3">
                    <h5>Indicaciones Activas</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Medicamento/Procedimiento</th>
                                    <th>Dosis</th>
                                    <th>Frecuencia</th>
                                    <th>Inicio</th>
                                    <th>Duración</th>
                                    <th>Notas</th>
                                    <th>Estado</th>
                                    <th width="120px">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if indicacionesActivas is defined and indicacionesActivas|length > 0 %}
                                    {% for indicacion in indicacionesActivas %}
                                        <tr>
                                            <td>{{ indicacion.tipoIndicacion|default('N/D') }}</td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' and indicacion.consumibleId and consumiblesArray[indicacion.consumibleId] is defined %}
                                                    {{ consumiblesArray[indicacion.consumibleId] }}
                                                {% elseif indicacion.procedimientoPersonalizado %}
                                                    {{ indicacion.procedimientoPersonalizado }}
                                                {% else %}
                                                    N/D
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' %}
                                                    {{ indicacion.cantidad }} {{ indicacion.unidadMedida }}
                                                {% else %}
                                                    --
                                                {% endif %}
                                            </td>
                                            <td>{{ indicacion.frecuencia|default('N/D') }}</td>
                                            <td>{{ indicacion.fechaInicio ? indicacion.fechaInicio|date('d/m/Y') : 'N/D' }}</td>
                                            <td>{% if indicacion.duracion %}{{ indicacion.duracion }} días{% elseif indicacion.fechaFin %}Hasta {{ indicacion.fechaFin|date('d/m/Y') }}{% else %}N/D{% endif %}</td>
                                            <td>{{ indicacion.notas }}</td>
                                            <td>
                                                {% if indicacion.estadoSuspendido is defined and indicacion.estadoSuspendido %}
                                                    <span class="badge badge-warning">Suspendida</span>
                                                {% else %}
                                                    <span class="badge badge-success">Activa</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if is_granted('patient.indication') %}
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-primary btn-sm" 
                                                            onclick="editarIndicacion({{ indicacion.id }})" 
                                                            title="Editar indicación">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    {% if indicacion.estadoSuspendido is defined and indicacion.estadoSuspendido %}
                                                        <button type="button" class="btn btn-outline-success btn-sm" 
                                                                onclick="reanudarIndicacion({{ indicacion.id }})" 
                                                                title="Reanudar indicación">
                                                            <i class="fas fa-play"></i>
                                                        </button>
                                                    {% else %}
                                                        <button type="button" class="btn btn-outline-warning btn-sm" 
                                                                onclick="suspenderIndicacion({{ indicacion.id }})" 
                                                                title="Suspender indicación">
                                                            <i class="fas fa-pause"></i>
                                                        </button>
                                                    {% endif %}
                                                    <button type="button" class="btn btn-outline-danger btn-sm" 
                                                            onclick="cancelarIndicacion({{ indicacion.id }})" 
                                                            title="Cancelar indicación">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                                {% else %}
                                                    <span class="text-muted">Solo lectura</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center">No hay indicaciones activas</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Contenedor para indicaciones próximas a vencer -->
            <div class="indicacionesProximasVencer" style="display: none;">
                <div class="listado-indicaciones mb-3">
                    <h5>Indicaciones Próximas a Vencer</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Medicamento/Procedimiento</th>
                                    <th>Dosis</th>
                                    <th>Frecuencia</th>
                                    <th>Inicio</th>
                                    <th>Duración</th>
                                    <th>Notas</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if indicacionesProximasVencer is defined and indicacionesProximasVencer|length > 0 %}
                                    {% for indicacion in indicacionesProximasVencer %}
                                        <tr>
                                            <td>{{ indicacion.tipoIndicacion|default('N/D') }}</td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' and indicacion.consumibleId and consumiblesArray[indicacion.consumibleId] is defined %}
                                                    {{ consumiblesArray[indicacion.consumibleId] }}
                                                {% elseif indicacion.procedimientoPersonalizado %}
                                                    {{ indicacion.procedimientoPersonalizado }}
                                                {% else %}
                                                    N/D
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' %}
                                                    {{ indicacion.cantidad }} {{ indicacion.unidadMedida }}
                                                {% else %}
                                                    --
                                                {% endif %}
                                            </td>
                                            <td>{{ indicacion.frecuencia|default('N/D') }}</td>
                                            <td>{{ indicacion.fechaInicio ? indicacion.fechaInicio|date('d/m/Y') : 'N/D' }}</td>
                                            <td>{% if indicacion.duracion %}{{ indicacion.duracion }} días{% elseif indicacion.fechaFin %}Hasta {{ indicacion.fechaFin|date('d/m/Y') }}{% else %}N/D{% endif %}</td>
                                            <td>{{ indicacion.notas }}</td>
                                            <td>
                                                <span class="badge badge-warning">Próxima a vencer</span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center">No hay indicaciones próximas a vencer</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Contenedor para indicaciones históricas -->
            <div class="indicacionesHistoricas" style="display: none;">
                <div class="listado-indicaciones mb-3">
                    <h5>Indicaciones Históricas</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Medicamento/Procedimiento</th>
                                    <th>Dosis</th>
                                    <th>Frecuencia</th>
                                    <th>Inicio</th>
                                    <th>Duración</th>
                                    <th>Notas</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if indicacionesHistoricas is defined and indicacionesHistoricas|length > 0 %}
                                    {% for indicacion in indicacionesHistoricas %}
                                        <tr>
                                            <td>{{ indicacion.tipoIndicacion|default('N/D') }}</td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' and indicacion.consumibleId and consumiblesArray[indicacion.consumibleId] is defined %}
                                                    {{ consumiblesArray[indicacion.consumibleId] }}
                                                {% elseif indicacion.procedimientoPersonalizado %}
                                                    {{ indicacion.procedimientoPersonalizado }}
                                                {% else %}
                                                    N/D
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if indicacion.tipoIndicacion == 'medicamento' %}
                                                    {{ indicacion.cantidad }} {{ indicacion.unidadMedida }}
                                                {% else %}
                                                    --
                                                {% endif %}
                                            </td>
                                            <td>{{ indicacion.frecuencia|default('N/D') }}</td>
                                            <td>{{ indicacion.fechaInicio ? indicacion.fechaInicio|date('d/m/Y') : 'N/D' }}</td>
                                            <td>{% if indicacion.duracion %}{{ indicacion.duracion }} días{% elseif indicacion.fechaFin %}Hasta {{ indicacion.fechaFin|date('d/m/Y') }}{% else %}N/D{% endif %}</td>
                                            <td>{{ indicacion.notas }}</td>
                                            <td>
                                                <span class="badge badge-secondary">Inactiva</span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center">No hay indicaciones históricas</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Formulario para nueva indicación (simplificado y organizado) -->
    {% if is_granted('patient.indication') %}
    <div class="indicacion-form" id="nuevaIndicacionForm" style="display: none;">
        <h5>Nueva Indicación Médica</h5>
        
        <!-- Primera fila: Tipo, Opción, Cantidad, Unidades y Frecuencia -->
        <div class="row mb-3 align-items-end">
            <!-- Tipo de indicación -->
            <div class="col-md-2">
                <label for="tipoIndicacion-nuevo">Tipo</label>
                <select class="form-control" id="tipoIndicacion-nuevo" onchange="mostrarCamposRelevantes('nuevo')">
                    <option value="">-- Seleccione tipo --</option>
                    <option value="medicamento">Medicamento</option>
                    <option value="procedimiento">Procedimiento</option>
                    <option value="control">Control</option>
                </select>
            </div>
            
            <!-- Opción (medicamento o procedimiento) -->
            <div class="col-md-4">
                <label for="consumible-nuevo">Opción</label>
                <select class="form-control" id="consumible-nuevo">
                    <option value="">-- Seleccione una opción --</option>
                    {% for consumible in consumibles %}
                        <option value="{{ consumible.id }}" data-unidades="{{ consumible.unidades }}">{{ consumible.nombre }}</option>
                    {% endfor %}
                </select>
                <input type="text" class="form-control mt-2" id="procedimientoPersonalizado-nuevo" 
                       placeholder="Descripción personalizada" style="display: none;">
            </div>
            
            <!-- Cantidad -->
            <div class="col-md-2">
                <label for="cantidad-nuevo">Cantidad</label>
                <input type="number" class="form-control" id="cantidad-nuevo" value="1" min="0.1" step="0.1">
            </div>
            
            <!-- Unidades -->
            <div class="col-md-2">
                <label for="unidadMedida-nuevo">Unidades</label>
                <select class="form-control" id="unidadMedida-nuevo">
                    <option value="unidades">Unidades</option>
                    <option value="gramos">Gramos</option>
                    <option value="miligramos">Miligramos</option>
                    <option value="microgramos">Microgramos</option>
                    <option value="mililitros">Mililitros</option>
                    <option value="centimetros_cubicos">cc</option>
                    <option value="gotas">Gotas</option>
                    <option value="unidades_internacionales">UI</option>
                    <option value="ampollas">Ampollas</option>
                    <option value="tabletas">Tabletas</option>
                    <option value="capsulas">Cápsulas</option>
                    <option value="comprimidos">Comprimidos</option>
                </select>
            </div>
            
            <!-- Frecuencia -->
            <div class="col-md-2">
                <label for="frecuencia-nuevo">Frecuencia</label>
                <select class="form-control" id="frecuencia-nuevo" onchange="mostrarCampoOtraFrecuencia('nuevo')">
                    <option value="">-- Seleccione --</option>
                    <option value="cada4h">Cada 4h</option>
                    <option value="cada6h">Cada 6h</option>
                    <option value="cada8h">Cada 8h</option>
                    <option value="cada12h">Cada 12h</option>
                    <option value="cada24h">Cada 24h</option>
                    <option value="diario">Diario</option>
                    <option value="bid">BID (2 veces/día)</option>
                    <option value="tid">TID (3 veces/día)</option>
                    <option value="sos">SOS (Si es necesario)</option>
                    <option value="semanal">Semanal</option>
                    <option value="otra">Otra</option>
                </select>
                <input type="text" class="form-control mt-2" id="otraFrecuencia-nuevo" 
                       placeholder="Especifique frecuencia" style="display: none;">
            </div>
        </div>
        
        <!-- Segunda fila: Fecha inicio, Hora y Duración -->
        <div class="row mb-3 align-items-end">
            <!-- Fecha de inicio -->
            <div class="col-md-2">
                <label for="fechaInicio-nuevo">Fecha de inicio</label>
                <input type="date" class="form-control" id="fechaInicio-nuevo" value="{{ "now"|date("Y-m-d") }}">
            </div>
            
            <!-- Horario -->
            <div class="col-md-2">
                <label for="horario-nuevo">Horario</label>
                <input type="time" class="form-control" id="horario-nuevo" placeholder="Ej: 08:00">
                <small class="form-text text-muted">Definido por médico o primera toma</small>
            </div>
            
            <!-- Duración -->
            <div class="col-md-2">
                <label for="duracion-nuevo">Duración</label>
                <select class="form-control" id="duracion-nuevo" onchange="mostrarCamposDuracion('nuevo')">
                    <option value="indefinida">Indefinida</option>
                    <option value="especifica">Específica</option>
                    <option value="fechaFin">Hasta fecha específica</option>
                </select>
            </div>
            
            <!-- Campo para duración específica -->
            <div class="col-md-2" id="duracionValorContainer-nuevo" style="display: none;">
                <label for="duracionValor-nuevo">Días</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="duracionValor-nuevo" min="1" value="7">
                    <div class="input-group-append">
                        <span class="input-group-text">días</span>
                    </div>
                </div>
            </div>
            
            <!-- Campo para fecha fin específica -->
            <div class="col-md-2" id="fechaFinContainer-nuevo" style="display: none;">
                <label for="fechaFin-nuevo">Fecha fin</label>
                <input type="date" class="form-control" id="fechaFin-nuevo">
            </div>
        </div>
        
        <!-- Tercera fila: Notas -->
        <div class="row mb-3">
            <div class="col-12">
                <label for="notas-nuevo">Notas adicionales</label>
                <textarea class="form-control" id="notas-nuevo" rows="3" placeholder="Instrucciones especiales o notas adicionales"></textarea>
            </div>
        </div>
        
        <!-- Checkbox para indicación activa -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="activo-nuevo" checked>
                    <label class="custom-control-label" for="activo-nuevo">Indicación activa</label>
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div class="form-actions mt-4 text-right">
            <button type="button" class="btn btn-secondary mr-2" id="cancelarNuevaIndicacion">Cancelar</button>
            <button type="button" class="btn btn-primary" id="agregarNuevaIndicacion">Guardar Indicación</button>
        </div>
    </div>
    {% endif %}
    
    <!-- Input oculto para ID cliente -->
    <input type="hidden" id="clienteId" value="{{ cliente.id }}">
    <input type="hidden" id="historiaPacienteId" value="{{ historiaPacienteId is defined ? historiaPacienteId : '' }}">

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Variables globales
            const clienteId = $("#clienteId").val();
            const historiaPacienteId = $("#historiaPacienteId").val();
            
            // Mostrar el formulario de nueva indicación al hacer clic en el botón
            $("#agregarItem, #agregarItemMobile").on("click", function() {
                $("#nuevaIndicacionForm").slideDown();
                
                // Desplazarse hasta el formulario
                $('html, body').animate({
                    scrollTop: $("#nuevaIndicacionForm").offset().top - 100
                }, 500);
            });
            
            // Ocultar el formulario al cancelar
            $("#cancelarNuevaIndicacion").on("click", function() {
                $("#nuevaIndicacionForm").slideUp();
                limpiarFormulario();
            });
            
            // Mostrar el campo personalizado para la frecuencia si se selecciona "Otra"
            function mostrarCampoOtraFrecuencia(idSufijo) {
                const frecuenciaVal = $(`#frecuencia-${idSufijo}`).val();
                if (frecuenciaVal === "otra") {
                    $(`#otraFrecuencia-${idSufijo}`).slideDown();
                } else {
                    $(`#otraFrecuencia-${idSufijo}`).slideUp();
                }
            }
            
            // Función global para mostrar/ocultar campos de duración
            window.mostrarCamposDuracion = function(idSufijo) {
                const duracionVal = $(`#duracion-${idSufijo}`).val();
                
                if (duracionVal === "especifica") {
                    $(`#duracionValorContainer-${idSufijo}`).slideDown();
                    $(`#fechaFinContainer-${idSufijo}`).slideUp();
                } else if (duracionVal === "fechaFin") {
                    $(`#duracionValorContainer-${idSufijo}`).slideUp();
                    $(`#fechaFinContainer-${idSufijo}`).slideDown();
                } else {
                    $(`#duracionValorContainer-${idSufijo}`).slideUp();
                    $(`#fechaFinContainer-${idSufijo}`).slideUp();
                }
            };
            
            // Función global para mostrar campos relevantes según tipo de indicación
            window.mostrarCamposRelevantes = function(idSufijo) {
                const tipoVal = $(`#tipoIndicacion-${idSufijo}`).val();
                
                if (tipoVal === "medicamento") {
                    // Para medicamentos mostrar el selector de consumibles y ocultar campo personalizado
                    $(`#consumible-${idSufijo}`).slideDown();
                    $(`#procedimientoPersonalizado-${idSufijo}`).slideUp();
                    
                    // Restaurar campos de cantidad y unidades para que el usuario los complete
                    $(`#cantidad-${idSufijo}`).prop('readonly', false);
                    $(`#unidadMedida-${idSufijo}`).prop('disabled', false);
                    
                } else if (tipoVal === "procedimiento" || tipoVal === "control") {
                    // Para procedimientos o controles, mostrar campo personalizado y ocultar selector de consumibles
                    $(`#consumible-${idSufijo}`).slideUp();
                    $(`#procedimientoPersonalizado-${idSufijo}`).slideDown();
                    
                    // Establecer valores predeterminados para cantidad y unidades
                    $(`#cantidad-${idSufijo}`).val('1');
                    $(`#cantidad-${idSufijo}`).prop('readonly', true);
                    
                    // Establecer "unidades" como predeterminado para procedimientos/controles
                    $(`#unidadMedida-${idSufijo}`).val('unidades');
                    $(`#unidadMedida-${idSufijo}`).prop('disabled', true);
                    
                    // La frecuencia debe ser seleccionada por el usuario
                    
                } else {
                    // Si no se ha seleccionado ningún tipo, ocultar ambos
                    $(`#consumible-${idSufijo}`).slideUp();
                    $(`#procedimientoPersonalizado-${idSufijo}`).slideUp();
                    
                    // Restaurar campos
                    $(`#cantidad-${idSufijo}`).prop('readonly', false);
                    $(`#unidadMedida-${idSufijo}`).prop('disabled', false);
                }
            };
            
            // Limpia el formulario
            function limpiarFormulario() {
                // Resetear todos los campos del formulario
                $("#tipoIndicacion-nuevo").val("");
                $("#consumible-nuevo").val("");
                $("#procedimientoPersonalizado-nuevo").val("").hide();
                $("#cantidad-nuevo").val("1");
                $("#unidadMedida-nuevo").val("unidades");
                $("#frecuencia-nuevo").val("");
                $("#otraFrecuencia-nuevo").val("").hide();
                $("#fechaInicio-nuevo").val("{{ "now"|date("Y-m-d") }}");
                $("#horario-nuevo").val("");
                $("#duracion-nuevo").val("indefinida");
                $("#duracionValor-nuevo").val("7");
                $("#duracionValorContainer-nuevo").hide();
                $("#fechaFin-nuevo").val("");
                $("#fechaFinContainer-nuevo").hide();
                $("#notas-nuevo").val("");
                $("#activo-nuevo").prop("checked", true);
            }
            
            // Función para validar los campos obligatorios del formulario
            function validarFormulario() {
                let esValido = true;
                let mensaje = "";
                
                // Verificar tipo indicación
                if (!$("#tipoIndicacion-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe seleccionar un tipo de indicación\n";
                }
                
                // Verificar medicamento o descripción personalizada
                const tipoIndicacion = $("#tipoIndicacion-nuevo").val();
                if (tipoIndicacion === "medicamento" && !$("#consumible-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe seleccionar un medicamento\n";
                } else if ((tipoIndicacion === "procedimiento" || tipoIndicacion === "control") && 
                           !$("#procedimientoPersonalizado-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe ingresar una descripción para el procedimiento o control\n";
                }
                
                // Verificar cantidad
                if (!$("#cantidad-nuevo").val() || parseFloat($("#cantidad-nuevo").val()) <= 0) {
                    esValido = false;
                    mensaje += "- La cantidad debe ser mayor a cero\n";
                }
                
                // Verificar frecuencia
                if (!$("#frecuencia-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe seleccionar una frecuencia\n";
                } else if ($("#frecuencia-nuevo").val() === "otra" && !$("#otraFrecuencia-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe especificar la frecuencia personalizada\n";
                }
                
                // Verificar fecha inicio
                if (!$("#fechaInicio-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe ingresar una fecha de inicio\n";
                }
                
                // Verificar duración específica
                if ($("#duracion-nuevo").val() === "especifica" && 
                    (!$("#duracionValor-nuevo").val() || parseInt($("#duracionValor-nuevo").val()) <= 0)) {
                    esValido = false;
                    mensaje += "- Debe ingresar un valor válido para la duración\n";
                }
                
                // Verificar fecha fin
                if ($("#duracion-nuevo").val() === "fechaFin" && !$("#fechaFin-nuevo").val()) {
                    esValido = false;
                    mensaje += "- Debe ingresar una fecha de fin\n";
                }
                
                if (!esValido) {
                    alert("Por favor corrija los siguientes errores:\n" + mensaje);
                }
                
                return esValido;
            }
            
            // Manejar pestañas de navegación
            $("#mostrarActivas").on("click", function() {
                $(".indicacionesActivas").show();
                $(".indicacionesProximasVencer, .indicacionesHistoricas").hide();
                $(".tab-btn").removeClass("active");
                $(this).addClass("active");
            });
            
            $("#mostrarProximas").on("click", function() {
                $(".indicacionesProximasVencer").show();
                $(".indicacionesActivas, .indicacionesHistoricas").hide();
                $(".tab-btn").removeClass("active");
                $(this).addClass("active");
            });
            
            $("#mostrarHistoricas").on("click", function() {
                $(".indicacionesHistoricas").show();
                $(".indicacionesActivas, .indicacionesProximasVencer").hide();
                $(".tab-btn").removeClass("active");
                $(this).addClass("active");
            });
            
            // Guardar nueva indicación
            $("#agregarNuevaIndicacion").on("click", function() {
                if (validarFormulario()) {
                    // Preparar los datos para enviar
                    const datosIndicacion = {
                        clienteId: clienteId,
                        historiaPacienteId: historiaPacienteId,
                        tipoIndicacion: $("#tipoIndicacion-nuevo").val(),
                        consumibleId: $("#tipoIndicacion-nuevo").val() === "medicamento" ? $("#consumible-nuevo").val() : null,
                        procedimientoPersonalizado: $("#tipoIndicacion-nuevo").val() !== "medicamento" ? $("#procedimientoPersonalizado-nuevo").val() : null,
                        cantidad: $("#cantidad-nuevo").val(),
                        unidadMedida: $("#unidadMedida-nuevo").val(),
                        frecuencia: $("#frecuencia-nuevo").val() === "otra" ? $("#otraFrecuencia-nuevo").val() : $("#frecuencia-nuevo").val(),
                        fechaInicio: $("#fechaInicio-nuevo").val(),
                        duracion: $("#duracion-nuevo").val(),
                        duracionValor: $("#duracion-nuevo").val() === "especifica" ? $("#duracionValor-nuevo").val() : null,
                        fechaFin: $("#duracion-nuevo").val() === "fechaFin" ? $("#fechaFin-nuevo").val() : null,
                        notas: $("#notas-nuevo").val(),
                        horario: $("#horario-nuevo").val(),
                        activo: $("#activo-nuevo").is(":checked") ? 1 : 0
                    };
                    
                    // Mostrar indicador de carga
                    const botonGuardar = $(this);
                    const textoOriginal = botonGuardar.html();
                    botonGuardar.html('<i class="fas fa-spinner fa-spin"></i> Guardando...');
                    botonGuardar.prop('disabled', true);
                    
                    // Enviar datos por AJAX
                    $.ajax({
                        url: '{{ path("consumible_guardar_indicaciones", {"id": cliente.id}) }}',
                        type: 'POST',
                        data: datosIndicacion,
                        success: function(response) {
                            if (response.success) {
                                // Mostrar mensaje de éxito
                                alert("Indicación guardada correctamente");
                                
                                // Recargar la página para mostrar la nueva indicación
                                location.reload();
                            } else {
                                // Mostrar mensaje de error
                                alert("Error al guardar la indicación: " + response.message);
                                botonGuardar.html(textoOriginal);
                                botonGuardar.prop('disabled', false);
                            }
                        },
                        error: function() {
                            alert("Error de comunicación con el servidor");
                            botonGuardar.html(textoOriginal);
                            botonGuardar.prop('disabled', false);
                        }
                    });
                }
            });

            // Exponer las funciones necesarias al ámbito global
            window.mostrarCampoOtraFrecuencia = mostrarCampoOtraFrecuencia;
        });
        
        // Funciones para manejar indicaciones
        function editarIndicacion(indicacionId) {
            // Por ahora mostrar un modal simple, en el futuro se puede expandir con un formulario completo
            const nuevasNotas = prompt("Ingrese las nuevas notas para la indicación (o deje vacío para no cambiar):");
            if (nuevasNotas === null) return; // Usuario canceló
            
            $.ajax({
                url: '{{ path("consumible_editar_indicacion", {"id": "__ID__"}) }}'.replace('__ID__', indicacionId),
                type: 'POST',
                data: { 
                    notas: nuevasNotas 
                },
                success: function(response) {
                    if (response.success) {
                        alert("Indicación actualizada correctamente");
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function() {
                    alert("Error de comunicación con el servidor");
                }
            });
        }
        
        function suspenderIndicacion(indicacionId) {
            if (confirm("¿Está seguro de que desea suspender esta indicación?")) {
                $.ajax({
                    url: '{{ path("consumible_suspender_indicacion", {"id": "__ID__"}) }}'.replace('__ID__', indicacionId),
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            alert("Indicación suspendida correctamente");
                            location.reload();
                        } else {
                            alert("Error: " + response.message);
                        }
                    },
                    error: function() {
                        alert("Error de comunicación con el servidor");
                    }
                });
            }
        }
        
        function reanudarIndicacion(indicacionId) {
            if (confirm("¿Está seguro de que desea reanudar esta indicación?")) {
                $.ajax({
                    url: '{{ path("consumible_reanudar_indicacion", {"id": "__ID__"}) }}'.replace('__ID__', indicacionId),
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            alert("Indicación reanudada correctamente");
                            location.reload();
                        } else {
                            alert("Error: " + response.message);
                        }
                    },
                    error: function() {
                        alert("Error de comunicación con el servidor");
                    }
                });
            }
        }
        
        function cancelarIndicacion(indicacionId) {
            if (confirm("¿Está seguro de que desea CANCELAR esta indicación? Esta acción no se puede deshacer.")) {
                $.ajax({
                    url: '{{ path("consumible_cancelar_indicacion", {"id": "__ID__"}) }}'.replace('__ID__', indicacionId),
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            alert("Indicación cancelada correctamente");
                            location.reload();
                        } else {
                            alert("Error: " + response.message);
                        }
                    },
                    error: function() {
                        alert("Error de comunicación con el servidor");
                    }
                });
            }
        }
    </script>
{% endblock %}
