{% extends 'base.html.twig' %}

{% block title %}Consumibles Imputar{% endblock %}

{% block panelTitle %}
    <div id="head">
        <h3>Cargar Indicaciones</h3>
        Paciente: <strong class="text-capitalize">{{ cliente.nombre }} {{ cliente.apellido }}</strong>
    </div>
{% endblock %}

{% block titleButtons %}
    <div class="d-flex">
        <a href="javascript:history.back()" class="btn btn-danger mr-2">Volver</a>
        <a href="{{ path('consumible_new') }}" class="btn btn-success mr-2">Nuevo Consumible</a>
        <a href="{{ path('cliente_index') }}" class="btn btn-info mr-2">Pacientes</a>
        <a href="{{ path('consumible_imputar_view', {'id': cliente.id}) }}" class="btn btn-info">Imputar</a>
    </div>
{% endblock %}
{% block body %}
    {% set rowCount = 0 %}

        <table class="table table-striped" id="rowContainer">
            <thead>
                <tr>
                    <th>
                        Consumible <small>(opcional si ingresa notas)</small>
                    </th>
                    <th>
                        Cantidad Mensual
                    </th>
                    <th>
                        Mes
                    </th>
                    <th>
                        Año
                    </th>
                    <th>
                        Notas e Indicación Activa/Inactiva
                    </th>
                </tr>
                    <td>
                        <button class="btn btn-info" id="verIndMesAnt">Ver Indicaciones mes anterior</button>
                        <button class="btn btn-info" id="ocultarIndMesAnt">Ocultar Indicaciones mes anterior</button>
                    </td>
                    <td>
                        <a id="agregarItem" class="btn btn-info">+</a>
                        <a id="eliminarItem" class="btn btn-warning">-</a>
                    </td>
                </tr>
            </thead>
            <tbody id="tabla-imputar">
            {% set rowCount = 0 %}
            {% for indicacionCargada in indicacionesCargadas  %}
                {% if (indicacionCargada.accion is same as (0))  %}
                    <tr class="row-{{ rowCount }} indicacionesMesAnterior" style="line-height: 30px;" data-row="{{ rowCount }}">
                        <td>
                            <select class="form-control selectConsumible" id="consumible-{{ rowCount }}" data-row="{{ rowCount }}">
                                {% for consumible in consumibles %}
                                    <option {% if consumible.id == indicacionCargada.consumibleId %} selected {% endif %} value="{{ consumible.id }}">
                                        {{ consumible.nombre }}
                                    </option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <input class="form-control" type="number" placeholder="Cantidad" id="cantidad-{{ rowCount }}" value="{{ indicacionCargada.cantidad }}">
                        </td>
                        <td class="mes">
                            <select class="form-control mes col-sm-10" id="mes-{{ rowCount }}" data-row="{{ rowCount }}" style="display: inline;">
                            {% for nombre, num in meses %}
                                <option {% if num == indicacionCargada.mes %} selected {% endif %} value="{{ num }}">{{ nombre }}</option>
                            {% endfor %}
                            </select>
                            <a href="#" class="borrar-row col-sm-2" data-row="{{ rowCount }}">
                                <i class="fas fa-trash" title="borrar"></i>
                            </a>
                        </td>
                        <td>
                            <select class="form-control year col-sm-10" id="year-{{ rowCount }}" data-row="{{ rowCount }}" style="display: inline;">
                                <option {% if 2025 == indicacionCargada.year %} selected {% endif %} value="2025">2025</option>
                                <option {% if 2024 == indicacionCargada.year %} selected {% endif %} value="2024">2024</option>
                                <option {% if 2023 == indicacionCargada.year %} selected {% endif %} value="2023">2023</option>
                                <option {% if 2022 == indicacionCargada.year %} selected {% endif %} value="2022">2022</option>
                                <option {% if 2021 == indicacionCargada.year %} selected {% endif %} value="2021">2021</option>
                            </select>
                        </td>
                        <td>
                            <div class="form-group">
                                <textarea class="form-control mb-2" id="notas-{{ rowCount }}" placeholder="Notas o indicaciones de texto libre (ej: 'Rotar colchón')">{{ indicacionCargada.notas }}</textarea>
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="activo-{{ rowCount }}" {% if indicacionCargada.activo is not defined or indicacionCargada.activo %}checked{% endif %}>
                                    <label class="custom-control-label" for="activo-{{ rowCount }}">Indicación activa</label>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% set rowCount = rowCount + 1 %}
                {% endif %}
            {% endfor %}
                <tr class="row-{{ rowCount }} rowOriginal" id="rowOriginal" data-row="{{ rowCount }}">
                    <td>
                        <select class="form-control selectConsumible" id="consumible-{{ rowCount }}" data-row="{{ rowCount }}">
                            <option value="" >seleccione una opcion</option>
                            {% for consumible in consumibles %}
                                <option value="{{ consumible.id }}" data-unidades="{{ consumible.unidades }}">{{ consumible.nombre }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td>
                        <input class="form-control" type="number" placeholder="Cantidad" id="cantidad-{{ rowCount }}" value="1">
                    </td>
                    <td>
                        <select class="form-control mes" id="mes-{{ rowCount }}" data-row="{{ rowCount }}">
                            {% for nombre, num in meses %}
                                <option {%  if num == mes %} selected {% endif %} value="{{ num }}">{{ nombre }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td>
                        <select class="form-control year col-sm-10" id="year-{{ rowCount }}" data-row="{{ rowCount }}" style="display: inline;">
                            <option value="2025" selected>2025</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                            <option value="2021">2021</option>
                        </select>
                    </td>
                    <td>
                        <div class="form-group">
                            <textarea class="form-control mb-2" id="notas-{{ rowCount }}" placeholder="Notas o indicaciones de texto libre (ej: 'Rotar colchón')"></textarea>
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="activo-{{ rowCount }}" checked>
                                <label class="custom-control-label" for="activo-{{ rowCount }}">Indicación activa</label>
                            </div>
                        </div>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right">
                        <button class="btn btn-success" id="guardar">Guardar Indicaciones</button>
                    </td>
                </tr>
            </tfoot>
        </table>

{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/consumibles.js') }}"></script>

    <script>
        console.log("Página de indicaciones cargada correctamente");
        
        // Asegurar que el sidebar esté visible
        $(document).ready(function() {
            console.log("Document ready en indicar.html.twig");
            $("#sidebar-wrapper").css({
                'margin-left': '0',
                'display': 'block',
                'visibility': 'visible'
            });
            $("#wrapper").removeClass("toggled");
        });
        
        $('.borrar-row').click(function (e) {
            e.preventDefault();
            let row = $(this).data('row');
            console.log(row);
            $('.row-'+row).hide();
        });

        $("#guardar").on( 'click', function() {
            let rows = $('#tabla-imputar tr:visible').not('guardada');
            let todoOK = true;

            $(rows).each(function() {
                $(this).removeClass('error');
                let newRowCount = $(this).data('row');
                let cantidad = $('#cantidad-' + newRowCount).val() || 1;
                let mes = $('#mes-' + newRowCount).val();
                let year = $('#year-' + newRowCount).val();
                let consumible = $('#consumible-' + newRowCount).val();
                let notas = $('#notas-' + newRowCount).val();
                let activo = $('#activo-' + newRowCount).is(':checked');
                
                // Validación: o bien hay un consumible seleccionado, o hay notas
                if ((consumible !== '' && consumible !== 'seleccione una opcion') || (notas && notas.trim() !== '')) {
                    $.ajax({
                        url: '{{ path('consumible_imputar') }}',
                        data: {
                            'cliente': {{ cliente.id }},
                            'consumibleId': consumible !== 'seleccione una opcion' ? consumible : null,
                            'cantidad': cantidad,
                            'mes': mes,
                            'year': year,
                            'accion': 0,
                            'isAjax': true,
                            'notas': notas,
                            'activo': activo
                        },
                        success: function (response) {
                            if (response.error) {
                                alert('error: ' + response.message);
                            } else {
                                $(this).addClass('guardada');
                            }
                        }
                    });
                } else if (!$(this).hasClass('rowOriginal')) {
                    todoOK = false;
                    $(this).addClass('error');
                    alert("Debe seleccionar un medicamento o ingresar una indicación textual en el campo de notas");
                }
            });
            
            if (todoOK) {
                // Redirigir a la historia clínica en lugar del histórico de consumibles
                window.location.href = "{{ path('cliente_historial', {'id': cliente.id}) }}";
            }
        });
        
        // Ocultar las indicaciones del mes anterior al cargar la página
        $(document).ready(function() {
            $('.indicacionesMesAnterior').hide();
            $('#ocultarIndMesAnt').hide();
        });
        
        // Mostrar/ocultar las indicaciones del mes anterior
        $('#verIndMesAnt').click(function() {
            $('.indicacionesMesAnterior').show();
            $('#verIndMesAnt').hide();
            $('#ocultarIndMesAnt').show();
        });
        
        $('#ocultarIndMesAnt').click(function() {
            $('.indicacionesMesAnterior').hide();
            $('#verIndMesAnt').show();
            $('#ocultarIndMesAnt').hide();
        });
    </script>

{% endblock %}