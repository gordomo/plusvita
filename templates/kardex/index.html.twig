{% extends 'base.html.twig' %}

{% block title %}Kardex de Indicaciones - {{ cliente.nombre }} {{ cliente.apellido }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/kardex.css') }}">
    <style>
        .inactive-indication {
            opacity: 0.7;
            border-left: 3px solid #dc3545;
        }
        .kardex-badge-text {
            background-color: #17a2b8;
        }
    </style>
{% endblock %}

{% block panelTitle %}
    <div id="head">
        <h3>Kardex de Indicaciones</h3>
        Paciente: <strong class="text-capitalize">{{ cliente.nombre }} {{ cliente.apellido }}</strong><br>
        DNI: <strong>{{ cliente.dni }}</strong> - Fecha de nacimiento: <strong>{{ cliente.fNacimiento | date('d/m/Y') }}</strong><br>
        Prof. Responsable:
        <strong>
            {% for doc in cliente.docReferente %}
                {{ doc.nombre }} {{ doc.apellido }}
            {% endfor %}
        </strong>
    </div>
{% endblock %}

{% block body %}
    <div class="kardex-container">
        <div class="kardex-header">
            <h4>
                <i class="fas fa-clipboard-list"></i> 
                Indicaciones Médicas
                <span class="kardex-badge">
                    <span id="kardex-counter"></span>/<span id="kardex-total-counter"></span>
                </span>
            </h4>
            <div class="kardex-actions">
                <a href="{{ path('cliente_historial', {'id': cliente.id}) }}" class="btn btn-sm btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Historia Clínica
                </a>
                {% if is_granted('patient.indication') %}
                    <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus"></i> Nueva Indicación
                    </a>
                {% endif %}
            </div>
        </div>
        
        <div class="kardex-filter-bar">
            <select id="kardex-filter-year" class="form-control form-control-sm">
                <option value="all">Todos los años</option>
                {% for year in years %}
                    <option value="{{ year }}" {% if year == currentYear %}selected{% endif %}>{{ year }}</option>
                {% endfor %}
            </select>
            
            <select id="kardex-filter-month" class="form-control form-control-sm">
                <option value="all">Todos los meses</option>
                {% for monthNum, monthName in mesesNombres %}
                    <option value="{{ monthNum }}" {% if monthNum == currentMonth %}selected{% endif %}>{{ monthName }}</option>
                {% endfor %}
            </select>
            
            {% if categories|length > 0 %}
                <select id="kardex-filter-category" class="form-control form-control-sm">
                    <option value="all">Todas las categorías</option>
                    {% for category in categories %}
                        <option value="{{ category }}">{{ category }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            
            <button id="kardex-clear-filters" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-times"></i> Limpiar filtros
            </button>
        </div>
        
        <div class="kardex-body">
            <!-- Indicaciones al ingreso -->
            {% if historiaIngreso and historiaIngreso.indicaciones %}
                <div class="kardex-category-toggle">
                    <i class="fas fa-chevron-down"></i> Indicaciones al Ingreso
                </div>
                <div class="kardex-category-content" style="display: block;">
                    <div class="kardex-item" data-category="ingreso" data-year="{{ cliente.fingreso ? cliente.fingreso|date('Y') : '' }}" data-month="{{ cliente.fingreso ? cliente.fingreso|date('m') : '' }}">
                        <div class="kardex-item-header">
                            <span>Ingreso del paciente</span>
                            <span class="kardex-item-date">{{ cliente.fingreso ? cliente.fingreso|date('d/m/Y') : 'Fecha no registrada' }}</span>
                        </div>
                        <div class="kardex-item-content">
                            {{ historiaIngreso.indicaciones|nl2br }}
                        </div>
                        <div class="kardex-item-footer">
                            <span>
                                <i class="fas fa-user-md"></i> Profesional al ingreso
                            </span>
                            <div>
                                <span class="kardex-badge kardex-badge-new">Ingreso</span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
            
            <!-- Indicaciones registradas -->
            {% if indicaciones|length > 0 %}
                {% set currentMonth = '' %}
                {% set currentYear = '' %}
                {% set openDiv = false %}
                
                {% for indicacion in indicaciones %}
                    {% if currentMonth != indicacion.mes or currentYear != indicacion.year %}
                        {% if openDiv %}
                            </div>
                        {% endif %}
                        
                        {% set currentMonth = indicacion.mes %}
                        {% set currentYear = indicacion.year %}
                        {% set openDiv = true %}
                        
                        <div class="kardex-category-toggle">
                            <i class="fas fa-chevron-down"></i> 
                            {{ mesesNombres[currentMonth] }} {{ currentYear }}
                        </div>
                        <div class="kardex-category-content" style="display: block;">
                    {% endif %}
                    
                    <div class="kardex-item {% if indicacion.activo is defined and not indicacion.activo %}inactive-indication{% endif %}" data-category="{{ indicacion.tipo|default('general') }}" data-year="{{ indicacion.year }}" data-month="{{ indicacion.mes }}">
                        <div class="kardex-item-header">
                            <span>
                                {% if indicacion.consumibleNombre is defined and indicacion.consumibleNombre %}
                                    {{ indicacion.consumibleNombre }}
                                {% else %}
                                    Indicación sin medicamento
                                {% endif %}
                            </span>
                            <span class="kardex-item-date">{{ indicacion.fecha|date('d/m/Y') }}</span>
                        </div>
                        <div class="kardex-item-content">
                            {% if indicacion.notas %}
                                {{ indicacion.notas|nl2br }}
                            {% endif %}
                            {% if indicacion.consumibleId %}
                                <div {% if indicacion.notas %}class="mt-2"{% endif %}>
                                    <strong>Cantidad:</strong> {{ indicacion.cantidad }} 
                                    {% if indicacion.unidadMedida is defined and indicacion.unidadMedida %}<small>({{ indicacion.unidadMedida }})</small>
                                    {% elseif indicacion.unidades is defined %}<small>({{ indicacion.unidades }})</small>{% endif %}
                                </div>
                            {% endif %}
                            {% if indicacion.activo is defined and not indicacion.activo %}
                                <div class="mt-2 text-danger">
                                    <strong><i class="fas fa-times-circle"></i> Indicación inactiva</strong>
                                </div>
                            {% endif %}
                        </div>
                        <div class="kardex-item-footer">
                            <span>
                                <i class="fas fa-user"></i> 
                                {% if indicacion.doctorNombre is defined and indicacion.doctorNombre and indicacion.doctorApellido is defined and indicacion.doctorApellido %}
                                    {{ indicacion.doctorNombre }} {{ indicacion.doctorApellido }}
                                {% else %}
                                    Usuario del sistema
                                {% endif %}
                            </span>
                            <div>
                                <span class="kardex-badge kardex-badge-month">{{ mesesNombres[indicacion.mes] }}</span>
                                <span class="kardex-badge kardex-badge-year">{{ indicacion.year }}</span>
                                {% if indicacion.notas is defined and indicacion.notas and (indicacion.consumibleNombre is not defined or not indicacion.consumibleNombre) %}
                                    <span class="kardex-badge kardex-badge-text">Texto libre</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
                
                {% if openDiv %}
                    </div>
                {% endif %}
            {% else %}
                <div class="kardex-empty">
                    No se encontraron indicaciones con los filtros seleccionados
                    {% if is_granted('patient.indication') %}
                        <div class="mt-3">
                            <a href="{{ path('consumible_indicar_view', {'id': cliente.id}) }}" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Agregar nueva indicación
                            </a>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/kardex.js') }}"></script>
    <script>
        // Script adicional para forzar la visualización correcta
        $(window).on('load', function() {
            // Ejecutar después de que todo esté cargado
            setTimeout(function() {
                console.log("Forzando visualización de todos los elementos...");
                $('.kardex-category-content').attr('style', 'display: block !important');
                $('.kardex-item').attr('style', 'display: block !important');
                $('.kardex-empty').hide();
                
                // Actualizar contadores
                const totalItems = $('.kardex-item').length;
                $('#kardex-counter').text(totalItems);
                $('#kardex-total-counter').text(totalItems);
            }, 500);
        });
    </script>
{% endblock %}
